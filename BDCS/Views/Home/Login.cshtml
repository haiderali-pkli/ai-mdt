@{
    ViewBag.Title = "Login";
}

<style type="text/css">
    header {
        display: none;
    }

    #MainContent {
        padding-top: 0 !important;
    }

    .am-login-shell {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(160deg, #0f2a4a 0%, #153a63 45%, #1f5fa8 100%);
        padding: 40px 15px;
        margin: 0 -15px;
    }

    .am-login-card {
        width: 100%;
        max-width: 400px;
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.28);
        padding: 38px 34px;
    }

    .am-login-brand {
        text-align: center;
        margin-bottom: 26px;
    }

    .am-login-brand img {
        height: 60px;
        width: 60px;
    }

    .am-login-brand h1 {
        font-size: 21px;
        font-weight: 700;
        margin: 14px 0 3px;
        color: var(--am-ink);
    }

    .am-login-brand p {
        font-size: 13px;
        color: var(--am-muted);
        margin: 0;
        line-height: 1.4;
    }

    .am-login-card .form-group {
        margin-bottom: 18px;
    }

    .am-login-card label {
        font-weight: 600;
        font-size: 13px;
        color: var(--am-ink);
    }

    .am-login-field {
        position: relative;
    }

    .am-login-field i.am-login-field-icon {
        position: absolute;
        left: 13px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--am-muted);
        font-size: 14px;
    }

    .am-login-field input,
    .am-login-field select {
        padding-left: 36px !important;
    }

    .am-login-field i.am-login-toggle {
        position: absolute;
        right: 13px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--am-muted);
        cursor: pointer;
    }

    .am-login-submit {
        width: 100%;
        padding: 10px 0;
        font-size: 15px;
        margin-top: 6px;
    }

    .am-login-footer {
        text-align: center;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.75);
        margin-top: 22px;
    }
</style>

<div class="admin-module">
    <div class="am-login-shell">
        <div>
            <div class="am-login-card">
                <form id="LoginForm" action="@Url.Action("ValidateLogin","Patient")" method="post" onsubmit="return ValidateLogin();">
                    <div class="am-login-brand">
                        <img src="~/Content/theme/images/pkli-favicon.png" alt="PKLI" />
                        <h1>MDT Portal</h1>
                        <p>Pakistan Kidney and Liver Institute<br />and Research Center</p>
                    </div>

                    <div class="form-group">
                        <label>Username</label>
                        <div class="am-login-field">
                            <i class="fa fa-user am-login-field-icon"></i>
                            @Html.TextBox("UserId", null, new { @class = "form-control", id = "UserId", placeholder = "Enter your username", autocomplete = "username", @required = "required" })
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Password</label>
                        <div class="am-login-field">
                            <i class="fa fa-lock am-login-field-icon"></i>
                            @Html.Password("Password", null, new { @class = "form-control", id = "Password", placeholder = "Enter your password", autocomplete = "current-password", @required = "required" })
                            <i class="fa fa-eye am-login-toggle" id="LoginPasswordToggle" onclick="ToggleLoginPassword();"></i>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-am-primary am-login-submit">
                        <i class="fa fa-sign-in"></i> Login
                    </button>
                </form>

                <form id="ClinicForm" action="@Url.Action("SaveClinicInSession","Patient")" method="post" onsubmit="return SaveClinicInSession();" style="display:none;">
                    <div class="am-login-brand">
                        <img src="~/Content/theme/images/pkli-favicon.png" alt="PKLI" />
                        <h1>Select Working Unit</h1>
                        <p>Choose the MDT type you'll be working in for this session.</p>
                    </div>

                    <div class="form-group">
                        <label>MDT Type</label>
                        <div class="am-login-field">
                            <i class="fa fa-stethoscope am-login-field-icon"></i>
                            <select id="ClinicList" class="form-control"></select>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-am-primary am-login-submit">
                        <i class="fa fa-arrow-right"></i> Continue
                    </button>
                </form>
            </div>

            <p class="am-login-footer">&copy; 2018 - @System.DateTime.Now.Year PKLI Hospital. All rights reserved.</p>
        </div>
    </div>
</div>

<script type="text/javascript">

    function ToggleLoginPassword() {
        var field = document.getElementById("Password");
        var icon = document.getElementById("LoginPasswordToggle");
        if (field.type === "password") {
            field.type = "text";
            icon.className = "fa fa-eye-slash am-login-toggle";
        } else {
            field.type = "password";
            icon.className = "fa fa-eye am-login-toggle";
        }
    }

    function ValidateLogin() {
        showProgressBar();
        var UserId = $("#UserId").val();
        var Password = $("#Password").val();

        $.ajax({
            url: $("#LoginForm").attr("action"),
            type: "post",
            data: { loginId: UserId, password: Password },
            dataType: "json",
            success: function (res) {

                if (res !== null && res.Message !== undefined) {
                    if (res.Code == 200) {
                        $("#LoginForm").hide();
                        $("#ClinicForm").show();
                        GetClinicList(res.ResponseObject);
                    }

                    ShowAlertMessage(res.Message, res.MessageClass, res.MessageTitle);
                }
            },
            error: function()
                {
                ShowAlertMessage("An error occured", "error", "Error");
                }
        });

        return false;

    }

    function GetClinicList(id) {
        hideProgressBar();
        $("#ClinicList").empty();

        $.ajax({
            url: '@Url.Action("GetUserClinics","Patient")',

            type: "post",
            data: { userId: id },
            dataType: "json",
            success: function (res) {


                if (res !== null ) {

                    $(res).each(function () {
                        var option = $("<option>").val(this.Id).html(this.Value);

                        $("#ClinicList").append(option);
                    });

                }
            },
            error: function () {
                ShowAlertMessage("An error occured", "error", "Error");
            }


        });
    }

    function SaveClinicInSession() {


        $.ajax({
            url: $("#ClinicForm").attr("action"),
            type: "post",
            data: { clinicId: $("#ClinicList").val()},
            dataType: "json",
            success: function (res) {

                if (res !== null && res.Message !== undefined) {


                    ShowAlertMessage(res.Message, res.MessageClass, res.MessageTitle);
                    if (res.RedirectUrl !== null && res.RedirectUrl.length > 0) {
                        if (res.DoFullRedirect == true) {
                            window.location.href = res.RedirectUrl;
                        }
                        else {
                            //its method to call ajax for partial view
                            setTimeout(loadPage, 1000, res.RedirectUrl, "Module");
                        }
                    }
                    else {
                        ShowAlertMessage("no proper response received", "error")
                    }
                }
            },
            error: function () {
                ShowAlertMessage("An error occured", "error", "Error");
            }


        });

        return false;
    }

    function showProgressBar() {
        $("#preloader").show();
        $("#preloader .preloader").show();

    }

    function hideProgressBar() {
        $("#preloader").hide();
    }
</script>
