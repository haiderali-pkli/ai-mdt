@model List<BDCS.Model.Misc.KeyAndValuePair>
@{
    ViewBag.Title = "AddEditLookupData";
    if (Request.IsAjaxRequest())
    {
        Layout = null;
    }
}

<div class="admin-module">
    <div class="container-fluid">

        @Html.Partial("_AdminNav", "Lookups")

        <div class="am-page-head">
            <div>
                <h3><i class="fa fa-list"></i> Lookup Values</h3>
                <span class="am-subtitle">Dropdown options used across the system &mdash; e.g. Gender, Diagnosis, Blood Group</span>
            </div>
        </div>

        <div class="am-card">
            <div class="am-section-title">Add a value</div>
            <form id="LookupForm" action="@Url.Action("InsertLookupData","Patient")" method="post" onsubmit="return SaveLookupValue();">
                <div class="row">
                    <div class="col-sm-4 col-xs-12">
                        <div class="form-group">
                            <label>Lookup Value</label>
                            <input type="text" name="LookupValue" class="form-control" placeholder="e.g. Male" required="required" />
                        </div>
                    </div>
                    <div class="col-sm-4 col-xs-12">
                        <div class="form-group">
                            <label>Return Value</label>
                            <input type="text" name="ReturnValue" class="form-control" placeholder="Code stored internally (optional)" />
                        </div>
                    </div>
                    <div class="col-sm-4 col-xs-12">
                        <div class="form-group">
                            <label>Category</label>
                            <input type="text" name="Category" class="form-control" placeholder="e.g. GenderType" list="LookupType" required="required" />
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn btn-am-primary"><i class="fa fa-plus"></i> Add value</button>
            </form>
        </div>

        <div class="am-card">
            <div class="am-toolbar" style="margin-bottom:16px;">
                <div class="am-search">
                    <i class="fa fa-search"></i>
                    <input type="text" id="lookupFilter" class="form-control" placeholder="Filter by value or category..." onkeyup="FilterLookupTable();" />
                </div>
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="am-table" id="lookupTable">
                        <thead>
                            <tr>
                                <th>Value</th>
                                <th>Category</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (BDCS.Model.Misc.KeyAndValuePair kv in Model.OrderBy(a => a.Description).ThenBy(a => a.Value))
                            {
                                <tr>
                                    <td>@kv.Value</td>
                                    <td><span class="am-badge">@kv.Description</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="am-empty">
                    <i class="fa fa-list"></i>
                    No lookup values yet.
                </div>
            }
        </div>
    </div>
</div>

<datalist id="LookupType">
    @foreach (string item in Model.Select(a=> a.Description).Distinct())
    {
        <option value="@item" />
    }
</datalist>

<script type="text/javascript">

    function SaveLookupValue()
    {
        submitFormData($("#LookupForm"));

        return false;
    }

    function FilterLookupTable() {
        var filter = $("#lookupFilter").val().toLowerCase();
        $("#lookupTable tbody tr").each(function () {
            var match = $(this).text().toLowerCase().indexOf(filter) > -1;
            $(this).toggle(match);
        });
    }

</script>
