@model BDCS.Model.Patient.Patient


@{
    if (Request.IsAjaxRequest())
    {
        Layout = null;
    }
}

<script src="~/Content/Plugin/asuggest-master/jquery.a-tools-1.4.1.js"></script>
<script src="~/Content/Plugin/asuggest-master/jquery.asuggest.js"></script>

<style type="text/css"> 
.table>tbody>tr>td
