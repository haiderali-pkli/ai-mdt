<script type="text/javascript">

    $(document).ready(function () {
        $("#nav-home-tab").click();
        var visitId = $("#visitId").val();
        var patientId = $("#patientId").val();
        var reason = $("#reason").val();
        var mdttypeValue = $("#mdtTypeId").val();

        //if (mdttypeValue == "Liver") {
        //    $('#saveButtonContainer').html('<button class="btn btn-block btn-success" style="margin-top: -38px;" type="button" onclick="savePatientDetail();"><span class="glyphicon glyphicon-save"></span> Save Liver</button>');
        //} else if (mdttypeValue == "BoneMarrow") {
        //    $('#saveButtonContainer').html('<button class="btn btn-block btn-success" style="margin-top: -8px;" type="button" onclick="savePatientDetailBMT();"><span class="glyphicon glyphicon-save"></span> Save BMT Data</button>');
        //}


        /*alert($("#mdtTypeId").val());*/
        switch ($("#mdtTypeId").val()) {
            case "BoneMarrow":
                var url = '@Url.Action("VitalHistoryBMT", "Patient")' + '/?visitId=' + visitId + "&reason=" + reason + "&patId=" + patientId + "&mdtype=" + mdttypeValue;
                @*var URL = '@Url.Action("GetProtocols", "Patient")' + '/?visitId=' + visitId + "&patId=" + patientId;*@
                @*var LabUrl = '@Url.Action("GetPreviousVisitLabTestsBMT", "Patient")' + '/?patientId=' + patientId + '&visitId=' + visitId;*@
                /*loadPage(URL, "ProtocolsHistory", "ProtocolHx");*/
                loadPage(url, "VitalHistoryBMT", "VitalHx");
                /*loadPage(LabUrl, "Lab History", "LabHxBMT");*/
                break;
            case "Liver":
                var url = '@Url.Action("VitalHistory", "Patient")' + '/?visitId=' + visitId + "&reason=" + reason + "&patId=" + patientId + "&mdtype=" + mdttypeValue;
                var URL = '@Url.Action("GetProtocols", "Patient")' + '/?visitId=' + visitId + "&patId=" + patientId;
                @*var LabUrl = '@Url.Action("GetPreviousVisitLabTests", "Patient")' + '/?patientId=' + patientId + '&visitId=' + visitId;*@
                /*loadPage(URL, "ProtocolsHistory", "ProtocolHx");*/
                loadPage(url, "VitalHistory", "VitalHx");
                /*loadPage(LabUrl, "Lab History", "LabHx");*/
                break;
            case "Kidney":
                alert("Kidney MDT is under development");
                break;
            default:
                alert("Invalid MDT Type");
        }
        @*var uRl = '@Url.Action("GetPreviousLabReport", "Patient")' + '/?visitId=' + visitId + "&patId=" + patientId;
        loadPage(uRl,"PreviousLabReports")*@
    });


    function LoadPatientHeader()
    {
        var patientId = $("#patientId").val();
        var HeaderUrl = '@Url.Action("PatientHeader", "Patient")' + '/?patId=' + patientId;

        loadPage(HeaderUrl, "Patient Header", "PatientHeaderContainer");
    }

    function ShowHideGenderSpecificFields() {

        var Gender = $("#Gender").val();

        if ($.trim(Gender) === 'Male') {

            $(".MaleOnly").show();
            $(".FemaleOnly").hide();

        }
        else {

            $(".MaleOnly").hide();
            $(".FemaleOnly").show();
        }
    }

    function SavePatientAlert()
    {
        var Alert = {
            AlertTitle: $("#PatientAlert").val(),
            ActiveFrom: $("#PatientAlertStartDate").val(),
            ActiveTill: $("#PatientAlertEndDate").val(),
            PatientId: $("#patientId").val(),
        };

        $.ajax({
            url: '@Url.Action("AddPatientAlert", "Patient")',
            type: 'Post',
            dataType: 'Json',
            data: JSON.stringify(Alert),
            contentType: "application/json",
            success: function (msg) {

                ShowAlertMessage(msg.Message, msg.MessageClass);
            },
            error: function () {
                alert('an error occured');
            }
        });
    }

    function MarkAlertAsInactive(id) {
        $.ajax({
            url: '@Url.Action("MarkPatientAlertAsInactive", "Patient")',
            type: 'Post',
            dataType: 'Json',
            data: { patientAlertId: id },
            success: function (msg) {

                ShowAlertMessage(msg.Message, msg.MessageClass);
            },
            error: function () {
                alert('an error occured');
            }
        });
    }

    function AddEditPatientDemographics(patId) {
        var url = '@Url.Action("AddEditPatient","Patient")' + '/?patId=' + patId;
        //loadPage(url, "AddEditPatient");
        $("#GenericModalBody").load(url);
        $("#GenericModalTitle").html("Edit Patient Information");
        $("#GenericModal").modal('show');
    }

</script>