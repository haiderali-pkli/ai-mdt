@model List<BDCS.Model.PatientServices.PatientServices>
@{
    ViewBag.Title = "AddPatientServices";
    Layout = null;
}



<link href="~/Content/Plugin/jquery-ui-1.12.1/jquery-ui.css" rel="stylesheet" />
<script src="~/Content/Plugin/jquery-ui-1.12.1/jquery-ui.min.js"></script>


<div class="row">




    <input type="hidden" id="PatientId" value="@ViewBag.PatientId" />
    <input type="hidden" id="VisitId" value="@ViewBag.VisitId" />

    <div class="col-sm-6 col-sm-offset-3 col-xs-8 col-xs-offset-2">
    
        <!-- Patient Header-->
        <div class="row" style="background-color: #57b7fd;color:white; margin-top:50px">

            <div class="col-sm-2 col-xs-6" style="margin-bottom:10px;">
                @*here we are not mapping the image we justly displaying it therefore we dont use lamdad expression*@

                @if (!string.IsNullOrEmpty(ViewBag.Patient.ImageURL))
                {
                    <img src="@Url.Content(ViewBag.Patient.ImageURL)" class="img-responsive" style="max-width: 110px; height: 100px; border:solid; min-height:50px; min-width:50px; margin-top: 17px; margin-left: 5px;" />
                }
                else
                {
                    if (ViewBag.Patient.Gender == "Male")
                    {
                        <img src="@Url.Content("~/Content/theme/images/doctor_02.jpg")" class="img-responsive" style="max-width: 110px; height: 100px; border:solid; min-height:50px; min-width:50px;margin-top: 17px; margin-left: 5px; " />
                    }
                    else
                    {
                        <img src="@Url.Content("~/Content/theme/images/doctor_02.jpg")" class="img-responsive" style="max-width: 110px; height: 100px; border:solid; min-height:50px; min-width:50px;margin-top: 17px; margin-left: 5px;" />
                    }
                }

            </div>

            <div class="col-sm-3 col-xs-6">
                <label>MRN Number</label>
                <input type="text" class="form-control" value="@ViewBag.Patient.MrNumber" readonly />
            </div>

            <div class="col-sm-4 col-xs-6">
                <label>Patient Name</label>
                <input type="text" class="form-control" value="@ViewBag.Patient.FullName" readonly /> 
            </div>

            <div class="col-sm-3 col-xs-6">
                <label>Father/Spouse</label>
                <input type="text" class="form-control" value="@ViewBag.Patient.FatherSpouseName" readonly />
            </div>

            @*<div class="col-sm-2 col-xs-6">
                <div class="form-group">
                    <label>Date of Birth</label>
                    <input type="text" class="form-control" value="@ViewBag.Patient.DOB" readonly />

                </div>
            </div>*@

            <div class="col-sm-3 col-xs-6">
                <label>Gender</label>
                <input type="text" class="form-control" value="@ViewBag.Patient.Gender" readonly />
            </div>

            @*<div class="col-sm-2 col-xs-6">
                <label>Mobile Number</label>
                <input type="text" class="form-control" value="@ViewBag.Patient.MobileNumber" readonly />
            </div>*@

            @*<div class="col-sm-2 col-xs-6">

                    <label>Contact Number</label>
                    <input type="text" class="form-control" value="@ViewBag.Patient.ContactNumber" readonly />

   
            </div>*@

            <div class="col-sm-4 col-xs-6">
                <label>Referred By</label>
                <input type="text" class="form-control" value="@ViewBag.Patient.ReferredBy" readonly />
            </div>

            <div class="col-sm-3 col-xs-6">
                <label>Address</label>
                <input type="text" class="form-control" value="@ViewBag.Patient.Address" readonly />
            </div>

            <div class="col-sm-1 col-xs-1">
                <label>&nbsp;</label>
                <button class="btn btn-block btn-success" style="margin-top:-16px;margin-left: 419px; width:auto" onclick="savePatientServices();"><span class="glyphicon glyphicon-save "></span></button>

            </div>
            <div class="col-sm-1 col-xs-1">
                <label>&nbsp;</label>
                <button class="btn btn-block btn-info" style="margin-top:-16px;margin-left: 404px; width:auto" type="button" onclick="window.print();"><span class="glyphicon glyphicon-print"></span></button>
            </div>

            <div class="col-sm-1 col-xs-1">
                <label>&nbsp;</label>
                <button class="btn btn-block btn-danger" style="margin-top:-16px;margin-left: 388px; width:auto" onclick="loadPage('@Url.Action("GetPatientList", "Patient")')"><span class="glyphicon glyphicon-eye-close "></span></button>

            </div>

    
        </div>


        <div class="row" style="padding-top:50px;">
            <div class="col-lg-12">
                <div class="form-group">
                    <input type="text" id="SearchServices" class="form-control" placeholder="Search Services" style="margin-top:15px" />
                </div>
            </div>
        </div>


        <div class="row">
            <div class="col-lg-12">
                <table id="tblProtocols" class="table table-bordered table-responsive">
                    <thead>
                        <tr style="background-color: #57b7fd; color: white;">
                            @*<th>Protocol Id</th>*@
                            <th>Test Name</th>
                            <th>Price</th>
                            <th>Qty</th>
                            <th>Amount</th>
                            <th>Action</th>
                            @*<th><span class="glyphicon glyphicon-plus-sign" onclick="addRowProtocol();"></span></th>*@
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (BDCS.Model.PatientServices.PatientServices item in Model)
                        {

                            <tr class="DataRowService" data-chargeserviceId="@item.ChargeServiceId" data-serviceid="@item.ServiceId" data-patientid="@item.PatientId" data-visitid="@item.VisitId">
                                <td>@Html.TextBoxFor(a => item.ServiceName, new { @class = "form-control ServiceName" })</td>
                                <td>@Html.TextBoxFor(a => item.Price, new { @class = "form-control Price" })</td>
                                <td>@Html.TextBoxFor(a => item.Quantity, new { @class = "form-control Quantity" })</td>
                                <td>@Html.TextBoxFor(a => item.Amount, new { @class = "form-control Amount" })</td>
                                <td align="center"><span class="glyphicon glyphicon-remove-circle" onclick="removeRowProtocol(this);"></span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <table style="display:none">
                <tr id="SampleDataRowService" class="DataRowService" data-chargeserviceId="0" data-serviceid="0" data-patientid="0" data-visitid="0">
                    <td>@Html.TextBox("ServiceName", null, new { @class = "form-control ServiceName" })</td>
                    <td>@Html.TextBox("Price", null, new { @class = "form-control Price" })</td>
                    <td>@Html.TextBox("Quantity", null, new { @class = "form-control Quantity" })</td>
                    <td>@Html.TextBox("Amount", null, new { @class = "form-control Amount" })</td>
                    <td align="center"><span class="glyphicon glyphicon-remove-circle" onclick="removeRowProtocol(this);"></span></td>
                </tr>
            </table>


        </div>


    </div>
</div>

<script type="text/javascript">

    $(document).ready(function () {

        $("#SearchServices").autocomplete({
            //here it shows the protocol Name in the text box

            source: '@Url.Action("GetService", "Patient")' + '/?name=' + $("#SearchServices").val(),
            minLength: 2,
            select: function (event, ui) {

                GetServiceItems(ui.item.value);
            }
        });

        $(document).on("change","input.Quantity", function () {
            var row = $(this).closest(".DataRowService");
            
            $(row).find(".Amount").val( parseFloat($(row).find(".Price").val()) * $(row).find(".Quantity").val());
        });

    });

    function GetServiceItems(id) {
        //here it add the protocol detail against protocol name

        $.ajax({

            url: '@Url.Action("GetServiceDetails", "Patient")',
            type: 'post',
            dataType: 'json',
            data: { name: id },

            success: function (msg) {
                //alert(msg)
                if (msg != null && msg.length > 0) {
                    for (var i = 0; i < msg.length; i++) {
                        var row = $("#SampleDataRowService").clone();
                        $(row).removeAttr('id');
                        //$(row).find('input').val('');
                        $(row).data('serviceid',msg[i].ServiceId);
                        $(row).find('.ServiceName').val(msg[i].ServiceName);
                        $(row).find('.Price').val(msg[i].Price);
                        $(row).find('.Quantity').val(1);
                        $(row).find('.Amount').val(msg[i].Price * 1);
                       
                        $("#tblProtocols").append(row);
                    }
                }
            },
            error: function () {
                alert("an error occured.. ");
            }
        });
    }

    function removeRowProtocol(tag) {

        $(tag).closest('tr').remove();


    }   

    function savePatientServices() {
        var patientServiceDetail = new Array();
        $("#tblProtocols .DataRowService").each(function () {
  
            var Data = {
                ChargeServiceId: $(this).data("chargeserviceid"),
                ServiceId: $(this).data("serviceid"),
                PatientId: $("#PatientId").val(),
                VisitId: $("#VisitId").val(),
                Price: $(this).find(".Price").val(),
                Quantity: $(this).find(".Quantity").val(),
                Amount: $(this).find(".Amount").val(),
            };
            patientServiceDetail.push(Data);
        });

        $.ajax({

            url: '@Url.Action("savePatientServiceDetail", "Patient")',
            type: 'Post',
            dataType: 'Json',
            data: JSON.stringify(patientServiceDetail),
            contentType: 'application/Json',
            success: function (msg) {
                
                ShowAlertMessage(msg.Message, msg.MessageClass, msg.MessageTitle);
                if (msg.RedirectUrl!==null) {
                    if (msg.DoFullRedirect==true)
                    {
                        window.location = msg.RedirectUrl;
                    }
                    else {
                        ShowAlertMessage(msg.Message, msg.MessageClass, msg.MessageTitle);
                    }
                }
                //alert(msg);
            },
            error: function () {
                alert('an error occured');
            }
        });
    }
</script>

