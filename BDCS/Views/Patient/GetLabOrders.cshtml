@model List<BDCS.Model.VitalHistory.LabReports>
@{
    if (Request.IsAjaxRequest())
    {
        Layout = null;
    }

}
<div class="am-lab-list-head">
    <span class="am-lab-count">@Model.Count test@(Model.Count == 1 ? "" : "s")</span>
    <span class="am-table-add" title="Add lab test" onclick="addRowLabReports();"><i class="glyphicon glyphicon-plus"></i></span>
</div>
<div class="am-lab-list" id="tblLabReports">
    @foreach (BDCS.Model.VitalHistory.LabReports item in Model)
    {
        <div class="am-lab-row DataRowLabReports" data-recordid="@item.LabReportId">
            @Html.HiddenFor(a => item.TestId, new { @class = "TestId" })
            @Html.TextBoxFor(a => item.TestName, new { @class = "am-lab-name TestName", @list = "dlLabTestList", tabindex = "-1", placeholder = "Test name" })
            <div class="am-lab-row-fields">
                @if (".TestName" == "CEA")
                {
                    @Html.TextBoxFor(a => item.TestResult, new { @class = "form-control TestResult", placeholder = "Result" })
                }
                else
                {
                    @Html.TextBoxFor(a => item.TestResult, new { @class = "form-control TestResult", style = "border-color:red;", placeholder = "Result" })
                }
                @Html.TextBoxFor(a => item.TestUnit, new { @class = "form-control TestUnit", @list = "dlResultUnit", tabindex = "-1", placeholder = "Unit" })
                @Html.TextBoxFor(a => item.TestResultLabel, new { @class = "form-control TestResultLabel", @list = "dlResultLabel", tabindex = "-1", placeholder = "Label" })
            </div>
            @Html.TextBoxFor(a => item.TestDate, item.TestDate.HasValue ? item.TestDate.Value.ToString("dd-MMM-yyyy") : "", new { @class = "am-lab-date TestDate datepicker", tabindex = "-1" })
        </div>
    }
</div>

<div class="am-lab-row" id="SampleDataRowLabReports" data-recordid="0" style="display:none;">
    @*@Html.Hidden("TestId", null, new { @class = "TestId" })*@
    @Html.TextBox("TestName", null, new { @class = "am-lab-name TestName", @list = "dlLabTestList", tabindex = "-1", placeholder = "Test name" })
    <div class="am-lab-row-fields">
        @Html.TextBox("TestResult", null, new { @class = "form-control TestResult", placeholder = "Result" })
        @Html.TextBox("TestUnit", null, new { @class = "form-control TestUnit", @list = "dlResultUnit", tabindex = "-1", placeholder = "Unit" })
        @Html.TextBox("TestResultLabel", null, new { @class = "form-control TestResultLabel", @list = "dlResultLabel", tabindex = "-1", placeholder = "Label" })
    </div>
    @Html.TextBox("TestDate", null, new { @class = "am-lab-date TestDate", tabindex = "-1" })
</div>

<datalist id="dlResultLabel">
    @foreach (SelectListItem li in ViewBag.ResultLabelVB)
    {
        <option value="@li.Text"></option>
    }
</datalist>
<datalist id="dlResultUnit">
    @foreach (SelectListItem li in ViewBag.ResultUnitVB)
    {
        <option value="@li.Text"></option>
    }
</datalist>
<datalist id="dlLabTestList">
    @foreach (SelectListItem li in ViewBag.LabTestListVB)
    {
        <option value="@li.Text"></option>
    }
</datalist>



<script type="text/javascript">
    $(document).ready(function () {
        PostPageLoad();
    });

    function addRowLabReports() {
        var row = $("#SampleDataRowLabReports").clone();
        $(row).removeAttr('id');
        $(row).show();
        $(row).find('input').val('');
        $(row).find('.TestDate').val('@DateTime.Now.ToString("dd-MMM-yyyy")');
        $("#tblLabReports").append(row);
        InitializeDateTimePicker(".datepicker");
    }

    function PostPageLoad() {
        InitializeDateTimePicker(".datepicker");
        SetSpecificLabTestsAsOptional();
    }
    function removeRowLabReports(tag) {
        $(tag).closest('.DataRowLabReports').remove();

    }

    function PopulateLabResultValue(tag) {
        var TestName = $(tag).find(".TestName").val();
        var TestResult = $(tag).find(".TestResult").val();



        switch (TestName) {
            case "HBsAg":
                var Result = parseFloat(TestResult);
                if (Result < 1.0) {
                    $(tag).find(".TestResultLabel").val("Non-Reactive");
                }
                else {
                    $(tag).find(".TestResultLabel").val("REACTIVE");
                }

                break;
            case "Anti HCV":
                var Result = parseFloat(TestResult);
                if (TestResult < 1.0) {
                    $(tag).find(".TestResultLabel").val("Non-Reactive");
                }
                else {
                    $(tag).find(".TestResultLabel").val("REACTIVE");
                }
                break;
            case "Anti HIV":
                var Result = parseFloat(TestResult);
                if (TestResult < 1.0) {
                    $(tag).find(".TestResultLabel").val("Non-Reactive");
                }
                else {
                    $(tag).find(".TestResultLabel").val("REACTIVE");
                }
                break;

            default:

        }
    }


    function SetSpecificLabTestsAsOptional()
    {
        var OptionalTests = ["CEA", "CA19-9", "CA125", "Pivica"];

        $(".DataRowLabReports").each(function () {

            var Name = $(this).find(".TestName").val();

            if (OptionalTests.includes(Name)) {

                this.querySelector(".TestResult").style.removeProperty('border-color');

            }

        });
    }


</script>

