@model List<BDCS.Model.Patient.Patient>

@{
    if (Request.IsAjaxRequest())
    {
        Layout = null;
    }

    List<string> userMdtRight = (ViewBag.mdtTypesNameVb as List<SelectListItem>).Select(a => a.Text).ToList();
    bool CanManagePatients = BDCS.Models.SessionHelper.IsUserAuthorized("Add Patient", BDCS.Models.RightType.AddEdit)
        || BDCS.Models.SessionHelper.IsUserAuthorized("Create Visit", BDCS.Models.RightType.AddEdit);
    bool CanSeeAdvanceSearch = BDCS.Models.SessionHelper.IsUserAuthorized("Advance Search", BDCS.Models.RightType.View);

    //patient list filter state - re-read on every reload so the toolbar reflects
    //whatever was last picked instead of resetting to the defaults each time
    string CurrentFilterType = (ViewBag.FilterType as string) ?? "Count";
    int CurrentPatientCount = (ViewBag.PatientCount as int?) ?? 20;
    string CurrentDayPreset = (ViewBag.DayPreset as string) ?? "Last15Days";
    DateTime? CurrentFromDate = ViewBag.FromDate as DateTime?;
    DateTime? CurrentToDate = ViewBag.ToDate as DateTime?;
    List<int> PatientCountOptions = new List<int> { 20, 30, 40, 50, 60, 80, 100 };
}

@* A user with both Liver and Bone Marrow rights sees both history links on every
   row, but a Liver-only patient has nothing behind "BMT History" (and vice versa) -
   clicking it just opens an empty history screen. Render it disabled instead so
   there's nothing to click into when that MDT type has no visits for this patient. *@
@helper HistoryLink(int patientId, string fullName, string mdtType, string label, bool hasHistory)
{
    if (hasHistory)
    {
        <a href="#" onclick="LoadPatientVisitHistory(@patientId,'@fullName','@mdtType');"><i class="fa fa-link"></i> @label</a>
    }
    else
    {
        <span class="am-history-link-disabled" title="No @(mdtType == "Liver" ? "Liver" : "Bone Marrow") history for this patient"><i class="fa fa-link"></i> @label</span>
    }
}

<div class="admin-module">
    <div class="container-fluid">

        <div class="am-page-head">
            <div>
                <h3><i class="fa fa-user-circle-o"></i> Patient Search</h3>
                <span class="am-subtitle">Find an existing patient or register a new one</span>
            </div>
            <button class="btn btn-am-primary" onclick="OpenPatientPopup();"><i class="fa fa-plus"></i> Add Patient</button>
        </div>

        <div class="am-card">
            <div class="am-toolbar" style="margin-bottom:16px; flex-wrap:wrap;">
                <div class="am-search" style="flex:2 1 320px;">
                    <i class="fa fa-search"></i>
                    <input type="text" id="SearchTextBox" class="form-control" placeholder="Search Hospital Number, MRN, Name, Father Name, Contact Number, Address" value="@ViewBag.SearchText" />
                </div>
                <button class="btn btn-am-light" onclick="LoadPageData();"><i class="fa fa-search"></i> Search</button>

                @if (userMdtRight.Contains("Liver") && CanSeeAdvanceSearch)
                {
                    <button class="btn btn-am-light" id="btnsms" onclick="loadPage('@Url.Action("PatientVisitAdvanceSearch","Patient")','Patient');"><i class="fa fa-filter"></i> Advance Search</button>
                }
            </div>

            <div class="am-filter-bar">
                <div class="am-segmented">
                    <div class="am-segmented-option">
                        <input type="radio" name="PatientFilterType" value="Count" id="FilterTypeCount" @(CurrentFilterType == "Count" ? "checked=\"checked\"" : "") onchange="OnFilterTypeChange();" />
                        <label for="FilterTypeCount"><i class="fa fa-sort-numeric-desc"></i> Count</label>
                    </div>
                    <div class="am-segmented-option">
                        <input type="radio" name="PatientFilterType" value="Days" id="FilterTypeDays" @(CurrentFilterType == "Days" ? "checked=\"checked\"" : "") onchange="OnFilterTypeChange();" />
                        <label for="FilterTypeDays"><i class="fa fa-calendar"></i> Days</label>
                    </div>
                </div>

                <div class="am-filter-divider"></div>

                <div id="CountFilterPanel" style="@(CurrentFilterType == "Count" ? "" : "display:none;")">
                    <select id="PatientCountSelect" class="form-control" style="min-width:180px;" onchange="LoadPageData();">
                        @foreach (int opt in PatientCountOptions)
                        {
                            <option value="@opt" selected="@(opt == CurrentPatientCount ? "selected" : null)">Last @opt Patients</option>
                        }
                    </select>
                </div>

                <div id="DaysFilterPanel" style="@(CurrentFilterType == "Days" ? "display:contents;" : "display:none;")">
                    <div class="am-check-grid" style="flex:1 1 auto;">
                        @{
                            var dayPresets = new List<KeyValuePair<string, string>>
                            {
                                new KeyValuePair<string, string>("Today", "Today"),
                                new KeyValuePair<string, string>("Yesterday", "Yesterday"),
                                new KeyValuePair<string, string>("Last15Days", "Last 15 Days"),
                                new KeyValuePair<string, string>("Last1Month", "Last 1 Month"),
                                new KeyValuePair<string, string>("Last3Months", "Last 3 Months"),
                                new KeyValuePair<string, string>("Last6Months", "Last 6 Months"),
                                new KeyValuePair<string, string>("Last1Year", "Last 1 Year"),
                                new KeyValuePair<string, string>("All", "All"),
                                new KeyValuePair<string, string>("Custom", "Custom Range"),
                            };
                        }
                        @foreach (KeyValuePair<string, string> preset in dayPresets)
                        {
                            <div class="am-radio-pill">
                                <input type="radio" name="DayPreset" value="@preset.Key" id="DayPreset_@preset.Key" @(CurrentDayPreset == preset.Key ? "checked=\"checked\"" : "") onchange="OnDayPresetChange();" />
                                <label for="DayPreset_@preset.Key">@preset.Value</label>
                            </div>
                        }
                    </div>
                    <div id="CustomDateRange" style="@(CurrentDayPreset == "Custom" ? "" : "display:none;") flex-basis:100%; margin-top:10px;">
                        <input type="text" id="FromDateInput" class="form-control datepicker" placeholder="From Date" value="@(CurrentFromDate?.ToString("dd-MMM-yyyy"))" style="display:inline-block; width:160px;" />
                        <span style="margin:0 8px; color:var(--am-muted);">to</span>
                        <input type="text" id="ToDateInput" class="form-control datepicker" placeholder="To Date" value="@(CurrentToDate?.ToString("dd-MMM-yyyy"))" style="display:inline-block; width:160px;" />
                        <button class="btn btn-am-primary" onclick="LoadPageData();" style="margin-left:8px;"><i class="fa fa-check"></i> Apply</button>
                    </div>
                </div>
            </div>

            <div id="PatientSearchList" class="col-lg-12" style="padding-left:0px;">
                <div class="col-lg-12" style="padding:0;">
                    @if (Model != null && Model.Any())
                    {
                        <div class="am-result-count"><i class="fa fa-users"></i> Showing @Model.Count patient@(Model.Count == 1 ? "" : "s")</div>
                        <div class="table-responsive">
                            <table class="am-table am-table-patients">
                                <thead>
                                    <tr>
                                        <th style="width:48px;">#</th>
                                        <th>Picture</th>
                                        <th>Registration</th>
                                        <th>Hospital Number</th>
                                        <th>MRN</th>
                                        <th>Name</th>
                                        <th>Gender</th>
                                        <th>Contact</th>
                                        @if (CanManagePatients)
                                        {
                                            <th style="width:60px;">Edit</th>
                                            <th style="width:120px;">Action</th>
                                        }
                                        <th>MDT History</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int srNo = 0; }
                                    @foreach (BDCS.Model.Patient.Patient item in Model)
                                    {
                                        srNo++;
                                        <tr class="crow">
                                            <td>@srNo</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.ImageURL))
                                                {
                                                    <img src="@Url.Content(item.ImageURL)" class="img img-thumbnail" style="max-width: 56px; height: auto;" />
                                                }
                                            </td>
                                            <td>@item.EnteredOn.Value.ToString("dd-MMM-yyyy")</td>
                                            <td>@item.HospitalNumber</td>
                                            <td>@item.MrNumber</td>
                                            <td>@item.FullName</td>
                                            <td>@item.Gender</td>
                                            <td>@item.MobileNumber</td>
                                            @if (CanManagePatients)
                                            {
                                                <td>
                                                    <a href="#" title="Edit" onclick="AddEditPatientDemographics(@item.PatientId); return false;">
                                                        <i class="fa fa-pencil"></i> Edit
                                                    </a>
                                                </td>
                                                <td>
                                                    <div class="am-visit-actions">
                                                        @foreach (SelectListItem items in ViewBag.mdtTypesNameVb)
                                                        {
                                                            if (items.Text == "Liver")
                                                            {
                                                                <a href="#" class="am-visit-btn am-visit-btn-liver" title="Create a Liver MDT visit" onclick="CreateVisit(@item.PatientId, this, 'Liver'); return false;">
                                                                    <i class="fa fa-plus-circle"></i> Liver Visit
                                                                </a>
                                                            }
                                                            else if (items.Text == "Bone Marrow")
                                                            {
                                                                <a href="#" class="am-visit-btn am-visit-btn-bmt" title="Create a Bone Marrow MDT visit" onclick="CreateVisit(@item.PatientId, this, 'BoneMarrow'); return false;">
                                                                    <i class="fa fa-plus-circle"></i> BMT Visit
                                                                </a>
                                                            }
                                                        }
                                                    </div>
                                                </td>
                                            }
                                            <td>
                                                @if (userMdtRight.Contains("Liver") && !userMdtRight.Contains("Bone Marrow"))
                                                {
                                                    @HistoryLink(item.PatientId, item.FullName, "Liver", "Liver History", item.HasLiverHistory)
                                                }
                                                else if (!userMdtRight.Contains("Liver") && userMdtRight.Contains("Bone Marrow"))
                                                {
                                                    @HistoryLink(item.PatientId, item.FullName, "BoneMarrow", "BMT History", item.HasBoneMarrowHistory)
                                                }
                                                else if (userMdtRight.Contains("Liver") && userMdtRight.Contains("Bone Marrow"))
                                                {
                                                    @HistoryLink(item.PatientId, item.FullName, "Liver", "Liver History", item.HasLiverHistory)
                                                    <span>&nbsp;|&nbsp;</span>
                                                    @HistoryLink(item.PatientId, item.FullName, "BoneMarrow", "BMT History", item.HasBoneMarrowHistory)
                                                }
                                                <span>&nbsp;|&nbsp;</span>
                                                <a href="@Url.Action("PatientCard", new {PatientId = item.PatientId})" target="_blank"><i class="fa fa-id-card"></i> Card</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="am-empty">
                            <i class="fa fa-user-circle-o"></i>
                            No patients found.
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-4 col-lg-offset-0" id="PatientInfoBoxContainer" style="display:none;">
                <div id="PatientInfoBox">
                    @*//Histordiv will load here*@
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade modal-sm" tabindex="-1" modal hide" data-backdrop="static" data-keyboard="false" role="dialog" id="MDTTypePopup" style="margin:auto">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Choose MDT Type</h5>
                </div>
                <div class="modal-body" id="MDTTypeBody">
                    @Html.Hidden("hfpatientId")
                    <div class="row">
                        <div class="col-xs-12">

                            @Html.DropDownList("MDTType", (List<SelectListItem>)ViewBag.MDTTypes, new { @class = "form-control", id = "ddlMDTTypeId" })

                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-am-primary" onclick="CreateVisit($('#hfpatientId').val(), this);"><i class="fa fa-check"></i> Create Visit</button>
                </div>
            </div><!-- /.modal-content -->
        </div><!-- /.modal-dialog -->
    </div><!-- /.modal -->
</div>

<script type="text/javascript">
@* This view is always re-rendered through Global.js's loadPage(), which injects this
   markup via jQuery .html() and then explicitly calls PostPageLoad() itself. jQuery
   auto-executes embedded <script> tags on insert, and since the document is already
   "ready" at that point, the $(document).ready callback below would ALSO fire
   immediately - doubling every PostPageLoad() call and, with it, every handler it
   binds (e.g. two keypress handlers on #SearchTextBox, causing a duplicate/blank
   search request to race the real one and sometimes clobber its result). Only the
   true first, non-ajax page load needs this wrapper; every ajax reload already gets
   PostPageLoad() from loadPage() itself. *@
@if (!Request.IsAjaxRequest())
{
    <text>
    $(document).ready(function () {
        PostPageLoad();
    });
    </text>
}



    function OpenPatientPopup() {
        var Url = '@Url.Action("AddEditPatient", "Patient")';
        OpenPopup(Url, "Add New Patient");
    }

    function PostPageLoad() {
        InitializeDateTimePicker('.datepicker');
        @if (Request.QueryString["PreloadList"] != null && Request.QueryString["PreloadList"] == "Yes")
        {
            <text>LoadPageData();</text>
        }

        $("#SearchTextBox").focus();
        $("#SearchTextBox").keypress(function (event) {

            var keycode = (event.keyCode ? event.keyCode : event.which);
            if (keycode == '13') {
                LoadPageData();

                //which view is ot sr
            }

        });
    }

    function LoadPatientVisitHistory(patId, patName,type) {
        //$("#PatientSearchList").toggleClass("col-lg-12 col-lg-6");
        $("#PatientSearchList").removeClass("col-lg-12").addClass("col-lg-8");
        $("#PatientInfoBoxContainer").show();
        $("#btnsms").hide();
        var par = {
            patId: patId,
            patName: patName,
            mdtType:type
        };
        var url = '@Url.Action("GetVisitHistory", "Patient")' + '/?' + $.param(par);
        loadPage(url, "Patient", "PatientInfoBox");

    }

    function ClosePatientInfoBox() {

        //$("#PatientSearchList").toggleClass("col-lg-12 col-lg-6");
        $("#PatientSearchList").removeClass("col-lg-8").addClass("col-lg-12");
        $("#PatientInfoBoxContainer").hide();
        $("#PatientInfoBox").empty();
        $("#btnsms").show();

    }

    function OnFilterTypeChange() {
        var type = $("input[name='PatientFilterType']:checked").val();
        if (type === "Count") {
            $("#CountFilterPanel").show();
            $("#DaysFilterPanel").hide();
        } else {
            $("#CountFilterPanel").hide();
            $("#DaysFilterPanel").show();
        }
        LoadPageData();
    }

    function OnDayPresetChange() {
        var preset = $("input[name='DayPreset']:checked").val();
        if (preset === "Custom") {
            $("#CustomDateRange").show();
            //wait for the user to actually pick both dates and hit Apply
            return;
        }
        $("#CustomDateRange").hide();
        LoadPageData();
    }

    var MonthAbbrev = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    function FormatDateForServer(d) {
        var day = d.getDate();
        return (day < 10 ? "0" + day : day) + "-" + MonthAbbrev[d.getMonth()] + "-" + d.getFullYear();
    }

    //computes the From/To range for every preset except Custom (which reads the
    //two date pickers directly) - "All" still sends a (very wide) range rather than
    //no range at all, so it goes through the same Days code path server-side instead
    //of silently falling back to the Count-based Top(N) query
    function GetDateRangeForPreset(preset) {
        var to = new Date();
        var from = new Date();
        switch (preset) {
            case "Today":
                break;
            case "Yesterday":
                from.setDate(from.getDate() - 1);
                to.setDate(to.getDate() - 1);
                break;
            case "Last15Days":
                from.setDate(from.getDate() - 14);
                break;
            case "Last1Month":
                from.setMonth(from.getMonth() - 1);
                break;
            case "Last3Months":
                from.setMonth(from.getMonth() - 3);
                break;
            case "Last6Months":
                from.setMonth(from.getMonth() - 6);
                break;
            case "Last1Year":
                from.setFullYear(from.getFullYear() - 1);
                break;
            case "All":
                from = new Date(1900, 0, 1);
                break;
        }
        return { From: FormatDateForServer(from), To: FormatDateForServer(to) };
    }

    function LoadPageData() {
        var filterType = $("input[name='PatientFilterType']:checked").val() || "Count";
        var par = {
            searchText: $("#SearchTextBox").val(),
            filterType: filterType
        };

        if (filterType === "Count") {
            par.count = $("#PatientCountSelect").val();
        } else {
            var preset = $("input[name='DayPreset']:checked").val() || "Last15Days";
            par.dayPreset = preset;

            if (preset === "Custom") {
                par.fromDate = $("#FromDateInput").val();
                par.toDate = $("#ToDateInput").val();
                if (!par.fromDate || !par.toDate) {
                    //nothing to apply yet - leave the list as it was until both dates are picked
                    return;
                }
            } else {
                var range = GetDateRangeForPreset(preset);
                par.fromDate = range.From;
                par.toDate = range.To;
            }
        }

        var url = '@Url.Action("GetPatientList", "Patient")' + '/?' + $.param(par);
        loadPage(url, "Patient");
    }

    function CreateVisit(patId, tag, type) {
        var Reason = $(tag).closest("tr").find('.Reason option:selected').text();

        type = type || "Default";

        $.ajax({
            url: '@Url.Action("CreatePatientVisit","Patient")',
            type: 'Post',
            dataType: 'Json',
            data: { patId: patId, reason: Reason, mdttype:type },

            success: (function (msg) {
                if (parseInt(msg.Code) == 200) {

                    loadPage('@Url.Action("AddEditPatientDetail", "Patient")' +
                        '?patId=' + patId +
                        '&visitId=' + msg.ResponseObject +
                        '&reason=' + Reason +
                        '&MDTType=' + type,
                        "Prescription");

                    @*switch (type) {
                        case "Liver":
                            loadPage('@Url.Action("AddEditPatientDetail", "Patient")' + '/?patId=' + patId + ' &visitId=' + msg.ResponseObject + ' &reason=' + Reason, "Prescription");
                            break;
                        case "BoneMarrow":
                            loadPage('@Url.Action("AddEditPatientDetailBoneMarrow", "Patient")' + '/?patId=' + patId + ' &visitId=' + msg.ResponseObject + ' &reason=' + Reason, "Prescription");
                            break;
                        default:
                            alert("Invalid MDT Type");
                            break;
                    }*@
                }
                else {
                    ShowAlertMessage('Unable to Create Visit', 'warning');
                }
            }),
            error: function () {
                ShowAlertMessage("An error occured", 'error');
            }
        });
    }

    function ToggleDiscussionStatus(patId,tag)
    {
        $.ajax({
            url: '@Url.Action("ToggleDiscussionStatus", "Patient")',
            type: 'Post',
            dataType: 'Json',
            data: { patientId: patId },

            success: (function (msg) {
                if (parseInt(msg.Code) == 200) {
                    ShowAlertMessage('Status updated', 'success');
                    LoadPageData();
                }
                else {
                    ShowAlertMessage('Unable to Update Status', 'warning');
                }
            }),
            error: function () {
                ShowAlertMessage("An error occured", 'error');
            }
        });
    }

    function AddEditPatientFunction(patId, visitId, reason, visitDateTime) {


        var par = {

            patId: patId,
            visitId: visitId,
            reason: reason,
        };
        var url = '@Url.Action("AddEditPatientDetail", "Patient")' + '/?' + $.param(par);
        loadPage(url, "Patient");

    }

    function ShowVisitHistory(patId) {
        var par = {
            patId: patId,
        }
        var url = '@Url.Action("GetVisitHistory","Patient")' + '/?' + $.param(par);
        loadPage(url, "GetVisitHistory")
    }

    function AddEditPatientDemographics(patId) {
        var url = '@Url.Action("AddEditPatient","Patient")' + '/?patId=' + patId;
        //loadPage(url, "AddEditPatient");
        OpenPopup(url, "Edit Patient Details");

    }

    function ViewFollowupPatients() {
        var par = {
            followupDate: $("#FollowupDate").val(),
        }
        var url = '@Url.Action("ViewFollowupPatientList", "Patient")' + '/?' + $.param(par);
        loadPage(url, "Patient Search", "PatientSearchList")
    }

    function SendFollowupSms() {


        $.ajax({
            url: '@Url.Action("SendSMSForFollowUp", "Patient")',
            type: 'Post',
            dataType: 'Json',
            data: { followupDate: $("#FollowupDate").val() },

            success: (function (msg) {
                if (parseInt(msg.Code) == 200) {
                    ShowAlertMessage("Sms messages sent.", 'info');
                }
                else {
                    ShowAlertMessage('Unable to Send SMS', 'warning');
                }
            }),
            error: function () {
                ShowAlertMessage("An error occured", 'error');
            }
        });
    }

    //Changes
    function openVisitPopup(patId) {
        $("#hfpatientId").val(patId);
        $("#MDTTypePopup").modal('show');
    }

</script>
