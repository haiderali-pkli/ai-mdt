@model List<BDCS.Model.Patient.Patient>

@{
    if (Request.IsAjaxRequest())
    {
        Layout = null;
    }

    List<string> userMdtRight = (ViewBag.mdtTypesNameVb as List<SelectListItem>).Select(a => a.Text).ToList();
    bool CanManagePatients = BDCS.Models.SessionHelper.GetUserObject().RoleId == 1;
}

<div class="admin-module">
    <div class="container-fluid">

        <div class="am-page-head">
            <div>
                <h3><i class="fa fa-user-circle-o"></i> Patient Search</h3>
                <span class="am-subtitle">Find an existing patient or register a new one</span>
            </div>
            <button class="btn btn-am-primary" onclick="OpenPatientPopup();"><i class="fa fa-plus"></i> Add Patient</button>
        </div>

        <div class="am-card">
            <div class="am-toolbar" style="margin-bottom:16px; flex-wrap:wrap;">
                <div class="am-search" style="flex:2 1 320px;">
                    <i class="fa fa-search"></i>
                    <input type="text" id="SearchTextBox" class="form-control" placeholder="Search Hospital Number, MRN, Name, Father Name, Contact Number, Address" value="@ViewBag.SearchText" />
                </div>
                <button class="btn btn-am-light" onclick="LoadPageData();"><i class="fa fa-search"></i> Search</button>

                @if (userMdtRight.Contains("Liver"))
                {
                    <button class="btn btn-am-light" id="btnsms" onclick="loadPage('@Url.Action("PatientListForMDT","Patient")','Patient');"><i class="fa fa-list"></i> MDT Patient</button>
                    <button class="btn btn-am-light" id="btnsms" onclick="loadPage('@Url.Action("PatientVisitAdvanceSearch","Patient")','Patient');"><i class="fa fa-filter"></i> Advance Search</button>
                }
                @if (userMdtRight.Contains("Bone Marrow"))
                {
                    <button class="btn btn-am-light" id="btnsms" onclick="loadPage('@Url.Action("PatientListOfBMTForMDT","Patient")','Patient');"><i class="fa fa-list"></i> BMT Patient</button>
                }
            </div>

            <div id="PatientSearchList" class="col-lg-12" style="padding-left:0px;">
                <div class="col-lg-12" style="padding:0;">
                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="am-table am-table-patients">
                                <thead>
                                    <tr>
                                        <th>Picture</th>
                                        <th>Registration</th>
                                        <th>Hospital Number</th>
                                        <th>MRN</th>
                                        <th>Name</th>
                                        <th>Gender</th>
                                        <th>Contact</th>
                                        @if (CanManagePatients)
                                        {
                                            <th>Discussion</th>
                                            <th style="width:60px;">Edit</th>
                                            <th style="width:120px;">Action</th>
                                        }
                                        <th>MDT History</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (BDCS.Model.Patient.Patient item in Model)
                                    {
                                        <tr class="crow">
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.ImageURL))
                                                {
                                                    <img src="@Url.Content(item.ImageURL)" class="img img-thumbnail" style="max-width: 56px; height: auto;" />
                                                }
                                            </td>
                                            <td>@item.EnteredOn.Value.ToString("dd-MMM-yyyy")</td>
                                            <td>@item.HospitalNumber</td>
                                            <td>@item.MrNumber</td>
                                            <td><strong>@item.FullName</strong></td>
                                            <td>@item.Gender</td>
                                            <td>@item.MobileNumber</td>
                                            @if (CanManagePatients)
                                            {
                                                <td>
                                                    @if (item.DiscussionRequired.Equals(true))
                                                    {
                                                        <span class="am-pill am-pill-active"><i class="fa fa-circle"></i> Yes</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="am-pill am-pill-inactive"><i class="fa fa-circle"></i> No</span>
                                                    }
                                                </td>
                                                <td>
                                                    <a href="#" title="Edit" onclick="AddEditPatientDemographics(@item.PatientId); return false;">
                                                        <i class="fa fa-pencil"></i> Edit
                                                    </a>
                                                </td>
                                                <td>
                                                    <div class="dropdown" style="display:inline-block;">
                                                        <button class="btn btn-am-light dropdown-toggle" type="button" id="dropdownMenu1" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true" style="padding:5px 10px; font-size:12px;">
                                                            MDT
                                                            <span class="caret"></span>
                                                        </button>
                                                        <ul class="dropdown-menu" aria-labelledby="dropdownMenu1">
                                                            @foreach (SelectListItem items in ViewBag.mdtTypesNameVb)
                                                            {
                                                                if (items.Text == "Liver")
                                                                {
                                                                    <li><a href="#" onclick=" CreateVisit(@item.PatientId, this, 'Liver');">Liver</a></li>
                                                                }
                                                                else if (items.Text == "Bone Marrow")
                                                                {
                                                                    <li><a href="#" onclick=" CreateVisit(@item.PatientId, this, 'BoneMarrow');">Bone Marrow</a></li>
                                                                }
                                                            }
                                                        </ul>
                                                    </div>
                                                    <a href="#" onclick="ToggleDiscussionStatus(@item.PatientId,this); return false;" title="Toggle Discussion Status" style="margin-left:6px;">
                                                        <i class="fa fa-tasks"></i>
                                                    </a>
                                                </td>
                                            }
                                            <td>
                                                @if (userMdtRight.Contains("Liver") && !userMdtRight.Contains("Bone Marrow"))
                                                {
                                                    <a href="#" onclick="LoadPatientVisitHistory(@item.PatientId,'@item.FullName','Liver');"><i class="fa fa-link"></i> Liver History</a>
                                                }
                                                else if (!userMdtRight.Contains("Liver") && userMdtRight.Contains("Bone Marrow"))
                                                {
                                                    <a href="#" onclick="LoadPatientVisitHistory(@item.PatientId,'@item.FullName','BoneMarrow');"><i class="fa fa-link"></i> BMT History</a>
                                                }
                                                else if (userMdtRight.Contains("Liver") && userMdtRight.Contains("Bone Marrow"))
                                                {
                                                    <a href="#" onclick="LoadPatientVisitHistory(@item.PatientId,'@item.FullName','Liver');"><i class="fa fa-link"></i> Liver History</a>
                                                    <span>&nbsp;|&nbsp;</span>
                                                    <a href="#" onclick="LoadPatientVisitHistory(@item.PatientId,'@item.FullName','BoneMarrow');"><i class="fa fa-link"></i> BMT History</a>
                                                }
                                                <span>&nbsp;|&nbsp;</span>
                                                <a href="@Url.Action("PatientCard", new {PatientId = item.PatientId})" target="_blank"><i class="fa fa-id-card"></i> Card</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="am-empty">
                            <i class="fa fa-user-circle-o"></i>
                            No patients found.
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-4 col-lg-offset-0" id="PatientInfoBoxContainer" style="display:none;">
                <div id="PatientInfoBox">
                    @*//Histordiv will load here*@
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade modal-sm" tabindex="-1" modal hide" data-backdrop="static" data-keyboard="false" role="dialog" id="MDTTypePopup" style="margin:auto">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Choose MDT Type</h5>
                </div>
                <div class="modal-body" id="MDTTypeBody">
                    @Html.Hidden("hfpatientId")
                    <div class="row">
                        <div class="col-xs-12">

                            @Html.DropDownList("MDTType", (List<SelectListItem>)ViewBag.MDTTypes, new { @class = "form-control", id = "ddlMDTTypeId" })

                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-am-primary" onclick="CreateVisit($('#hfpatientId').val(), this);"><i class="fa fa-check"></i> Create Visit</button>
                </div>
            </div><!-- /.modal-content -->
        </div><!-- /.modal-dialog -->
    </div><!-- /.modal -->
</div>

<script type="text/javascript">
    $(document).ready(function () {

        PostPageLoad();
    });



    function OpenPatientPopup() {
        var Url = '@Url.Action("AddEditPatient", "Patient")';
        OpenPopup(Url, "Add New Patient");
    }

    function PostPageLoad() {
        InitializeDateTimePicker('.datepicker');
        @if (Request.QueryString["PreloadList"] != null && Request.QueryString["PreloadList"] == "Yes")
        {
            <text>LoadPageData();</text>
        }

        $("#SearchTextBox").focus();
        $("#SearchTextBox").keypress(function (event) {

            var keycode = (event.keyCode ? event.keyCode : event.which);
            if (keycode == '13') {
                LoadPageData();

                //which view is ot sr
            }

        });
    }

    function LoadPatientVisitHistory(patId, patName,type) {
        //$("#PatientSearchList").toggleClass("col-lg-12 col-lg-6");
        $("#PatientSearchList").removeClass("col-lg-12").addClass("col-lg-8");
        $("#PatientInfoBoxContainer").show();
        $("#btnsms").hide();
        var par = {
            patId: patId,
            patName: patName,
            mdtType:type
        };
        var url = '@Url.Action("GetVisitHistory", "Patient")' + '/?' + $.param(par);
        loadPage(url, "Patient", "PatientInfoBox");

    }

    function ClosePatientInfoBox() {

        //$("#PatientSearchList").toggleClass("col-lg-12 col-lg-6");
        $("#PatientSearchList").removeClass("col-lg-8").addClass("col-lg-12");
        $("#PatientInfoBoxContainer").hide();
        $("#PatientInfoBox").empty();
        $("#btnsms").show();

    }

    function LoadPageData() {
        var par = {
            searchText: $("#SearchTextBox").val(),

        };
        var url = '@Url.Action("GetPatientList", "Patient")' + '/?' + $.param(par);
        loadPage(url, "Patient");
    }

    function CreateVisit(patId, tag, type) {
        var Reason = $(tag).closest("tr").find('.Reason option:selected').text();

        type = type || "Default";

        $.ajax({
            url: '@Url.Action("CreatePatientVisit","Patient")',
            type: 'Post',
            dataType: 'Json',
            data: { patId: patId, reason: Reason, mdttype:type },

            success: (function (msg) {
                if (parseInt(msg.Code) == 200) {

                    loadPage('@Url.Action("AddEditPatientDetail", "Patient")' +
                        '?patId=' + patId +
                        '&visitId=' + msg.ResponseObject +
                        '&reason=' + Reason +
                        '&MDTType=' + type,
                        "Prescription");

                    @*switch (type) {
                        case "Liver":
                            loadPage('@Url.Action("AddEditPatientDetail", "Patient")' + '/?patId=' + patId + ' &visitId=' + msg.ResponseObject + ' &reason=' + Reason, "Prescription");
                            break;
                        case "BoneMarrow":
                            loadPage('@Url.Action("AddEditPatientDetailBoneMarrow", "Patient")' + '/?patId=' + patId + ' &visitId=' + msg.ResponseObject + ' &reason=' + Reason, "Prescription");
                            break;
                        default:
                            alert("Invalid MDT Type");
                            break;
                    }*@
                }
                else {
                    ShowAlertMessage('Unable to Create Visit', 'warning');
                }
            }),
            error: function () {
                ShowAlertMessage("An error occured", 'error');
            }
        });
    }

    function ToggleDiscussionStatus(patId,tag)
    {
        $.ajax({
            url: '@Url.Action("ToggleDiscussionStatus", "Patient")',
            type: 'Post',
            dataType: 'Json',
            data: { patientId: patId },

            success: (function (msg) {
                if (parseInt(msg.Code) == 200) {
                    ShowAlertMessage('Status updated', 'success');
                    LoadPageData();
                }
                else {
                    ShowAlertMessage('Unable to Update Status', 'warning');
                }
            }),
            error: function () {
                ShowAlertMessage("An error occured", 'error');
            }
        });
    }

    function AddEditPatientFunction(patId, visitId, reason, visitDateTime) {


        var par = {

            patId: patId,
            visitId: visitId,
            reason: reason,
        };
        var url = '@Url.Action("AddEditPatientDetail", "Patient")' + '/?' + $.param(par);
        loadPage(url, "Patient");

    }

    function ShowVisitHistory(patId) {
        var par = {
            patId: patId,
        }
        var url = '@Url.Action("GetVisitHistory","Patient")' + '/?' + $.param(par);
        loadPage(url, "GetVisitHistory")
    }

    function AddEditPatientDemographics(patId) {
        var url = '@Url.Action("AddEditPatient","Patient")' + '/?patId=' + patId;
        //loadPage(url, "AddEditPatient");
        OpenPopup(url, "Edit Patient Details");

    }

    function ViewFollowupPatients() {
        var par = {
            followupDate: $("#FollowupDate").val(),
        }
        var url = '@Url.Action("ViewFollowupPatientList", "Patient")' + '/?' + $.param(par);
        loadPage(url, "Patient Search", "PatientSearchList")
    }

    function SendFollowupSms() {


        $.ajax({
            url: '@Url.Action("SendSMSForFollowUp", "Patient")',
            type: 'Post',
            dataType: 'Json',
            data: { followupDate: $("#FollowupDate").val() },

            success: (function (msg) {
                if (parseInt(msg.Code) == 200) {
                    ShowAlertMessage("Sms messages sent.", 'info');
                }
                else {
                    ShowAlertMessage('Unable to Send SMS', 'warning');
                }
            }),
            error: function () {
                ShowAlertMessage("An error occured", 'error');
            }
        });
    }

    //Changes
    function openVisitPopup(patId) {
        $("#hfpatientId").val(patId);
        $("#MDTTypePopup").modal('show');
    }

</script>
