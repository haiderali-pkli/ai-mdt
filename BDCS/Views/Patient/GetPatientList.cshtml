@model List<BDCS.Model.Patient.Patient>

@{
    if (Request.IsAjaxRequest())
    {
        Layout = null;
    }

    List<string> userMdtRight = (ViewBag.mdtTypesNameVb as List<SelectListItem>).Select(a => a.Text).ToList();
}

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <div class="row" style="margin-top: 47px;">
                <h3 class="heading">Patient Search</h3>
            </div>
            <!-- Container for buttons alignment -->
            <div class="row">
                <!-- Left side: Search and Add buttons -->
                <div class="col-sm-8">
                    <div class="row">
                        <div class="col-sm-6">
                            <input type="text" id="SearchTextBox" class="form-control padding-input full-width" style="max-width:100%" placeholder="Search Hospital Number, MRN,Name,Father Name,Contact Number,Address" value="@ViewBag.SearchText" />
                        </div>
                        <div class="col-sm-2">
                            <button class="btn btn-block btn-dark btn-info" onclick="LoadPageData();"><span class="glyphicon glyphicon-search"></span> Search</button>
                        </div>
                        <div class="col-sm-2">
                            <button class="btn btn-block btn-success" onclick="OpenPatientPopup();"><span class="glyphicon glyphicon-plus-sign"></span> Add</button>
                        </div>
                    </div>
                </div>

                <!-- Right side: Advanced Search, MDT, BMT buttons -->
                <div class="col-sm-4 text-right">
                    <div class="row">

                        @if (userMdtRight.Contains("Liver"))
                        {
                            <div class="col-sm-3">
                                <button class="btn btn-blockbtn-warning" id="btnsms" onclick="loadPage('@Url.Action("PatientListForMDT","Patient")','Patient');">MDT Patient</button>
                            </div>
                            <div class="col-sm-4">
                                <button class="btn btn-block btn-info" id="btnsms" onclick="loadPage('@Url.Action("PatientVisitAdvanceSearch","Patient")','Patient');">Advance Search</button>
                            </div>
                        }
                        @if (userMdtRight.Contains("Bone Marrow"))
                        {
                            <div class="col-sm-3">
                                <button class="btn btn-blockbtn-warning" id="btnsms" onclick="loadPage('@Url.Action("PatientListOfBMTForMDT","Patient")','Patient');">BMT Patient</button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-12" style="margin-top:20px;padding-left:0px" id="PatientSearchList">
                    <div class="col-lg-12">
                        @if (Model != null && Model.Any())
                        {
                            <table class="table table-bordered table-striped">
                                <thead>
                                    <tr style="background-color: #57b7fd;color:white;">
                                        <th>Picture</th>
                                        <th>Registration</th>
                                        <th>Hospital Number</th>
                                        <th>MRN</th>
                                        <th>Name</th>
                                        <th>Gender</th>
                                        <th>Contact</th>
                                        @if (BDCS.Models.SessionHelper.GetUserObject().RoleId == 1)
                                        {
                                            <th>Discussion</th>
                                            <th>Edit</th>
                                            <th style="column-width:41px;">Action</th>
                                        }
                                        <th>MDT History</th>

                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (BDCS.Model.Patient.Patient item in Model)
                                    {
                                        <tr class="crow">
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.ImageURL))
                                                {
                                                    <img src="@Url.Content(item.ImageURL)" class="img img-thumbnail" style="max-width: 75px; height: auto;" />
                                                }
                                            </td>
                                            <td>@item.EnteredOn.Value.ToString("dd-MMM-yyyy")</td>
                                            <td>@item.HospitalNumber</td>
                                            <td>@item.MrNumber</td>
                                            <td>@item.FullName</td>
                                            <td>@item.Gender</td>
                                            <td>@item.MobileNumber</td>
                                            @if (BDCS.Models.SessionHelper.GetUserObject().RoleId == 1)
                                            {
                                                @*<td>@(item.DiscussionRequired ? "Yes" : "No")</td><td></td>*@

                                                <td>@(item.DiscussionRequired.Equals(true)  ? "Yes" : "No")</td>
                                                <td>
                                                    <a href="#" onclick="AddEditPatientDemographics(@item.PatientId);">
                                                        <span class="glyphicon glyphicon-edit"></span>
                                                    </a>
                                                </td>
                                                <td style="column-width:41px;">
                                                    <div class="dropdown">
                                                        <button class="btn btn-default dropdown-toggle" type="button" id="dropdownMenu1" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                                                            MDT
                                                            <span class="caret"></span>
                                                        </button>
                                                        <ul class="dropdown-menu" aria-labelledby="dropdownMenu1">
                                                            @foreach (SelectListItem items in ViewBag.mdtTypesNameVb)
                                                            {
                                                                if (items.Text == "Liver")
                                                                {
                                                                    <li><a href="#" onclick=" CreateVisit(@item.PatientId, this, 'Liver');">Liver</a></li>
                                                                }
                                                                else if (items.Text == "Bone Marrow")
                                                                {
                                                                    <li><a href="#" onclick=" CreateVisit(@item.PatientId, this, 'BoneMarrow');">Bone Marrow</a></li>
                                                                }
                                                            }
                                                        </ul>
                                                    </div>
                                                    |
                                                    <a href="#" onclick="ToggleDiscussionStatus(@item.PatientId,this);" title="Toggle Discussion Status">
                                                        <span class="glyphicon glyphicon-tasks"></span>
                                                    </a>
                                                </td>
                                            }
                                        <td>

                                                            @*@if (userMdtRight.Contains("Liver"))
                        {
                            <a href="#" onclick="LoadPatientVisitHistory(@item.PatientId,'@item.FullName','Liver');">
                                <span class="glyphicon glyphicon-link"> History1</span>
                            </a>
                        }
                        @if (userMdtRight.Contains("Bone Marrow"))
                        {
                            <a href="#" onclick="LoadPatientVisitHistory(@item.PatientId,'@item.FullName','BoneMarrow');">
                                <span class="glyphicon glyphicon-link"> History2</span>
                            </a>
                        }*@

                                            @if (userMdtRight.Contains("Liver") && !userMdtRight.Contains("Bone Marrow"))
                                            {
                                                // Only Liver
                                                <a href="#" onclick="LoadPatientVisitHistory(@item.PatientId,'@item.FullName','Liver');">
                                                    <span class="glyphicon glyphicon-link"></span> Liver History
                                                </a>
                                            }
                                            else if (!userMdtRight.Contains("Liver") && userMdtRight.Contains("Bone Marrow"))
                                            {
                                                // Only Bone Marrow
                                                <a href="#" onclick="LoadPatientVisitHistory(@item.PatientId,'@item.FullName','BoneMarrow');">
                                                    <span class="glyphicon glyphicon-link"></span> BMT History
                                                </a>
                                            }
                                            else if (userMdtRight.Contains("Liver") && userMdtRight.Contains("Bone Marrow"))
                                            {
                                                // Both
                                                <a href="#" onclick="LoadPatientVisitHistory(@item.PatientId,'@item.FullName','Liver');">
                                                    <span class="glyphicon glyphicon-link"></span> Liver History
                                                </a>
                                                <span>&nbsp;|&nbsp;</span>
                                                <a href="#" onclick="LoadPatientVisitHistory(@item.PatientId,'@item.FullName','BoneMarrow');">
                                                    <span class="glyphicon glyphicon-link"></span> BMT History
                                                </a>
                                            }

                                            <a href="@Url.Action("PatientCard", new {PatientId = item.PatientId})" target="_blank">
                                                <span class="glyphicon glyphicon-certificate">Card</span>
                                            </a>
                                        </td>
                                     
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <h3>No Data found</h3>
                        }
                    </div>
                </div>

                <div class="col-lg-4 col-lg-offset-0" id="PatientInfoBoxContainer" style="display:none;">
                    <div id="PatientInfoBox">
                        @*//Histordiv will load here*@
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade modal-sm" tabindex="-1" modal hide" data-backdrop="static" data-keyboard="false" role="dialog" id="MDTTypePopup" style="margin:auto">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" style="text-align:center">Choose MDT Type</h5>
            </div>
            <div class="modal-body" id="MDTTypeBody">
                @Html.Hidden("hfpatientId")
                <div class="row">
                    <div class="col-xs-12">

                        @Html.DropDownList("MDTType", (List<SelectListItem>)ViewBag.MDTTypes, new { @class = "form-control", id = "ddlMDTTypeId" })

                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-success" onclick="CreateVisit($('#hfpatientId').val(), this);">Create Visit</button>
            </div>
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal -->

<script type="text/javascript">
    $(document).ready(function () {

        PostPageLoad();
    });

    

    function OpenPatientPopup() {
        var Url = '@Url.Action("AddEditPatient", "Patient")';
        OpenPopup(Url, "Add New Patient");
    }

    function PostPageLoad() {
        InitializeDateTimePicker('.datepicker');
        @if (Request.QueryString["PreloadList"] != null && Request.QueryString["PreloadList"] == "Yes")
        {
            <text>LoadPageData();</text>
        }

        $("#SearchTextBox").focus();
        $("#SearchTextBox").keypress(function (event) {

            var keycode = (event.keyCode ? event.keyCode : event.which);
            if (keycode == '13') {
                LoadPageData();

                //which view is ot sr
            }

        });
    }

    function LoadPatientVisitHistory(patId, patName,type) {
        //$("#PatientSearchList").toggleClass("col-lg-12 col-lg-6");
        $("#PatientSearchList").removeClass("col-lg-12").addClass("col-lg-8");
        $("#PatientInfoBoxContainer").show();
        $("#btnsms").hide();
        var par = {
            patId: patId,
            patName: patName,
            mdtType:type
        };
        var url = '@Url.Action("GetVisitHistory", "Patient")' + '/?' + $.param(par);
        loadPage(url, "Patient", "PatientInfoBox");

    }

    function ClosePatientInfoBox() {

        //$("#PatientSearchList").toggleClass("col-lg-12 col-lg-6");
        $("#PatientSearchList").removeClass("col-lg-8").addClass("col-lg-12");
        $("#PatientInfoBoxContainer").hide();
        $("#PatientInfoBox").empty();
        $("#btnsms").show();

    }

    function LoadPageData() {
        var par = {
            searchText: $("#SearchTextBox").val(),

        };
        var url = '@Url.Action("GetPatientList", "Patient")' + '/?' + $.param(par);
        loadPage(url, "Patient");
    }

    function CreateVisit(patId, tag, type) {
        var Reason = $(tag).closest("tr").find('.Reason option:selected').text();

        type = type || "Default";

        $.ajax({
            url: '@Url.Action("CreatePatientVisit","Patient")',
            type: 'Post',
            dataType: 'Json',
            data: { patId: patId, reason: Reason, mdttype:type },

            success: (function (msg) {
                if (parseInt(msg.Code) == 200) {

                    loadPage('@Url.Action("AddEditPatientDetail", "Patient")' +
                        '?patId=' + patId +
                        '&visitId=' + msg.ResponseObject +
                        '&reason=' + Reason +
                        '&MDTType=' + type,
                        "Prescription");

                    @*switch (type) {
                        case "Liver":
                            loadPage('@Url.Action("AddEditPatientDetail", "Patient")' + '/?patId=' + patId + ' &visitId=' + msg.ResponseObject + ' &reason=' + Reason, "Prescription");
                            break;
                        case "BoneMarrow":
                            loadPage('@Url.Action("AddEditPatientDetailBoneMarrow", "Patient")' + '/?patId=' + patId + ' &visitId=' + msg.ResponseObject + ' &reason=' + Reason, "Prescription");
                            break;
                        default:
                            alert("Invalid MDT Type");
                            break;
                    }*@
                }
                else {
                    ShowAlertMessage('Unable to Create Visit', 'warning');
                }
            }),
            error: function () {
                ShowAlertMessage("An error occured", 'error');
            }
        });
    }

    function ToggleDiscussionStatus(patId,tag)
    {
        $.ajax({
            url: '@Url.Action("ToggleDiscussionStatus", "Patient")',
            type: 'Post',
            dataType: 'Json',
            data: { patientId: patId },

            success: (function (msg) {
                if (parseInt(msg.Code) == 200) {
                    alert('Status updated');
                }
                else {
                    ShowAlertMessage('Unable to Update Status', 'warning');
                }
            }),
            error: function () {
                ShowAlertMessage("An error occured", 'error');
            }
        });
    }

    function AddEditPatientFunction(patId, visitId, reason, visitDateTime) {


        var par = {

            patId: patId,
            visitId: visitId,
            reason: reason,
        };
        var url = '@Url.Action("AddEditPatientDetail", "Patient")' + '/?' + $.param(par);
        loadPage(url, "Patient");

    }

    function ShowVisitHistory(patId) {
        var par = {
            patId: patId,
        }
        var url = '@Url.Action("GetVisitHistory","Patient")' + '/?' + $.param(par);
        loadPage(url, "GetVisitHistory")
    }

    function AddEditPatientDemographics(patId) {
        var url = '@Url.Action("AddEditPatient","Patient")' + '/?patId=' + patId;
        //loadPage(url, "AddEditPatient");
        OpenPopup(url, "Edit Patient Details");

    }

    function ViewFollowupPatients() {
        var par = {
            followupDate: $("#FollowupDate").val(),
        }
        var url = '@Url.Action("ViewFollowupPatientList", "Patient")' + '/?' + $.param(par);
        loadPage(url, "Patient Search", "PatientSearchList")
    }

    function SendFollowupSms() {


        $.ajax({
            url: '@Url.Action("SendSMSForFollowUp", "Patient")',
            type: 'Post',
            dataType: 'Json',
            data: { followupDate: $("#FollowupDate").val() },

            success: (function (msg) {
                if (parseInt(msg.Code) == 200) {
                    ShowAlertMessage("Sms messages sent.", 'info');
                }
                else {
                    ShowAlertMessage('Unable to Send SMS', 'warning');
                }
            }),
            error: function () {
                ShowAlertMessage("An error occured", 'error');
            }
        });
    }

    //Changes
    function openVisitPopup(patId) {
        $("#hfpatientId").val(patId);
        $("#MDTTypePopup").modal('show');
    }

</script>
