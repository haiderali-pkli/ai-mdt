@model List<BDCS.Model.Visit.Visit>
@{
    if (Request.IsAjaxRequest())
    {
        Layout = null;
    }
    bool CanManagePatients = BDCS.Models.SessionHelper.GetUserObject().RoleId == 1;
}

<div class="am-card" style="margin-bottom:0;">
    <div class="am-rolecard-head-row" style="margin-bottom:14px;">
        <div>
            <div class="am-rolecard-title">Visit History</div>
            <span class="am-subtitle">@ViewBag.PatientName</span>
        </div>
        <button type="button" class="btn btn-am-light" onclick="ClosePatientInfoBox();" title="Close">
            <i class="fa fa-times"></i>
        </button>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="am-table" id="tblVisitHistory">
                <thead>
                    <tr>
                        <th>Visit Id</th>
                        <th>Visit Date</th>
                        <th>MDT Type</th>
                        <th style="width:110px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (BDCS.Model.Visit.Visit item in Model)
                    {
                        <tr>
                            <td>@item.VisitId</td>
                            <td>@item.VisitDate</td>
                            <td><span class="am-badge">@item.MDTType</span></td>
                            <td>
                                <a href="@Url.Action("PatientVisitReportRdlc","Patient",new { patId = item.PatientId, visitId = item.VisitId, item.Reason,mdtType=item.MDTType })" target="_blank" title="Print">
                                    <i class="fa fa-print"></i>
                                </a>
                                @if (CanManagePatients)
                                {
                                    <a href="#" onclick="AddEditPatientFunction(@item.PatientId,@item.VisitId,'@item.VisitDate','@item.Reason','@item.MDTType')" title="Edit" style="margin-left:8px;">
                                        <i class="fa fa-pencil"></i>
                                    </a>
                                    <a href="#" onclick="CopyVisit(@item.PatientId,@item.VisitId,'@item.MDTType')" title="Copy" style="margin-left:8px;">
                                        <i class="fa fa-copy"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="am-empty">
            <i class="fa fa-history"></i>
            No history found for this patient.
        </div>
    }
</div>


<script type="text/javascript">

    function AddEditPatientFunction(patId, visitId, visitdt, reason, mdttype) {

        var par = {
            patId: patId,
            visitId: visitId,
            visitDateTime: visitdt,
            reason: reason,
            mdtType:mdttype



        };

        var url = '@Url.Action("AddEditPatientDetail", "Patient")' + '/?' + $.param(par);
        loadPage(url, "Patient");

    }


    function CopyVisit(patId, visitId,mdtTypes) {
        var URL = "";
        if (mdtTypes == "BoneMarrow") {
            URL = '@Url.Action("CopyVisitBMT", "Patient")';
        }
        else if (mdtTypes == "Liver") {
            URL = '@Url.Action("CopyVisit", "Patient")';
        }

        $.ajax({
            url: URL,
            type: 'Post',
            dataType: 'Json',
            data: { patientId: patId, oldVisitId: visitId, mdtType: mdtTypes },

            success: (function (msg) {
                if (parseInt(msg.Code) == 200) {

                     loadPage('@Url.Action("AddEditPatientDetail", "Patient")' +
                         '/?patId=' + patId +
                         '&visitId=' + msg.ResponseObject +
                         '&reason=' + encodeURIComponent('Followup') +
                         '&MDTType=' + encodeURIComponent(mdtTypes));


                }
                else {
                    ShowAlertMessage('Unable to Create Visit', 'warning');
                }
            }),
            error: function () {
                ShowAlertMessage("An error occured", 'error');
            }
        });
    }

    function AddServices(patId, visitId) {

        var par = {
            patientId: patId,
            visitId: visitId


        };

        var url = '@Url.Action("AddPatientServices", "Patient")' + '/?' + $.param(par);
        loadPage(url, "Patient");

    }
</script>
