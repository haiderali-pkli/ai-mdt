@model BDCS.Model.Patient.Patient
@{
    ViewBag.Title = "Patient Card";
    Layout = null;
}


<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Basic -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <!-- Mobile Metas -->
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="viewport" content="initial-scale=1, maximum-scale=1">
    <!-- Site Metas -->
    <title>Patient Card</title>
    <meta name="keywords" content="">
    <meta name="description" content="">
    <meta name="author" content="">
    <!-- Site Icons -->
    <link rel="shortcut icon" href="~/Content/theme/images/fevicon.ico.png" type="image/x-icon" />
    <link rel="apple-touch-icon" href="~/Content/theme/images/apple-touch-icon.png">
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/Content/theme/css/bootstrap.min.css">
    <!-- Site CSS -->
    <link rel="stylesheet" href="style.css">
    <!-- Colors CSS -->
    <link rel="stylesheet" href="~/Content/theme/css/colors.css">
    <!-- ALL VERSION CSS -->
    <link rel="stylesheet" href="~/Content/theme/css/versions.css">
    <!-- Responsive CSS -->
    <link rel="stylesheet" href="~/Content/theme/css/responsive.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/Content/theme/css/custom.css">


    <link href="~/Content/Plugin/Jquery.toast/jquery.toast.min.css" rel="stylesheet" />

    <link href="~/Content/Plugin/Bootstrap-datepicker/css/bootstrap-datepicker.min.css" rel="stylesheet" />

    <!-- Modernizer for Portfolio -->
    <script src="js/modernizer.js"></script>
    <!-- [if lt IE 9] -->
    <!-- all js files -->
    <script src="~/Content/theme/js/all.js"></script>
    <!-- all plugins -->
    <script src="~/Content/theme/js/custom.js"></script>

    <script src="~/Content/Plugin/JsBarcode.all.min.js"></script>
</head>
<body class="clinic_version" onload="hideloader();">

    <!-- LOADER -->
    <div id="preloader" style="display:block;">
        <img class="preloader" src="~/Content/theme/images/loaders/heart-loading2.gif" alt="" style="display:block;">
    </div>
    <!-- END LOADER -->

    
    <div id="MainContent" class="parallax first-section wow fadeIn" data-stellar-background-ratio="0.4" style="display:none;">
        <div class="container-fluid">


            <div class="row">
                <div class="col-sm-6 col-sm-offset-3">
                    @*<img src="https://seekvectorlogo.com/wp-content/uploads/2018/09/european-metal-recycling-emr-vector-logo.png" alt="Placeholder" class="img img-responsive" style="height: 120px; width: auto; margin-top: 0px; margin-left: 191px;" />*@
                    <h1 class="text-center">Patient Card Information</h1>
                </div>
            </div>
            
            <div class="row">
                <div class="col-sm-4 col-sm-offset-4" style="border:1px double #000; padding:10px";>
                    <div class="row">
                        <div class="col-sm-6">
                            <b>Full Name:</b>
                        </div>
                        <div class="col-sm-6">
                            <label>@Model.FullName</label>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-6">
                            <b>MRN:</b>
                        </div>
                        <div class="col-sm-6">
                            <label>@Model.HospitalNumber</label>
                        </div>
                    </div>


                    <div class="row">
                        <div class="col-sm-12" >
                           <svg id="MrnBarcode"></svg>
                        </div>

                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <b>DOB:</b>
                        </div>
                        <div class="col-sm-6">
                            <label>@(Model.DOB?.ToString("dd-MMM-yy"))</label>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-6">
                            <b>Reg Date:</b>
                        </div>
                        <div class="col-sm-6">
                            <label>@(Model.EnteredOn?.ToString("dd-MMM-yy"))</label>
                        </div>
                    </div>

                </div>
            </div>
            
            <div class="row hidden-print col-sm-7 col-lg-offset-5" style="margin-top:20px;padding-left:147px ;">
                <div class="col-sm-2">
                    <button class="btn btn-block btn-info" onclick="window.print();"><span class="glyphicon glyphicon-print"></span> Print</button>
                </div>
                <div class="col-sm-2">
                    <button class="btn btn-block btn-danger" onclick="window.close();"><span class="glyphicon glyphicon-eye-close"></span> Close</button>
                </div>
            </div>

        </div>
        <!-- end container -->
    </div>



    <script src="~/Content/Plugin/Bootstrap-datepicker/js/bootstrap-datepicker.min.js"></script>
    <script src="~/Scripts/App/Global.js"></script>


</body>
</html>


<script type="text/javascript">


    $(document).ready(function () {
  


        JsBarcode("#MrnBarcode", "@Model.MrNumber", {

            lineColor: "#0aa",
            width: 2,
            height:40,
            displayValue: false
        });
    });

  

    function hideloader() {
        $("#MainContent").show();
        $("#preloader").hide();
    }
</script>