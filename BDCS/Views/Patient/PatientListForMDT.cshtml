@model List<BDCS.Model.VitalHistory.VitalHistory>
@{
    ViewBag.Title = "Patient List for MDT";

    if (Request.IsAjaxRequest())
    {
        Layout = null;
    }
}
    <div class="panel panel-default" style="padding-top: 50px;">
        <div class="panel-heading" style="background-color: #57b7fd; color:white;"><strong style="font-size:25px">Patient List for MDT</strong></div>
        <div class="panel-body" style="border-color:#a0e0ee">

            <form action="@Url.Action("PatientListForMDT")" method="post">
                <div class="row">
                    <div class="col-sm-12">
                        <div class="col-sm-10">
                            <div class="col-sm-2">
                                <label>From Date</label>
                                @Html.TextBox("fromDate", (string)ViewBag.FromDate.ToString("dd-MMM-yyyy"), new { @class = "form-control datepicker" })
                            </div>
                            <div class="col-sm-2">
                                <label>To Date</label>
                                @Html.TextBox("toDate", (string)ViewBag.ToDate.ToString("dd-MMM-yyyy"), new { @class = "form-control datepicker" })
                            </div>
                            <div class="col-sm-2">
                                <label>&nbsp;</label>
                                <button class="btn btn-block btn-primary">Search</button>
                            </div>
                            <div class="col-sm-2">
                                <label>&nbsp;</label>
                                <a class="btn btn-block btn-warning" href="@Url.Action("ExportPatientListForMDT","Patient",new {fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate })">Export</a>
                            </div>
                            <div class="col-sm-2" style="margin-top: 25px;">
                                <label>&nbsp;</label>
                                @*<button type="button" class="btn btn-primary"onclick="@Url.Action("GetPatientList", "Patient")";>Close</button>*@
                                <a class="btn btn-danger" href="@Url.Action("GetPatientList", "Patient")">Close</a>
                            </div>
                        </div>
                        <div class="col-sm-2">

                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>


    <div class="row">

        @if (Model != null && Model.Any())
        {
            <div class="col-sm-12">
                <table class="table table-responsive table-bordered table-striped">
                    <thead>
                        <tr style="background: #57b7fd; color:white">
                            <th>Patient Name</th>
                            <th>MR Number</th>
                            <th>Visit Date</th>
                            <th>No. Of Lesions</th>
                            <th>Largest Lesion size</th>
                            <th>Extra Hepatic Disease</th>
                            <th>Angio invasion</th>
                            <th>MDT Discussion</th>
                            <th>MDT Outcome</th>
                            <th>Print</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (BDCS.Model.VitalHistory.VitalHistory vh in Model)
                        {
                            <tr>
                                <td>
                                    <a href="#" onclick="AddEditPatientFunction(@vh.PatientId, @vh.VisitId, '@vh.VisitDateTime.Value.ToString("dd-MMM-yy")', '')">@vh.PatientName</a>
                                </td>
                                <td>@vh.HospitalNumber</td>
                                <td>@vh.VisitDateTime.Value.ToString("dd-MMM-yyyy")</td>
                                <td>@vh.NumberOfLesionValue</td>
                                <td>@vh.LargestLesionSize</td>

                                <td>
                                    @(vh.ExtraHepaticDisease ? "Yes":"No")
                                </td>
                                <td>
                                    @(vh.Angioinvasion ? "Yes":"No")
                                </td>
                                <td>@vh.MDTDiscussion</td>
                                <td>@vh.MDTOutComeString</td>
                                <td>
                                    <a href="@Url.Action("PatientVisitReportRdlc","Patient",new { patId = vh.PatientId, visitId = vh.VisitId,mdtType="Liver" })" target="_blank">
                                        <span class="glyphicon glyphicon-print"></span>
                                    </a>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            </div>
        }
    </div>

<script type="text/javascript">

    $(document).ready(function () {
        PostPageLoad();
    });

    function PostPageLoad()
    {
        InitializeDateTimePicker(".datepicker");
    }



     function redirectToPatientList() {
        // Redirect to the 'GetPatientList' action in the 'Patient' controller
        window.location.href = '@Url.Action("GetPatientList", "Patient")';
    }

      function AddEditPatientFunction(patId,visitId,visitdt,reason) {

        var par = {
            patId: patId,
            visitId: visitId,
            visitDateTime: visitdt,
            reason: reason,
            MDTType: 'Liver'

        };

        var url = '@Url.Action("AddEditPatientDetail", "Patient")' + '/?' + $.param(par);
     //   loadPage(url, "Patient");
        window.open(url, "_blank");

        }

</script>