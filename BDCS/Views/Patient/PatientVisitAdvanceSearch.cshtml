
@{
    ViewBag.Title = "PatientVisitAdvanceSearch";
    if (Request.IsAjaxRequest())
    {
        Layout = null;
    }
}

<link href="~/Content/Plugin/chosen/chosen.css" rel="stylesheet" />

<div class="admin-module">
    <div class="container-fluid">

        <div class="am-page-head">
            <div>
                <h3><i class="fa fa-filter"></i> Advance Search</h3>
                <span class="am-subtitle">Narrow the patient list down by clinical criteria</span>
            </div>
            <div>
                <button type="button" class="btn btn-am-light" onclick="loadPage('@Url.Action("GetPatientList","Patient")','Patient');"><i class="fa fa-times-circle"></i> Close</button>
                <button type="button" class="btn btn-am-light" onclick="ExportAdvanceSearchResults();"><i class="fa fa-file-excel-o"></i> Export to Excel</button>
                <button type="button" class="btn btn-am-primary" onclick="GetAdvanceSearchResults();"><i class="fa fa-search"></i> Search</button>
            </div>
        </div>

        <div class="am-card">
            <div class="am-field-grid">
                <div class="form-group">
                    <label>Visit Date From</label>
                    @Html.TextBox("FromDate", null, new { @class = "form-control datepicker", placeholder = "From Date" })
                </div>
                <div class="form-group">
                    <label>Visit Date To</label>
                    @Html.TextBox("ToDate", null, new { @class = "form-control datepicker", placeholder = "To Date" })
                </div>
                <div class="form-group">
                    <label>Child Status</label>
                    @Html.DropDownList("ChildStatus", (List<SelectListItem>)ViewBag.ChildStatusVB, "--Select--", new { @class = "form-control" })
                </div>
                <div class="form-group">
                    <label>MELD-Na Status</label>
                    @Html.DropDownList("MeldStatus", (List<SelectListItem>)ViewBag.MeldStatusVB, "--Select--", new { @class = "form-control" })
                </div>
                <div class="form-group">
                    <label>BCLC Status</label>
                    @Html.DropDownList("BCLC", (List<SelectListItem>)ViewBag.BCLCVB, "--Select--", new { @class = "form-control" })
                </div>
                <div class="form-group">
                    <label>ECOG Status</label>
                    @Html.DropDownList("ECOGStatus", (List<SelectListItem>)ViewBag.ECOGStatusVB, "--Select--", new { @class = "form-control" })
                </div>
                <div class="form-group">
                    <label>Response to Treatment</label>
                    @Html.DropDownList("TreatmentResponse", (List<SelectListItem>)ViewBag.TreatmentResponseVB, "--Select--", new { @class = "form-control" })
                </div>
                <div class="form-group hidden-print">
                    <label>Hepatitis Status</label>
                    @Html.DropDownList("HepStatus", (List<SelectListItem>)ViewBag.HepStatusVB, "--Select--", new { @class = "form-control" })
                </div>
                <div class="form-group hidden-print">
                    <label>Ascities Status</label>
                    @Html.DropDownList("AscitiesStatus", (List<SelectListItem>)ViewBag.AscitiesStatusVB, "--Select--", new { @class = "form-control" })
                </div>
                <div class="form-group hidden-print">
                    <label>SVR Status</label>
                    @Html.DropDownList("SVRStatus", (List<SelectListItem>)ViewBag.SVRStatusVB, "--Select--", new { @class = "form-control" })
                </div>

                <div class="am-field-divider">Multiple-choice criteria - pick one or more of each</div>

                <div class="am-span-2">
                    <div class="form-group">
                        <label>MDT Outcome</label>
                        @Html.ListBox("MDTOutCome", (List<SelectListItem>)ViewBag.MDTOutComeVB, new { @class = "form-control MuliDropdown", data_placeholder = "Any outcome" })
                    </div>
                </div>
                <div class="am-span-2">
                    <div class="form-group">
                        <label>Any Other Comorbidities</label>
                        @Html.ListBox("OtherComorbities", (List<SelectListItem>)ViewBag.DiagnosisVB, new { @class = "form-control MuliDropdown", data_placeholder = "Any comorbidity" })
                    </div>
                </div>
                <div class="am-span-2 hidden-print">
                    <div class="form-group" id="SiteOfAngioinvasionContainer">
                        <label>Site Of Angioinvasion</label>
                        @Html.ListBox("SiteOfAngioinvasionVB", (List<SelectListItem>)ViewBag.SiteOfAngioinvasionDropdown, new { @class = "form-control MuliDropdown", data_placeholder = "Any site" })
                    </div>
                </div>
                <div class="am-span-2" id="ExtraHepaticDiseaseContainer">
                    <div class="form-group">
                        <label>Site Of Extra Hepatic Disease History</label>
                        @Html.ListBox("SiteOfHepaticDisease", (List<SelectListItem>)ViewBag.SitesOfExtraHepaticDiseaseVB, new { @class = "form-control MuliDropdown", data_placeholder = "Any site" })
                    </div>
                </div>

                <div class="am-field-divider">Clinical flags</div>

                <div class="am-span-full">
                    <div class="am-check-flex-group">
                        <div class="am-check-inline">
                            @Html.CheckBox("LiverCirrhosis")
                            <label for="LiverCirrhosis">Liver Cirrhosis</label>
                        </div>
                        <div class="am-check-inline">
                            @Html.CheckBox("PortalHypertension")
                            <label for="PortalHypertension">Portal Hypertension</label>
                        </div>
                        <div class="am-check-inline">
                            @Html.CheckBox("Varices")
                            <label for="Varices">Varices</label>
                        </div>
                        <div class="am-check-inline">
                            @Html.CheckBox("MeetingMilan")
                            <label for="MeetingMilan">Meeting Milan</label>
                        </div>
                        <div class="am-check-inline">
                            @Html.CheckBox("UCSF")
                            <label for="UCSF">UCSF</label>
                        </div>
                        <div class="am-check-inline">
                            @Html.CheckBox("ASAN")
                            <label for="ASAN">ASAN</label>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label>Refusal Reason</label>
                    @Html.TextBox("ReasonOfRefusal", null, new { @class = "form-control", placeholder = "Reason for Resfusal", @list = "lstRefusalReason" })
                </div>
            </div>
        </div>

        <div class="container-fluid" id="AdvanceSearchResult" style="padding-left:0; padding-right:0;"></div>

    </div>
</div>

<datalist id="lstRefusalReason">
    @foreach (SelectListItem item in ViewBag.RefusalReasonVB)
            {
        <option value="@item.Text"></option>
    }
</datalist>

<script src="~/Content/Plugin/chosen/chosen.jquery.min.js"></script>

<script type="text/javascript">

    $(function () {
        InitializeDateTimePicker('.datepicker');
        $(".MuliDropdown").chosen({ width: "100%", placeholder_text_multiple: "Select one or more..." });
    });

    //a <select multiple> submits an array - '|' (not ',') joins it, since several real
    //lookup values (MDTOutCome especially) contain literal commas
    function JoinMultiSelect(id) {
        var values = $(id).val();
        return (values && values.length > 0) ? values.join('|') : '';
    }

    function BuildAdvanceSearchParams() {
        return {
            FromDate: $("#FromDate").val(),
            ToDate: $("#ToDate").val(),
            ChildStatus: $("#ChildStatus").val(),
            MeldStatus: $("#MeldStatus").val(),
            BCLCStatus: $("#BCLC").val(),
            ECOG: $("#ECOGStatus").val(),
            TreatmentResponse: $("#TreatmentResponse").val(),
            MdtOutcome: JoinMultiSelect("#MDTOutCome"),
            HepatitisStatus: $("#HepStatus").val(),
            AscitiesStatus: $("#AscitiesStatus").val(),
            Svr: $("#SVRStatus").val(),
            OtherComorbidities: JoinMultiSelect("#OtherComorbities"),
            AngioInvasion: JoinMultiSelect("#SiteOfAngioinvasionVB"),
            SiteOfHepaticDisease: JoinMultiSelect("#SiteOfHepaticDisease"),
            LiverCirrhosis: $("#LiverCirrhosis").is(":checked") ? true : false,
            PortalHypertension: $("#PortalHypertension").is(":checked") ? true : false,
            Varices: $("#Varices").is(":checked") ? true : false,
            MeetingMilan: $("#MeetingMilan").is(":checked") ? true : false,
            UCSF: $("#UCSF").is(":checked") ? true : false,
            ASAN: $("#ASAN").is(":checked") ? true : false,
            AFP: 0
        };
    }

    function GetAdvanceSearchResults() {

        var Url = '@Url.Action("PatientVisitAdvanceSearchResult", "Patient")/?' + $.param(BuildAdvanceSearchParams());

        loadPage(Url, 'AdvanceSearchResult', 'AdvanceSearchResult');

    }

    function ExportAdvanceSearchResults() {

        var Url = '@Url.Action("ExportAdvanceSearchResults", "Patient")/?' + $.param(BuildAdvanceSearchParams());

        window.open(Url, '_blank');

    }

</script>
