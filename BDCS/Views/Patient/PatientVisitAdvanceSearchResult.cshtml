@model System.Data.DataTable
@{
    ViewBag.Title = "PatientVisitAdvanceSearchResult";

    if (Request.IsAjaxRequest())
    {
        Layout = null;
    }

    //explicit columns render first, in this order, with a friendly header - PatientId/
    //VisitId/MDTType are internal keys for the Open/Print links, never shown as columns;
    //anything else left in the DataTable is a lab test name PatientBL pivoted in, and
    //renders after these using its own name as the header
    List<KeyValuePair<string, string>> FriendlyColumns = new List<KeyValuePair<string, string>>
    {
        new KeyValuePair<string, string>("HospitalNumber", "Hospital Number"),
        new KeyValuePair<string, string>("MRN", "MRN"),
        new KeyValuePair<string, string>("PatientName", "Patient Name"),
        new KeyValuePair<string, string>("VisitDate", "Visit Date"),
        new KeyValuePair<string, string>("ChildStatus", "Child Status"),
        new KeyValuePair<string, string>("SiteOfHepaticDiseaseString", "Site Of Hepatic Disease"),
        new KeyValuePair<string, string>("NumberOfLesion", "Number Of Lesion"),
        new KeyValuePair<string, string>("LargestLesionSize", "Largest Lesion Size"),
        new KeyValuePair<string, string>("TreatmentTypeString", "Treatment Type"),
        new KeyValuePair<string, string>("MDTDiscussion", "MDT Discussion"),
        new KeyValuePair<string, string>("MDTOutComeString", "MDT Outcome"),
    };

    HashSet<string> InternalColumns = new HashSet<string> { "PatientId", "VisitId", "MDTType" };
    List<string> LabColumns = Model != null
        ? Model.Columns.Cast<System.Data.DataColumn>()
            .Select(c => c.ColumnName)
            .Where(c => !InternalColumns.Contains(c) && !FriendlyColumns.Any(f => f.Key == c))
            .ToList()
        : new List<string>();
}

@if (Model != null && Model.Rows.Count > 0)
{
    <div class="am-card">
        <div class="am-toolbar" style="margin-bottom:12px;">
            <div class="am-result-count" id="ResultCountBadge" data-total="@Model.Rows.Count"><i class="fa fa-list"></i> @Model.Rows.Count result@(Model.Rows.Count == 1 ? "" : "s")</div>
            <div class="am-search" style="flex:0 1 320px; margin-left:auto;">
                <i class="fa fa-search"></i>
                <input type="text" id="QuickFilterInput" class="form-control" placeholder="Quick filter - type any MRN, name, outcome, lab value..." oninput="QuickFilterResults(this.value);" />
            </div>
        </div>
        <div class="table-responsive am-table-scroll">
            <table class="am-table am-table-patients">
                <thead>
                    <tr>
                        @foreach (KeyValuePair<string, string> col in FriendlyColumns)
                        {
                            <th>@col.Value</th>
                        }
                        @foreach (string lab in LabColumns)
                        {
                            <th>@lab</th>
                        }
                        <th>Open</th>
                        <th>Print</th>
                    </tr>
                </thead>

                <tbody id="ResultsTableBody">

                    @foreach (System.Data.DataRow row in Model.Rows)
                    {
                        int patientId = Convert.ToInt32(row["PatientId"]);
                        int visitId = Convert.ToInt32(row["VisitId"]);
                        string mdtType = row["MDTType"]?.ToString();
                        string visitDateStr = row["VisitDate"] != DBNull.Value ? Convert.ToDateTime(row["VisitDate"]).ToString("dd-MMM-yy") : "";

                        <tr class="crow">
                            @foreach (KeyValuePair<string, string> col in FriendlyColumns)
                            {
                                string cellText = col.Key == "VisitDate" ? visitDateStr : (row[col.Key] == DBNull.Value ? "" : row[col.Key].ToString());
                                <td title="@cellText">@cellText</td>
                            }
                            @foreach (string lab in LabColumns)
                            {
                                string labText = row[lab] == DBNull.Value ? "" : row[lab].ToString();
                                <td title="@labText">@labText</td>
                            }
                            <td>
                                <a href="#" onclick="AddEditPatientFunction(@patientId, @visitId, '@visitDateStr', '','@mdtType')"><i class="fa fa-folder-open"></i> Open</a>
                            </td>
                            <td>
                                <a href="@Url.Action("PatientVisitReportRdlc", "Patient", new { patId = patientId, visitId = visitId,mdtType=mdtType })" target="_blank" title="Print">
                                    <i class="fa fa-print"></i>
                                </a>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="am-card">
        <div class="am-empty">
            <i class="fa fa-search"></i>
            No matching visits found.
        </div>
    </div>
}


<script type="text/javascript">
    // Client-side filter over the rows already on the page - lets the user narrow
    // a 2000-row Advance Search result (MRN, name, any lab value, outcome text, etc.)
    // instantly without another round trip to the server. Debounced since it re-scans
    // every row on each keystroke.
    var QuickFilterTimer = null;
    function QuickFilterResults(term) {
        clearTimeout(QuickFilterTimer);
        QuickFilterTimer = setTimeout(function () { ApplyQuickFilter(term); }, 120);
    }

    function ApplyQuickFilter(term) {
        var body = document.getElementById("ResultsTableBody");
        var badge = document.getElementById("ResultCountBadge");
        if (!body || !badge) { return; }

        var rows = body.getElementsByClassName("crow");
        var needle = (term || "").trim().toLowerCase();
        var total = parseInt(badge.getAttribute("data-total"), 10) || rows.length;
        var visible = 0;

        for (var i = 0; i < rows.length; i++) {
            var row = rows[i];
            var matches = needle === "" || row.textContent.toLowerCase().indexOf(needle) !== -1;
            row.style.display = matches ? "" : "none";
            if (matches) { visible++; }
        }

        badge.innerHTML = needle === ""
            ? '<i class="fa fa-list"></i> ' + total + ' result' + (total === 1 ? "" : "s")
            : '<i class="fa fa-list"></i> ' + visible + ' of ' + total + ' result' + (total === 1 ? "" : "s");
    }

    function AddEditPatientFunction(patId,visitId,visitdt,reason,mdtType) {

        var par = {
            patId: patId,
            visitId: visitId,
            visitDateTime: visitdt,
            reason: reason,
            MDTType: mdtType
        };

        var url = '@Url.Action("AddEditPatientDetail", "Patient")' + '/?' + $.param(par);
     //   loadPage(url, "Patient");
        window.open(url, "_blank");

        }

</script>
