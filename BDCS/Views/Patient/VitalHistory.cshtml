        function PopulatePreviousTestAgainstGroupName(GroupName)
        {


            $.ajax({

                url: '@Url.Action("GetTestsAgainstGroupName", "Patient")',
                type: 'Post',
                dataType: 'Json',
                data: { groupName: GroupName},
                success: function (msg) {
                    debugger;

                    if (msg != null) {
                        for (var i = 0; i < msg.length; i++) {
                            var row = $("#sampleDataRowPreviousResult").clone();

                            $(row).removeAttr('id');
                            $(row).find('input').val('');
                            $(row).find(".TestName").val(msg[i].TestName);
                            $(row).find(".TestDate").val($("#TestGroupDate").val());
                            $("#tblPreviousResult").append(row);
                            InitializeDateTimePicker(".datepicker");
                        }
                    }
                },
                error: function () {
                    alert('an error occured');
                }
            });
        }

