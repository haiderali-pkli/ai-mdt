        function MarkDianosisAsInactive(id,tag)
        {
            $.ajax({
                url: '@Url.Action("MarkPatientDiagnosisAsInactive", "Patient")',
                type: 'Post',
                dataType: 'Json',
                data: { patientDiagnosisId: id },
                success: function (msg) {

                    ShowAlertMessage(msg.Message, msg.MessageClass);
                    debugger;
                    var PastHxText = $("#PastHxNAT").val();
                    var Diagnosis = $(tag).closest("tr").find(".DiagnosisName").val();

                    PastHxText += "\n" + Diagnosis;
                    $("#PastHxNAT").val(PastHxText);
                },
                error: function () {
                    alert('an error occured');
                }
            });
        }


