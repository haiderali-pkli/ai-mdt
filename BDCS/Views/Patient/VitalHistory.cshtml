        function AppendPreviousResultsToCic()
        {

            var Values = new Array();

            var Cic = $("#CIC").val();

            $("#tblPreviousResult .DataRowPreviousResult").each(function () {
                Values.push($(this).find(".TestDate").val() + " " + $(this).find(".TestName").val() + " " + $(this).find(".TestResult").val());
            });

            if (Values.length > 0) {
                $("#CIC").val($("#CIC").val() + "\n" + Values.join(" | "));
            }

        }

