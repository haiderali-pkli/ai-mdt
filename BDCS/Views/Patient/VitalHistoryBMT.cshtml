<script src="~/Content/Plugin/chosen/chosen.jquery.min.js"></script>
<link href="~/Content/Plugin/chosen/chosen.css" rel="stylesheet" />
<!--Script Portion-->
<script type="text/javascript">
        //This will call before pageload so the values will be filled in the array

        var SystemicResSuggestions = new Array();

        $(document).ready(function () {

            $("#panel-fullscreen").click(function (e) {
                e.preventDefault();

                var $this = $(this);

                if ($this.children('i').hasClass('glyphicon-resize-full')) {

                    $this.children('i').removeClass('glyphicon-resize-full');
                    $this.children('i').addClass('glyphicon-resize-small');
                    $("#MDTDiscussion").css('height', "500px").css("font-size", "30px");
                }
                else if ($this.children('i').hasClass('glyphicon-resize-small')) {

                    $("#MDTDiscussion").css('height', "150px").css("font-size", "14px");

                    $this.children('i').removeClass('glyphicon-resize-small');
                    $this.children('i').addClass('glyphicon-resize-full');
                }
                $(this).closest('.panel').toggleClass('panel-fullscreen');
            });
        });

        @foreach (SelectListItem li in ViewBag.sresponseVB)
        {
            <text>
                SystemicResSuggestions.push('@li.Text')
            </text>
        }

        var SystemicCVSSuggestions = new Array();
        @foreach (SelectListItem item in ViewBag.cvsVB)
        {

            <text>

                SystemicCVSSuggestions.push('@item.Text')
        </text>
        }

        var SystemicLiverSuggestions = new Array();
        @foreach (SelectListItem item in ViewBag.sliverVB)
        {
            <text>
                SystemicLiverSuggestions.push('@item.Text')
            </text>
        }

        var SpleenSuggestions = new Array();
        @foreach (SelectListItem item in ViewBag.sspleenVB)
        {
            <text>
                SpleenSuggestions.push('@item.Text')
            </text>
        }

        var PresentHistory = new Array();
        @foreach (SelectListItem item in ViewBag.PresenttHxVB)
        {
            <text>
                PresentHistory.push('@item.Text')
        </text>
        }

        var FamilyHistory = new Array();
        @foreach (SelectListItem item in ViewBag.FamilyHistoryVB)
        {
            <text>
                FamilyHistory.push('@item.Text')
        </text>
        }

        var DrugHistory = new Array();
        @foreach (SelectListItem item in ViewBag.DrugHistoryVB)
        {
            <text>
            DrugHistory.push('@item.Text')
        </text>
        }

        var SecHistory= new Array();
        @foreach (SelectListItem item in ViewBag.SecHistoryVB)
        {
            <text>
        SecHistory.push('@item.Text')
        </text>
        }

        var ComorbiditiesSuggestion = new Array();
        @foreach (SelectListItem item in ViewBag.ComorbiditiesVB)
        {
            <text>
            ComorbiditiesSuggestion.push('@item.Text')
            </text>
        }

        var TransfusionHxSuggestion = new Array();
        @foreach (SelectListItem item in ViewBag.TransfusionHxVB)
        {
            <text>
        TransfusionHxSuggestion.push('@item.Text')
        </text>
        }
        var CICSuggestion = new Array();

        @foreach (SelectListItem item in ViewBag.CICVBB)
        {
            <text>
        CICSuggestion.push('@item.Text')
        </text>
        }

        $(document).ready(function () {
            PostPageLoad();
        });
        function PostPageLoad() {

            setTimeout(LoadPageData, 100);
            //plugin added in top of patientdeail view, on clikc this will call the function body
            $("#SystemicRes").asuggest(SystemicResSuggestions, { 'cycleOnTab': false });
            $("#SystemicCVS").asuggest(SystemicCVSSuggestions, { 'cycleOnTab': false });
            $("#SystemicLiver").asuggest(SystemicLiverSuggestions, { 'cycleOnTab': false });
            $("#SystemicSpleen").asuggest(SpleenSuggestions, { 'cycleOnTab': false });
            $("#PresentHx").asuggest(PresentHistory, { 'cycleOnTab': false });
            $("#FamilyHx").asuggest(FamilyHistory, { 'cycleOnTab': false });
            $("#DrugHx").asuggest(DrugHistory, { 'cycleOnTab': false });
            $("#SecHx").asuggest(SecHistory, { 'cycleOnTab': false });
            $("#Comorbidites").asuggest(ComorbiditiesSuggestion, { 'cycleOnTab': false });
            $("#TransfusionHx").asuggest(TransfusionHxSuggestion, { 'cycleOnTab': false });
            $("#CIC").asuggest(CICSuggestion, { 'cycleOnTab': false });
            $("#PresentHx").asuggest(PresentHistory, { 'cycleOnTab': false });

            $(".MuliDropdown").chosen();
            InitializeDateTimePicker(".datepicker");

            ShowHidePtWillingForTransplant();
            ShowHidPreviousTreatmentResponse();
            ShowHideOtherDetail();
            ShowHideTransplantDiscussionDetail();
            ShowSiteOfLymphoNode();

            $("#tblDiagnosis").trigger('rowAddOrRemove');

            $('#tblDiagnosis').bind('rowAddOrRemove', function (event) {
                var rows = $("#tblDiagnosis tr.DataRowDagnosis").length;

                if (rows > 0) {
                    $('#tblDiagnosis').show();
                }
                else {
                    $('#tblDiagnosis').hide();
                }
            });

            $(document).on("change", ".DataRowLabReports input", function () {
                PopulateLabResultValue($(this).closest(".DataRowLabReports"));
            });

            $(document).on("change", "#PtWillingForTransplant", function () {
                ShowHidePtWillingForTransplant();
            });

            $(document).on("change", "#PreviousTreatment", function () {
                ShowHidPreviousTreatmentResponse();
            });

            if ($("#nextFollowupDate").val() == "01/01/0001 12:00:00 AM") {
                $("#nextFollowupDate").val("");
            }

            $(document).on("change", "#other", function () {
                ShowHideOtherDetail();
            });

            $(document).on("change", "#TransplantDiscussion", function () {
                ShowHideTransplantDiscussionDetail();
            });


            $(document).on("change", "#Lymphonodes", function () {
                ShowSiteOfLymphoNode();
            });
        }
        function addRowPreviousResult() {
            var row = $("#sampleDataRowPreviousResult").clone();

            $(row).removeAttr('id');
            $(row).find('input').val('');
            $("#tblPreviousResult").append(row);
            InitializeDateTimePicker(".datepicker");

        }
        function removeRow(tag) {
            $(tag).closest('tr').remove();
        }
        function LoadPageData() {
            var visitId = $("#visitId").val();
            var url = '@Url.Action("GetLabOrdersBMT","Patient")'+'/?visitId=' + visitId;
            loadPage(url, "LabOrders", "labOrders");
        }

    function savePatientDetailBMT() {

            var previousResult = new Array();
            var currentReports = new Array();
            var protocolDetail = new Array();
            var patientDiagnosis = new Array();

            var Valid = true;

            $("#tblPreviousResult .DataRowPreviousResult").each(function () {

                var Data = {
                    LabReportId: $(this).data("recordidprv"),
                    VisitId: $("#VisitId").val(),
                    TestName: $(this).find(".TestName").val(),
                    TestDate: $(this).find(".TestDate").val(),
                    TestResult: $(this).find(".TestResult").val(),
                    TestResultLabel: $(this).find(".TestResultLabel").val(),
                };
                previousResult.push(Data);
            });

            var OptionalTests = ["CEA", "CA19-9", "CA125", "Pivica"];

            $("#tblLabReports .DataRowLabReports").each(function () {

                if (!Valid) {
                    return;
                }
                var Data = {
                    LabReportIdBMT: $(this).data("recordid"),
                    VisitId: $("#VisitId").val(),
                    TestId: $(this).find(".TestId").val(),
                    TestDate: $(this).find(".TestDate").val(),
                    TestName: $(this).find(".TestName").val(),
                    TestResult: $(this).find(".TestResult").val(),
                    TestUnit: $(this).find(".TestUnit").val(),
                    TestResultLabel: $(this).find(".TestResultLabel").val(),
                };

                if (!OptionalTests.includes(Data.TestName) && (Data.TestName == "" || Data.TestDate == "" || Data.TestResult == "")) {
                    alert("Please fill all the fields for lab Reports");
                    Valid = false;
                    return false;
                }
                currentReports.push(Data);
            });

            $("#tblDiagnosis .DataRowDagnosis").each(function () {
                var Data = {
                    PatientDiagnosisIdBMT: $(this).data("recordidprv"),
                    VisitId: $("#VisitId").val(),
                    Diagnosis: $(this).find(".DiagnosisName").val(),
                };
                patientDiagnosis.push(Data);
            });

            var vitalHistory = {
                PatientDetailId:$("#PatientDetailId").val(),
                PatientId: $("#patientId").val(),
                VisitId: $("#VisitId").val(),
                VisitDateTime: $("#VisitDateTime").val(),
                VisitType: $("#VisitType").val(),
                DiagnosisName: $("#DiagnosisName").val(),
                DiagnosisDetails: $("#DiagnosisDetails").val(),
                CIC: $("#CIC").val(),
                Summary: $("#Summary").val(),
                OtherComorbitiesBMT: $("#OtherComorbitiesBMT").val(),
                DiseaseStatus: $("#DiseaseStatus").val(),
                HCTCI: $("#HCTCI").val(),
                Lansky: $("#Lansky").val(),
                HepBStatus: $("#HepBStatus").val(),
                HepCStatus: $("#HepCStatus").val(),
                HIVStatus: $("#HIVStatus").val(),
                ECOGStatus: $("#ECOGStatus").val(),
                Stage: $("#Stage").val(),
                RiskScore: $("#RiskScore").val(),
                Biopsy: $("#biopsyId").val(),
                PETCT: $("#PETCT").val(),
                Chelation: $("#Chelation").val(),
                Liver: $("#liverId").val(),

                Spleen: $("#spleenId").val(),
                Lymphonodes: $("#Lymphonodes").is(":checked") ? 1 : 0,
                SiteOfLymphnodes: $("#SiteOfLymphnodes").val(),
                TreatmentResponse: $("#TreatmentResponseId").val(),
                PreviousTreatment: $("#PreviousTreatment").is(":checked") ? 1 : 0,
                BMTTreatmentType: $("#BMTTreatmentType").val(),
                PtWillingForTransplant: $("#PtWillingForTransplant").is(":checked") ? 1 : 0,
                ReasonOfRefusal: $("#ReasonOfRefusal").val(),
                MDTDiscussion: $("#MDTDiscussion").val(),
                MDTOutCome: $("#MDTOutComeId").val(),
                MDTOutComeOther: $("#MDTOutComeOther").val(),
                TransplantDiscussion: $("#TransplantDiscussion").is(":checked") ? 1 : 0,
                TransplantDiscussionDetail: $("#TransplantDiscussionDetail").val(),
                MDTDate: $("#MDTDate").val(),

                labreports: currentReports,
                PatientDiagnosis: patientDiagnosis,
                PreviousTreatmentBMT: $("#PreviousTreatmentBMT").val(),
            };

            if (ValidateMandatoryFields(vitalHistory) && Valid) {

                $.ajax({

                    url: '@Url.Action("savePatientDetail1BMT", "Patient")',
                    type: 'Post',
                    dataType: 'Json',
                    data: JSON.stringify(vitalHistory),
                    contentType: 'application/Json',
                    success: function (msg) {

                        ShowAlertMessage(msg.Message, msg.MessageClass, msg.MessageTitle);

                        if (msg.IsSuccess) {
                            var Url = '@Url.Action("AddEditPatientDetail", "Patient")/?patId=' + $("#patientId").val() + "&visitId=" + $("#VisitId").val() + "&visitDateTime=" + $("#VisitDateTime").val() + "&reason=" + $("#VisitType").val() +
                                "&MDTType=BoneMarrow";

                            loadPage(Url, "Patient visit");
                        }

                    },
                    error: function () {
                        alert('an error occured');
                    }
                });
            }

        };


        function OpenModalPopup()
        {
            $("#TestGroupModal").modal('show');
        }

        function AppendPreviousResultsToCic()
        {

            var Values = new Array();

            var Cic = $("#CIC").val();

            $("#tblPreviousResult .DataRowPreviousResult").each(function () {
                Values.push($(this).find(".TestDate").val() + " " + $(this).find(".TestName").val() + " " + $(this).find(".TestResult").val());
            });

            if (Values.length > 0) {
                $("#CIC").val($("#CIC").val() + "\n" + Values.join(" | "));
            }

        }

        function PrintReport() {

            var mdtTypeValue = document.getElementById('mdtTypeId').value;
            window.open('@Url.Action("PatientVisitReportRdlc", "Patient")?patId=' + $("#patientId").val() + '&visitId=' + $("#VisitId").val() + '&mdttype=' + mdtTypeValue, "_blank");
        }

        function AddDiagnosisRow()
        {
            var row = $("#sampleDataRowDiagnosis").clone();
            $(row).removeAttr('id');
            $(row).find(".DiagnosisName").val($("#DiagnosisName").val());

            $("#tblDiagnosis").append(row).trigger('rowAddOrRemove');
        }

        function MarkDianosisAsInactive(id,tag)
        {
            $.ajax({
                url: '@Url.Action("MarkPatientDiagnosisAsInactive", "Patient")',
                type: 'Post',
                dataType: 'Json',
                data: { patientDiagnosisId: id },
                success: function (msg) {

                    ShowAlertMessage(msg.Message, msg.MessageClass);

                    var PastHxText = $("#PastHxNAT").val();
                    var Diagnosis = $(tag).closest("tr").find(".DiagnosisName").val();

                    PastHxText += "\n" + Diagnosis;
                    $("#PastHxNAT").val(PastHxText);
                },
                error: function () {
                    alert('an error occured');
                }
            });
        }

    function ShowSiteOfLymphoNode() {
        if ($("#Lymphonodes").is(":checked")) {
            $("#DivSiteOfLymphoNode").show();
        }
