@model BDCS.Model.RoleRights.Role
@{
    ViewBag.Title = "AddEditRole";
    if (Request.IsAjaxRequest())
    {
        Layout = null;
    }
    bool isEdit = Model.RoleId > 0;
    List<string> Groups = new List<string>();

    if (ViewBag.Rights != null)
    {
        Groups = (ViewBag.Rights as List<BDCS.Model.RoleRights.RoleRight>).Select(a => a.MenuGroupName).Distinct().ToList();
    }
}

<style>
    .ar-group { border: 1px solid var(--am-border); border-radius: 10px; margin-bottom: 14px; overflow: hidden; }
    .ar-group-head { display: flex; align-items: center; justify-content: space-between; padding: 14px 18px; background: var(--am-bg); cursor: pointer; text-decoration: none !important; color: var(--am-ink) !important; }
    .ar-group-head:hover { background: #eef1f6; }
    .ar-group-head h4 { margin: 0; font-size: 14px; font-weight: 600; }
    .ar-group-head i.fa-chevron-down { transition: transform .15s; color: var(--am-muted); }
    .ar-group-head[aria-expanded="false"] i.fa-chevron-down { transform: rotate(-90deg); }
    .ar-group-body { padding: 4px 18px 10px; }
    .ar-group .am-table thead th { background: #fff; }
</style>

<div class="admin-module">
    <div class="container-fluid">

        <div class="am-page-head">
            <div>
                <nav style="font-size:13px;color:var(--am-muted);margin-bottom:6px;">
                    <a href="@Url.Action("GetRoleList","Role")">Roles</a> / <span>@(isEdit ? "Edit role" : "Add role")</span>
                </nav>
                <h3><i class="fa fa-shield"></i> @(isEdit ? "Edit role" : "Add role")</h3>
                <span class="am-subtitle">Name the role, then choose what it can view, add/edit, or delete per screen.</span>
            </div>
        </div>

        <form id="RoleForm" onsubmit="return SaveRole();">
            @Html.HiddenFor(a => a.RoleId)

            <div class="am-card">
                <div class="row">
                    <div class="col-sm-4 col-xs-8">
                        <div class="form-group">
                            <label>Role name</label>
                            @Html.TextBoxFor(a => a.RoleName, new { @class = "form-control", placeholder = "e.g. Consultant", @required = "required" })
                        </div>
                    </div>
                    <div class="col-sm-3 col-xs-4">
                        <div class="form-group">
                            <label>&nbsp;</label>
                            <label class="am-switch" style="display:flex;height:34px;">
                                <input type="checkbox" id="Active" @(Model.Active || Model.RoleId == 0 ? "checked=\"checked\"" : "") />
                                <span class="am-switch-track"></span>
                                Active
                            </label>
                        </div>
                    </div>
                    <div class="col-sm-5 col-xs-12 text-right" style="align-self:flex-end;margin-bottom:15px;">
                        <button type="button" class="btn btn-am-light" onclick="window.location.href='@Url.Action("GetRoleList","Role")';">Cancel</button>
                        <button type="submit" class="btn btn-am-primary"><i class="fa fa-save"></i> Save role</button>
                    </div>
                </div>
            </div>

            <div class="am-section-title">Permissions</div>

            @foreach (string group in Groups)
            {
                <div class="ar-group">
                    <a href="#panel_@group" class="ar-group-head" data-toggle="collapse" aria-expanded="true">
                        <h4>@group</h4>
                        <i class="fa fa-chevron-down"></i>
                    </a>
                    <div id="panel_@group" class="collapse in ar-group-body">
                        <div class="table-responsive">
                            <table class="am-table" id="RoleRightsTable_@group">
                                <thead>
                                    <tr>
                                        <th>Menu</th>
                                        <th style="width:110px;">View</th>
                                        <th style="width:110px;">Add/Edit</th>
                                        <th style="width:110px;">Delete</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (BDCS.Model.RoleRights.RoleRight rr in (ViewBag.Rights as List<BDCS.Model.RoleRights.RoleRight>).Where(a => a.MenuGroupName == group))
                                    {
                                        <tr data-menuid="@rr.MenuId" class="DataRow">
                                            <td>@rr.MenuName</td>
                                            <td><input type="checkbox" class="CanView" @(rr.CanView ? "checked=\"checked\"" : "") /></td>
                                            <td><input type="checkbox" class="CanAddEdit" @(rr.CanAddEdit ? "checked=\"checked\"" : "") /></td>
                                            <td><input type="checkbox" class="CanDelete" @(rr.CanDelete ? "checked=\"checked\"" : "") /></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </form>
    </div>
</div>

<script type="text/javascript">

    $('.ar-group-head').on('click', function () {
        var $this = $(this);
        setTimeout(function () {
            $this.attr('aria-expanded', $this.next('.collapse').hasClass('in'));
        }, 10);
    });

    function SaveRole()
    {
        var Role = {
            RoleId: $("#RoleId").val(),
            RoleName: $("#RoleName").val(),
            Active: $("#Active").is(":checked") ? true : false

        };


        var Data = {
            Role: Role,
            Rights: new Array()
        }


        $(".DataRow").each(function () {
            var row = {
                MenuId: $(this).data("menuid"),
                //this is jquery command to check the checed
                CanAddEdit: $(this).find(".CanAddEdit").is(":checked") ? true : false,
                CanView :   $(this).find(".CanView").is(":checked") ? true : false,
                CanDelete :   $(this).find(".CanDelete").is(":checked") ? true : false,
            };

            if (row.CanAddEdit || row.CanView || row.CanDelete) {
                Data.Rights.push(row);
            }

        });

        $.ajax({
            //both classes role and rights have been filled and passed in the actionmethod
            url: "@Url.Action("InsertUpdateRoleRight", "Role")",
            type: "post",
            dataType: "json",
            data: JSON.stringify(Data),
            contentType: "application/json;",
            success: function(res)
            {
                ShowAlertMessage(res.Message, res.MessageClass, res.MessageTitle);
                if (res.RedirectUrl !== null && res.RedirectUrl.length > 0) {
                    if (res.DoFullRedirect == true) {
                        window.location = res.RedirectUrl;
                    }
                    else {
                        //its method to call ajax for partial view
                        setTimeout(loadPage, 1000, res.RedirectUrl, "Module");
                    }
                }
                else {
                    ShowAlertMessage("no proper response received", "error")
                }
            },
            error: function ()
            {
                ShowAlertMessage("An error occured", "error", "Error!");
            }


        });

        return false;

    }

</script>
