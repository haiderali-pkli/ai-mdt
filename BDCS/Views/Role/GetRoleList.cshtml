@model List<BDCS.Model.RoleRights.Role>
@{
    if (Request.IsAjaxRequest())
    {
        Layout = null;
    }
}

<div class="admin-module">
    <div class="container-fluid">

        @Html.Partial("_AdminNav", "Roles")

        <div class="am-page-head">
            <div>
                <h3><i class="fa fa-shield"></i> Roles</h3>
                <span class="am-subtitle">What each role can see and do &mdash; e.g. Admin, Consultant, Front Desk</span>
            </div>
            <button type="button" class="btn btn-am-primary" onclick="AddEditRole(0);">
                <i class="fa fa-plus"></i> Add Role
            </button>
        </div>

        <div class="am-card">
            <div class="am-toolbar" style="margin-bottom:16px;">
                <div class="am-search">
                    <i class="fa fa-search"></i>
                    <input type="text" id="searchByRoleName" class="form-control" placeholder="Search by role name..." value="@ViewBag.SearchTextbyRole" onkeyup="if(event.key==='Enter'){loadPageData();}" />
                </div>
                <button type="button" class="btn btn-am-light" onclick="loadPageData();"><i class="fa fa-search"></i> Search</button>
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="am-table">
                        <thead>
                            <tr>
                                <th>Role Name</th>
                                <th>Status</th>
                                <th style="width:90px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (BDCS.Model.RoleRights.Role item in Model)
                            {
                                <tr>
                                    <td><strong>@item.RoleName</strong></td>
                                    <td>
                                        @if (item.Active)
                                        {
                                            <span class="am-pill am-pill-active"><i class="fa fa-circle"></i> Active</span>
                                        }
                                        else
                                        {
                                            <span class="am-pill am-pill-inactive"><i class="fa fa-circle"></i> Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="#" title="Edit" class="am-edit-link" onclick="AddEditRole(@item.RoleId); return false;">
                                            <i class="fa fa-pencil"></i> Edit
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="am-empty">
                    <i class="fa fa-shield"></i>
                    @(ViewBag.SearchTextbyRole != null ? "No roles match your search." : "No roles configured yet.")
                </div>
            }
        </div>
    </div>
</div>

<script>
    function loadPageData() {
        var par = {
            searchText: $("#searchByRoleName").val(),
        }
        var url = '@Url.Action("GetRoleList", "Role")' + '/?' + $.param(par);
        loadPage(url,"GetRoleList")
    }

    function AddEditRole(id) {

        var url = '@Url.Action("AddEditRole", "Role")' + '/?id=' + id;
        loadPage(url, "AddEditRole");
    }
</script>
