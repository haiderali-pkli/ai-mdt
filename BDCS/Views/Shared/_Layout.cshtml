<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Basic -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <!-- Mobile Metas -->
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="viewport" content="initial-scale=1, maximum-scale=1">
    <!-- Site Metas -->
    <title>MDT</title>
    <meta name="keywords" content="">
    <meta name="description" content="">
    <meta name="author" content="">
    <!-- Site Icons -->
    <link rel="shortcut icon" href="~/Content/theme/images/pkli-favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="~/Content/theme/images/pkli-favicon.png">
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/Content/theme/css/bootstrap.min.css">
    <!-- Site CSS -->
    <link rel="stylesheet" href="style.css">
    <!-- Colors CSS -->
    <link rel="stylesheet" href="~/Content/theme/css/colors.css">
    <!-- ALL VERSION CSS -->
    <link rel="stylesheet" href="~/Content/theme/css/versions.css">
    <!-- Responsive CSS -->
    <link rel="stylesheet" href="~/Content/theme/css/responsive.css">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="~/Content/theme/css/font-awesome.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/Content/theme/css/custom.css">
    <!-- Admin Module CSS (User / Role / Clinic management) -->
    <link rel="stylesheet" href="~/Content/theme/css/admin-module.css">


    <link href="~/Content/Plugin/Jquery.toast/jquery.toast.min.css" rel="stylesheet" />

    <link href="~/Content/Plugin/Bootstrap-datepicker/css/bootstrap-datepicker.min.css" rel="stylesheet" />

    <script src="~/Content/Plugin/sweetalert2/sweetalert2.all.min.js"></script>

    <!-- Modernizer for Portfolio -->
    <script src="js/modernizer.js"></script>
    <!-- [if lt IE 9] -->
    <!-- all js files -->
    <script src="~/Content/theme/js/all.js"></script>
    <!-- all plugins -->
    <script src="~/Content/theme/js/custom.js"></script>

</head>
<body class="clinic_version">
   
     <!-- LOADER -->
    <div id="preloader">
        <img class="preloader" src="~/Content/theme/images/loaders/heart-loading2.gif" alt="">
    </div>
    <!-- END LOADER -->

    @{
        BDCS.Model.RoleRights.Users CurrentUser = Session["User"] as BDCS.Model.RoleRights.Users;
        string CurrentUserInitials = "?";
        if (CurrentUser != null && !string.IsNullOrWhiteSpace(CurrentUser.UserFullName))
        {
            string[] NameParts = CurrentUser.UserFullName.Trim().Split(' ');
            CurrentUserInitials = NameParts[0].Substring(0, 1);
            if (NameParts.Length > 1 && NameParts[NameParts.Length - 1].Length > 0)
            {
                CurrentUserInitials += NameParts[NameParts.Length - 1].Substring(0, 1);
            }
            CurrentUserInitials = CurrentUserInitials.ToUpper();
        }
    }
    <header class="hidden-print">
        <div class="mh-topbar">
            <div class="container-fluid">
                <div class="mh-topbar-inner">
                    <a class="mh-brand" href="@(CurrentUser != null ? Url.Action("GetPatientList", "Patient") : Url.Action("Login", "Home"))">
                        <img src="~/Content/theme/images/pkli-favicon.png" alt="PKLI" />
                        <span>MDT Portal</span>
                    </a>

                    <button type="button" class="mh-toggle" onclick="$('#mhNav').toggleClass('open'); return false;">
                        <i class="fa fa-bars"></i>
                    </button>

                    <nav id="mhNav" class="mh-nav">
                        @if (CurrentUser != null)
                        {
                            <div class="mh-dropdown">
                                <a href="#" onclick="return false;">Admin <span class="caret"></span></a>
                                <ul class="mh-dropdown-menu">
                                    <li><a href="@Url.Action("SearchByUserName","User")"><i class="fa fa-users"></i> Users</a></li>
                                    <li><a href="@Url.Action("GetRoleList","Role")"><i class="fa fa-shield"></i> Roles</a></li>
                                    <li><a href="@Url.Action("GetClinicList","Clinic")"><i class="fa fa-stethoscope"></i> MDT Types</a></li>
                                    <li><a href="@Url.Action("GetLocationList","Location")"><i class="fa fa-map-marker"></i> Locations</a></li>
                                    <li><a href="@Url.Action("AddEditLookupData","Patient")"><i class="fa fa-list"></i> Lookups</a></li>
                                </ul>
                            </div>
                        }
                    </nav>

                    @if (CurrentUser != null)
                    {
                        <div class="mh-dropdown mh-user">
                            <a href="#" onclick="return false;">
                                <span class="mh-user-avatar">@CurrentUserInitials</span>
                                <span class="mh-user-name">@CurrentUser.UserFullName</span>
                                <span class="caret"></span>
                            </a>
                            <ul class="mh-dropdown-menu mh-dropdown-menu-right">
                                <li><a href="#" onclick="closeForm(); return false;"><i class="fa fa-sign-out"></i> Logout</a></li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>
    </header>
    <div id="MainContent" class="parallax first-section wow fadeIn" data-stellar-background-ratio="0.4" >
        <div class="container-fluid">
           @* @Html.Action("UserMenu","Patient")*@

            @RenderBody()

        </div>
        <!-- end container -->
    </div>


    <a href="#home" data-scroll class="dmtop global-radius hidden-print"><i class="fa fa-angle-up"></i></a>


    @RenderSection("scripts", required: false)


    <script src="~/Content/Plugin/Jquery.toast/jquery.toast.min.js"></script>
    @*<script src="~/Scripts/bootstrap.min.js"></script>*@

    <script src="~/Content/Plugin/Bootstrap-datepicker/js/bootstrap-datepicker.min.js"></script>
    <script src="~/Scripts/App/Global.js"></script>




    <div class="modal fade modal-lg" tabindex="-1" modal hide" data-backdrop="static" data-keyboard="false" role="dialog" id="GenericModal" style="margin:auto; width: 75%;">
        <div class="modal-dialog modal-lg" style="width: 100%;">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h3 id="GenericModalTitle" class="modal-title" style="text-align:center">&nbsp;</h3>
                </div>
                <div class="modal-body" id="GenericModalBody">
                </div>
                <div class="modal-footer">


                </div>
            </div><!-- /.modal-content -->
        </div><!-- /.modal-dialog -->
    </div><!-- /.modal -->

</body>

</html>

<script type="text/javascript">

    function closeForm() {
        $.ajax({
            url: '@Url.Action("Logout", "Patient")',
            type: 'POST',
            dataType: 'html',
            success: function(response) {
                window.location = '@Url.Action("Login", "Home")';
            },
            error: function(xhr, status, error) {
                Swal.fire({ icon: 'error', title: 'Logout failed', text: 'An error occurred while logging out.', confirmButtonColor: '#2f6fed' });
            }
        });
    }

    // Shared SweetAlert2 confirm dialog - replaces the browser's native confirm().
    // opts: { title, text, icon, confirmButtonText } ; onConfirm runs only when the user confirms.
    function ConfirmAction(opts, onConfirm) {
        Swal.fire({
            title: opts.title || "Are you sure?",
            text: opts.text || "",
            icon: opts.icon || "warning",
            showCancelButton: true,
            confirmButtonText: opts.confirmButtonText || "Yes, continue",
            cancelButtonText: "Cancel",
            confirmButtonColor: "#2f6fed",
            cancelButtonColor: "#b8324a",
            reverseButtons: true
        }).then(function (result) {
            if (result.isConfirmed) {
                onConfirm();
            }
        });
    }

    $(document).ready(function () {
        InitializeHeartbeat();

        $(document).on("click", ".mh-dropdown > a", function (e) {
            e.preventDefault();
            e.stopPropagation();
            var isOpen = $(this).parent().hasClass("open");
            $(".mh-dropdown").removeClass("open");
            if (!isOpen) {
                $(this).parent().addClass("open");
            }
        });

        $(document).on("click", function () {
            $(".mh-dropdown").removeClass("open");
        });

    });

    function InitializeHeartbeat()
    {
        HeartbeatTimer = setInterval(Heartbeat, 60000);
    }

    function Heartbeat() {
        $.ajax({
            url: '@Url.Action("Heartbeat", "Home")',
            type: 'post',
            success: function(data)
            {
                // do nothing
            }
        });
    }


</script>

