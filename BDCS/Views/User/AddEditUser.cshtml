@model BDCS.Model.RoleRights.Users
@using System.Web.Helpers
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isEdit = Model.UserId > 0;
    List<BDCS.Model.RoleRights.Role> RoleList = ViewBag.RoleList ?? new List<BDCS.Model.RoleRights.Role>();
    List<BDCS.Model.RoleRights.Clinic> ClinicList = ViewBag.ClinicList ?? new List<BDCS.Model.RoleRights.Clinic>();
    List<BDCS.Model.RoleRights.Location> LocationList = ViewBag.LocationList ?? new List<BDCS.Model.RoleRights.Location>();
    List<int> SelectedRoleIds = Model.RoleIds ?? new List<int>();
    List<int> SelectedClinicIds = Model.ClinicIds ?? new List<int>();
    List<int> SelectedLocationIds = Model.LocationIds ?? new List<int>();
}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&amp;family=IBM+Plex+Mono:wght@500&amp;display=swap" rel="stylesheet">
<style>
    /* Scoped to .au-page only (and !important throughout) so it cannot be
       overridden by, and can never leak into, any other screen's CSS -
       this legacy theme has high-specificity global rules like
       "body.clinic_version .first-section h2 { font-size:40px }". */
    .au-page { --au-bg:#F3F6F8; --au-ink:#15232E; --au-muted:#5A6B78; --au-border:#DCE4EA; --au-border-strong:#C3CED7;
        --au-teal:#0B6E8A; --au-teal-dark:#08506A; --au-teal-tint:#F0F8FB; --au-teal-tint2:#E3F1F6; --au-teal-tint3:#D7EEF5;
        --au-green:#1F7A4D; --au-green-bg:#E9F6EF; --au-green-border:#A9D9BE; --au-green-text:#14532D;
        --au-red:#B42318; --au-red-bg:#FDF0EE; --au-red-border:#F1B8B0; --au-red-text:#8A1C12; --au-red-shadow:#FBE3DF; --au-red-soft:#E59A90;
        --au-amber:#B54708;
        background:var(--au-bg) !important; font-family:'IBM Plex Sans',-apple-system,'Segoe UI',Roboto,Arial,sans-serif !important; color:var(--au-ink) !important;
        font-size:15px !important; line-height:1.45 !important; padding:64px 24px 56px !important; box-sizing:border-box !important; max-width:1240px !important; margin:0 auto !important; float:none !important; }
    .au-page *, .au-page *::before, .au-page *::after { box-sizing:border-box !important; font-family:inherit; }
    .au-page a { color:var(--au-teal) !important; text-decoration:none; }
    .au-page a:hover { color:var(--au-teal-dark) !important; }
    .au-page input::placeholder { color:#7A8794; }
    .au-page input:focus-visible, .au-page button:focus-visible, .au-page a:focus-visible { outline:2px solid var(--au-teal); outline-offset:2px; }
    .au-page button { font-family:inherit !important; }
    .au-page h1, .au-page h2, .au-page h3, .au-page p, .au-page span, .au-page label, .au-page li { text-transform:none !important; float:none !important; }

    .au-crumb { font-size:13px !important; color:var(--au-muted) !important; display:flex !important; gap:8px; align-items:center; margin:0 0 10px !important; }
    .au-crumb a { text-decoration:none !important; }

    .au-head { display:flex !important; flex-wrap:wrap; justify-content:space-between; align-items:flex-end; gap:16px; margin:0 0 24px !important; }
    .au-head h1 { margin:0 !important; font-size:28px !important; font-weight:700 !important; letter-spacing:-0.3px !important; line-height:1.2 !important; }
    .au-head p { margin:4px 0 0 !important; color:var(--au-muted) !important; font-size:15px !important; }
    .au-head-actions { display:flex !important; gap:10px; flex-wrap:wrap; }

    .au-btn { min-height:44px !important; height:auto !important; padding:0 18px !important; border-radius:10px !important; border:1px solid var(--au-border-strong) !important; background:#FFFFFF !important; color:var(--au-ink) !important;
        font-size:15px !important; font-weight:600 !important; cursor:pointer; display:inline-flex !important; align-items:center; gap:8px; line-height:normal !important; box-shadow:none !important; }
    .au-btn:hover { background:var(--au-bg) !important; }
    .au-btn-primary { border:0 !important; background:var(--au-teal) !important; color:#FFFFFF !important; }
    .au-btn-primary:hover { background:var(--au-teal-dark) !important; color:#FFFFFF !important; }
    .au-btn-primary:disabled { background:#E3E9EE !important; color:#3B4A56 !important; cursor:not-allowed; }
    .au-btn-link { border:0 !important; background:none !important; padding:4px 0 !important; min-height:0 !important; color:var(--au-teal) !important; font-size:13px !important; font-weight:600 !important; cursor:pointer; }

    .au-banner { display:flex !important; flex-wrap:wrap; align-items:center; gap:12px 16px; padding:14px 18px !important; margin:0 0 20px !important; border-radius:12px !important; }
    .au-banner-success { background:var(--au-green-bg) !important; border:1px solid var(--au-green-border) !important; color:var(--au-green-text) !important; }
    .au-banner-error { background:var(--au-red-bg) !important; border:1px solid var(--au-red-border) !important; color:var(--au-red-text) !important; }
    .au-banner[hidden] { display:none !important; }

    .au-grid { display:flex !important; flex-wrap:wrap; gap:24px; align-items:flex-start; }
    .au-main { flex:999 1 560px; min-width:0; display:flex !important; flex-direction:column; gap:20px; }
    .au-aside { flex:1 1 300px; min-width:0; background:#FFFFFF !important; border:1px solid var(--au-border) !important; border-radius:14px !important; padding:24px !important;
        display:flex !important; flex-direction:column; gap:20px; position:sticky; top:84px; float:none !important; width:auto !important; }

    .au-card { background:#FFFFFF !important; border:1px solid var(--au-border) !important; border-radius:14px !important; padding:24px !important; float:none !important; }
    .au-card-head { display:flex !important; justify-content:space-between; align-items:flex-start; gap:16px; flex-wrap:wrap; margin:0 0 20px !important; }
    .au-card-head h2 { margin:0 !important; font-size:18px !important; font-weight:600 !important; line-height:1.3 !important; }
    .au-card-head p { margin:2px 0 0 !important; color:var(--au-muted) !important; font-size:14px !important; }

    .au-fields { display:grid !important; grid-template-columns:repeat(auto-fit, minmax(220px,1fr)); gap:18px; }
    .au-field { display:flex !important; flex-direction:column; gap:6px; }
    .au-field-full { grid-column:1 / -1; }
    .au-field label { font-size:14px !important; font-weight:600 !important; margin:0 !important; display:inline-block; }
    .au-field-row { display:flex !important; justify-content:space-between; align-items:baseline; gap:8px; }
    .au-input { width:100% !important; min-height:46px !important; height:auto !important; padding:10px 14px !important; border-radius:10px !important; font-size:15px !important; font-family:inherit !important; color:var(--au-ink) !important;
        background:#FFFFFF !important; border:1px solid var(--au-border-strong) !important; box-shadow:none !important; margin:0 !important; }
    .au-input:focus { border-color:var(--au-teal) !important; box-shadow:none !important; }
    .au-input.au-bad { border-color:var(--au-red) !important; box-shadow:0 0 0 3px var(--au-red-shadow) !important; }
    .au-err { font-size:13px !important; color:var(--au-red) !important; }

    .au-pwwrap { position:relative; }
    .au-pwwrap .au-input { padding-right:48px !important; }
    .au-pweye { position:absolute; right:4px; top:50%; transform:translateY(-50%); width:40px !important; height:40px !important; min-height:0 !important; border:0 !important; background:none !important;
        color:var(--au-muted) !important; cursor:pointer; display:flex !important; align-items:center; justify-content:center; border-radius:8px !important; padding:0 !important; }
    .au-pweye:hover { background:var(--au-bg) !important; }
    .au-pwmeter { display:flex !important; align-items:center; gap:10px; }
    .au-pwbars { display:grid !important; grid-template-columns:repeat(4, minmax(0,1fr)); gap:4px; flex:1 1 auto; }
    .au-pwbars span { height:6px !important; border-radius:3px !important; background:#E3E9EE !important; display:block; }
    .au-pwlabel { font-size:13px !important; font-weight:600 !important; min-width:64px; text-align:right; color:var(--au-muted) !important; }

    .au-switch { display:inline-flex !important; align-items:center; gap:10px; }
    .au-switch button { width:52px !important; height:30px !important; min-height:0 !important; border-radius:999px !important; border:0 !important; padding:3px !important; cursor:pointer; display:flex !important; background:#8796A3 !important; }
    .au-switch button.on { background:var(--au-green) !important; justify-content:flex-end; }
    .au-switch button span { width:24px; height:24px; border-radius:50%; background:#FFFFFF; box-shadow:0 1px 2px rgba(0,0,0,.25); display:block; }
    .au-switch-label { font-weight:600 !important; min-width:64px; color:var(--au-ink) !important; }

    .au-rolecount { font-size:13px !important; font-weight:600 !important; padding:4px 10px !important; border-radius:999px !important; background:#EEF1F4 !important; color:var(--au-muted) !important; }
    .au-rolecount.au-has { background:var(--au-teal-tint2) !important; color:var(--au-teal-dark) !important; }
    .au-roles { display:grid !important; grid-template-columns:repeat(auto-fit, minmax(230px,1fr)); gap:12px; }
    .au-role { display:flex !important; align-items:center; gap:12px; text-align:left; padding:14px !important; min-height:72px; border-radius:12px !important; cursor:pointer;
        font-family:inherit !important; border:1px solid var(--au-border) !important; background:#FFFFFF !important; margin:1px !important; width:100%; transition:border-color .15s, background .15s; }
    .au-role.on { border:2px solid var(--au-teal) !important; background:var(--au-teal-tint) !important; margin:0 !important; }
    .au-role.au-bad { border:1px solid var(--au-red-soft) !important; }
    .au-role-icon { width:40px; height:40px; border-radius:10px !important; flex:none; display:flex !important; align-items:center; justify-content:center; background:#EEF3F6 !important; color:#2D4A5A !important; }
    .au-role.on .au-role-icon { background:var(--au-teal) !important; color:#FFFFFF !important; }
    .au-role-text { display:flex !important; flex-direction:column; gap:2px; flex:1 1 auto; min-width:0; text-align:left; }
    .au-role-text strong { font-weight:600 !important; font-size:15px !important; color:var(--au-ink) !important; }
    .au-role-text span { font-size:13px !important; color:var(--au-muted) !important; }
    .au-role-check { width:22px; height:22px; border-radius:6px !important; flex:none; display:flex !important; align-items:center; justify-content:center; border:2px solid #B8C4CE; }
    .au-role.on .au-role-check { background:var(--au-teal) !important; border:0 !important; }

    .au-locs { display:flex !important; flex-wrap:wrap; gap:10px; }
    .au-loc { display:flex !important; align-items:center; gap:8px; min-height:44px; padding:0 16px !important; border-radius:999px !important; font-size:14px !important; font-weight:600 !important;
        cursor:pointer; font-family:inherit !important; border:1px solid var(--au-border-strong) !important; background:#FFFFFF !important; color:#2D3D49 !important; margin:1px !important; }
    .au-loc.on { border:2px solid var(--au-teal) !important; background:var(--au-teal) !important; color:#FFFFFF !important; margin:0 !important; }
    .au-loc.au-bad { border:1px solid var(--au-red-soft) !important; }

    .au-avatar-row { display:flex !important; align-items:center; gap:14px; }
    .au-avatar { width:52px; height:52px; border-radius:50% !important; background:var(--au-teal-tint3) !important; color:#0B3B52 !important; font-weight:700 !important; font-size:18px !important;
        display:flex !important; align-items:center; justify-content:center; flex:none; }
    .au-aside-name { font-weight:600 !important; font-size:17px !important; overflow-wrap:anywhere; color:var(--au-ink) !important; }
    .au-aside-login { font-size:13px !important; color:var(--au-muted) !important; font-family:'IBM Plex Mono',monospace !important; overflow-wrap:anywhere; }
    .au-pill { padding:4px 12px !important; border-radius:999px !important; font-size:13px !important; font-weight:600 !important; display:inline-block !important; }
    .au-pill-active { background:var(--au-green-bg) !important; color:var(--au-green-text) !important; }
    .au-pill-inactive { background:#EEF1F4 !important; color:#3B4A56 !important; }

    .au-aside-block { border-top:1px solid #E6ECF0 !important; padding-top:16px !important; }
    .au-aside-block h3 { margin:0 0 10px !important; font-size:12px !important; letter-spacing:.8px !important; text-transform:uppercase !important; color:var(--au-muted) !important; font-weight:600 !important; }
    .au-aside-block p.au-none { margin:0 !important; color:var(--au-muted) !important; font-size:14px !important; }
    .au-chiprow { display:flex !important; flex-wrap:wrap; gap:6px; }
    .au-chip-role { padding:4px 10px !important; border-radius:999px !important; background:var(--au-teal-tint2) !important; color:var(--au-teal-dark) !important; font-size:13px !important; font-weight:600 !important; }
    .au-chip-loc { padding:4px 10px !important; border-radius:999px !important; background:#EEF1F4 !important; color:#2D3D49 !important; font-size:13px !important; font-weight:600 !important; }

    .au-checks { list-style:none !important; margin:0 !important; padding:0 !important; display:flex !important; flex-direction:column; gap:8px; }
    .au-checks li { display:flex !important; align-items:center; gap:10px; font-size:14px !important; }
    .au-checkdot { width:20px; height:20px; border-radius:50% !important; flex:none; display:flex !important; align-items:center; justify-content:center; background:#FFFFFF !important; border:2px solid #B8C4CE; }
    .au-checkdot.done { background:var(--au-green) !important; border:0 !important; }
    .au-checks span.done { color:var(--au-ink) !important; }
    .au-checks span.todo { color:var(--au-muted) !important; }

    @@media (max-width: 700px) {
        .au-page { padding-top:88px !important; }
        .au-aside { position:static !important; }
    }
</style>

<div class="au-page" id="auPage" data-isedit="@(isEdit ? "1" : "0")" data-userid="@Model.UserId">

    <nav class="au-crumb" aria-label="Breadcrumb">
        <a href="@Url.Action("SearchByUserName", "User")">Users</a>
        <span aria-hidden="true">/</span>
        <span>@(isEdit ? "Edit user" : "Add user")</span>
    </nav>

    <div class="au-head">
        <div>
            <h1>@(isEdit ? "Edit user" : "Add user")</h1>
            <p>@(isEdit ? "Update this person's account, roles, MDT types and locations." : "Create an account and choose what this person can do and where.")</p>
        </div>
        <div class="au-head-actions">
            <button type="button" class="au-btn" id="auClearBtn">@(isEdit ? "Cancel" : "Clear form")</button>
            <button type="button" class="au-btn au-btn-primary" id="auSaveBtn1">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l4.5 4.5L19 7"></path></svg>
                @(isEdit ? "Save changes" : "Create user")
            </button>
        </div>
    </div>

    <div id="auSuccessBanner" class="au-banner au-banner-success" role="status" hidden>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1F7A4D" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8 12.5l2.5 2.5L16 9.5"></path></svg>
        <div style="flex:1 1 260px" id="auSuccessText"></div>
        <button type="button" class="au-btn" id="auAddAnotherBtn" style="border-color:#1F7A4D;color:#14532D;">Add another user</button>
        <a href="@Url.Action("SearchByUserName", "User")" class="au-btn" style="border-color:#1F7A4D;color:#14532D;text-decoration:none;">Back to Users</a>
    </div>

    <div id="auErrorBanner" class="au-banner au-banner-error" role="alert" hidden>
        <strong>Some details are missing.</strong>&nbsp;Complete the highlighted fields to @(isEdit ? "save this user" : "create this user").
    </div>

    <div class="au-grid">
        <div class="au-main">

            <section class="au-card" aria-labelledby="au-sec-account">
                <div class="au-card-head">
                    <div>
                        <h2 id="au-sec-account">Account details</h2>
                        <p>Used to sign in to the portal.</p>
                    </div>
                    <div class="au-switch">
                        <button type="button" role="switch" id="auActiveToggle" aria-label="Account active">
                            <span></span>
                        </button>
                        <span class="au-switch-label" id="auActiveLabel">Active</span>
                    </div>
                </div>

                <div class="au-fields">
                    <div class="au-field au-field-full">
                        <label for="auName">Full name</label>
                        <input id="auName" class="au-input" type="text" autocomplete="off" placeholder="e.g. Ayesha Khan" value="@Model.UserFullName" />
                        <span class="au-err" id="auNameErr" hidden>Enter the person's full name.</span>
                    </div>

                    <div class="au-field">
                        <div class="au-field-row">
                            <label for="auLogin">Login ID</label>
                            <button type="button" class="au-btn-link" id="auSuggestLogin">Suggest from name</button>
                        </div>
                        <input id="auLogin" class="au-input" type="text" autocomplete="off" placeholder="e.g. akhan" value="@Model.LoginId" />
                        <span class="au-err" id="auLoginErr" hidden>Login ID needs at least 3 characters, no spaces.</span>
                    </div>

                    <div class="au-field">
                        <div class="au-field-row">
                            <label for="auPw">Password</label>
                            <button type="button" class="au-btn-link" id="auGenPw">Generate</button>
                        </div>
                        <div class="au-pwwrap">
                            <input id="auPw" class="au-input" type="password" autocomplete="new-password" placeholder="@(isEdit ? "Leave blank to keep current" : "At least 8 characters")" />
                            <button type="button" class="au-pweye" id="auTogglePw" aria-label="Show password">
                                <svg id="auEyeOpen" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12s3.5-6 9-6 9 6 9 6-3.5 6-9 6-9-6-9-6z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                <svg id="auEyeClosed" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden><path d="M3 3l18 18"></path><path d="M10.6 6.1A9.8 9.8 0 0 1 12 6c5.5 0 9 6 9 6a15 15 0 0 1-2.6 3.3M6.4 7.6C4.2 9.1 3 12 3 12s3.5 6 9 6c1.6 0 3-.5 4.2-1.2"></path><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"></path></svg>
                            </button>
                        </div>
                        <div class="au-pwmeter">
                            <div class="au-pwbars" id="auPwBars">
                                <span></span><span></span><span></span><span></span>
                            </div>
                            <span class="au-pwlabel" id="auPwLabel">Not set</span>
                        </div>
                        <span class="au-err" id="auPwErr" hidden>Password must be at least 8 characters.</span>
                    </div>
                </div>
            </section>

            <section class="au-card" aria-labelledby="au-sec-roles">
                <div class="au-card-head">
                    <div>
                        <h2 id="au-sec-roles">Roles</h2>
                        <p>Pick one or more. Roles decide what the user can see and do.</p>
                    </div>
                    <span class="au-rolecount" id="auRoleCount">0 selected</span>
                </div>
                <div class="au-roles" id="auRoles"></div>
                <p class="au-err" id="auRolesErr" style="margin:12px 0 0;" hidden>Choose at least one role.</p>
            </section>

            <section class="au-card" aria-labelledby="au-sec-locs">
                <div class="au-card-head">
                    <div>
                        <h2 id="au-sec-locs">MDT Types</h2>
                        <p>Which MDT types (e.g. MDT, MDT BMT) this user can access.</p>
                    </div>
                    <button type="button" class="au-btn" id="auToggleAllLocs" style="min-height:40px;padding:0 12px;color:var(--au-teal);">Select all</button>
                </div>
                <div class="au-locs" id="auLocs"></div>
                <p class="au-err" id="auLocsErr" style="margin:12px 0 0;" hidden>Choose at least one MDT type.</p>
            </section>

            <section class="au-card" aria-labelledby="au-sec-reallocs">
                <div class="au-card-head">
                    <div>
                        <h2 id="au-sec-reallocs">Locations</h2>
                        <p>Which hospital site(s) this user works from.</p>
                    </div>
                    <button type="button" class="au-btn" id="auToggleAllRealLocs" style="min-height:40px;padding:0 12px;color:var(--au-teal);">Select all</button>
                </div>
                <div class="au-locs" id="auRealLocs"></div>
                <p class="au-err" id="auRealLocsErr" style="margin:12px 0 0;" hidden>Choose at least one location.</p>
            </section>
        </div>

        <aside class="au-aside" aria-label="Access summary">
            <div class="au-avatar-row">
                <span class="au-avatar" id="auInitials">?</span>
                <div style="min-width:0;">
                    <div class="au-aside-name" id="auDisplayName">New user</div>
                    <div class="au-aside-login" id="auDisplayLogin">No login ID yet</div>
                </div>
            </div>
            <div><span class="au-pill au-pill-active" id="auStatusPill">Active</span></div>

            <div class="au-aside-block">
                <h3>Roles</h3>
                <p class="au-none" id="auNoRoles">None selected yet</p>
                <div class="au-chiprow" id="auPickedRoles"></div>
            </div>

            <div class="au-aside-block">
                <h3>MDT Types</h3>
                <p class="au-none" id="auNoLocs">None selected yet</p>
                <div class="au-chiprow" id="auPickedLocs"></div>
            </div>

            <div class="au-aside-block">
                <h3>Locations</h3>
                <p class="au-none" id="auNoRealLocs">None selected yet</p>
                <div class="au-chiprow" id="auPickedRealLocs"></div>
            </div>

            <div class="au-aside-block">
                <h3 id="auReadyTitle">Ready to create &middot; 0 of 6</h3>
                <ul class="au-checks" id="auChecks"></ul>
            </div>

            <button type="button" class="au-btn au-btn-primary" id="auSaveBtn2" style="min-height:48px;">@(isEdit ? "Save changes" : "Create user")</button>
        </aside>
    </div>
</div>

<script type="text/javascript">
(function () {
    var ROLES = [
    @foreach (var r in RoleList)
    {
        <text>{ id: @r.RoleId, name: @Html.Raw(Json.Encode(r.RoleName)) },</text>
    }
    ];
    var LOCS = [
    @foreach (var c in ClinicList)
    {
        <text>{ id: @c.ClinicId, name: @Html.Raw(Json.Encode(c.ClinicName)) },</text>
    }
    ];
    var REALLOCS = [
    @foreach (var l in LocationList)
    {
        <text>{ id: @l.LocationId, name: @Html.Raw(Json.Encode(l.LocationName)) },</text>
    }
    ];
    var SELECTED_ROLES = [@string.Join(",", SelectedRoleIds)];
    var SELECTED_LOCS = [@string.Join(",", SelectedClinicIds)];
    var SELECTED_REALLOCS = [@string.Join(",", SelectedLocationIds)];

    var ROLE_META = {
        admin: { desc: 'Manage users, lookups and settings', icon: 'shield' },
        consultant: { desc: 'Review cases and sign off MDT decisions', icon: 'pulse' },
        front: { desc: 'Register patients and book appointments', icon: 'desk' },
        tech: { desc: 'Acquire studies and work the worklist', icon: 'monitor' }
    };
    function metaFor(name) {
        var n = (name || '').toLowerCase();
        if (n.indexOf('admin') >= 0) return ROLE_META.admin;
        if (n.indexOf('consult') >= 0) return ROLE_META.consultant;
        if (n.indexOf('front') >= 0) return ROLE_META.front;
        if (n.indexOf('tech') >= 0) return ROLE_META.tech;
        return { desc: 'Role-specific access within the portal', icon: 'user' };
    }
    var ICONS = {
        shield: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6l7-3z"></path><path d="M9 12l2 2 4-4"></path></svg>',
        pulse: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h4l2 6 4-12 2 6h6"></path></svg>',
        desk: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="16" height="17" rx="2"></rect><path d="M9 2v4M15 2v4M4 10h16M9 15h6"></path></svg>',
        monitor: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"></rect><path d="M8 20h8M12 16v4M7 10h2l1.5-3 3 6 1.5-3h2"></path></svg>',
        user: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 4-7 8-7s8 3 8 7"></path></svg>',
        check: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l4.5 4.5L19 7"></path></svg>',
        checkSm: '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l4.5 4.5L19 7"></path></svg>',
        pin: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>'
    };

    var isEdit = document.getElementById('auPage').dataset.isedit === '1';
    var userId = parseInt(document.getElementById('auPage').dataset.userid, 10) || 0;

    var state = {
        name: document.getElementById('auName').value || '',
        login: document.getElementById('auLogin').value || '',
        pw: '',
        showPw: false,
        active: true,
        roles: {},
        locs: {},
        realLocs: {},
        tried: false,
        saving: false
    };
    SELECTED_ROLES.forEach(function (id) { state.roles[id] = true; });
    SELECTED_LOCS.forEach(function (id) { state.locs[id] = true; });
    SELECTED_REALLOCS.forEach(function (id) { state.realLocs[id] = true; });

    @if (isEdit)
    {
        <text>state.active = @(Model.Active ? "true" : "false");</text>
    }

    function el(id) { return document.getElementById(id); }

    function pwScore(pw) {
        if (!pw.length) return -1;
        var score = 0;
        if (pw.length >= 8) score++;
        if (pw.length >= 12) score++;
        if (/[A-Z]/.test(pw) && /[a-z]/.test(pw)) score++;
        if (/\d/.test(pw) && /[^A-Za-z0-9]/.test(pw)) score++;
        if (pw.length < 8) score = 0;
        return score;
    }

    function render() {
        var name = state.name.trim();
        var nameOk = name.length >= 2;
        var loginOk = /^[A-Za-z0-9._-]{3,}$/.test(state.login);
        var pwOk = isEdit ? (state.pw.length === 0 || state.pw.length >= 8) : (state.pw.length >= 8);

        var pickedRoleIds = Object.keys(state.roles).filter(function (k) { return state.roles[k]; }).map(Number);
        var pickedLocIds = Object.keys(state.locs).filter(function (k) { return state.locs[k]; }).map(Number);
        var pickedRealLocIds = Object.keys(state.realLocs).filter(function (k) { return state.realLocs[k]; }).map(Number);
        var rolesOk = pickedRoleIds.length > 0;
        var locsOk = pickedLocIds.length > 0;
        var realLocsOk = pickedRealLocIds.length > 0;
        var allOk = nameOk && loginOk && pwOk && rolesOk && locsOk && realLocsOk;
        var t = state.tried;

        // ----- account fields -----
        el('auName').classList.toggle('au-bad', t && !nameOk);
        el('auNameErr').hidden = !(t && !nameOk);
        el('auLogin').classList.toggle('au-bad', t && !loginOk);
        el('auLoginErr').hidden = !(t && !loginOk);
        el('auPw').classList.toggle('au-bad', t && !pwOk);
        el('auPwErr').hidden = !(t && !pwOk);

        var score = pwScore(state.pw);
        var sCol = ['#B42318', '#B54708', '#B54708', '#0B6E8A', '#1F7A4D'];
        var sLab = ['Too short', 'Weak', 'Fair', 'Good', 'Strong'];
        var lit = score < 0 ? 0 : Math.max(score, 1);
        var col = score < 0 ? '#DCE4EA' : sCol[score];
        var bars = el('auPwBars').children;
        for (var bi = 0; bi < bars.length; bi++) {
            bars[bi].style.background = bi < lit ? col : '#E3E9EE';
        }
        el('auPwLabel').textContent = score < 0 ? (isEdit ? 'Unchanged' : 'Not set') : sLab[score];
        el('auPwLabel').style.color = score < 0 ? '#5A6B78' : sCol[score];

        // ----- active switch -----
        var toggleBtn = el('auActiveToggle');
        toggleBtn.classList.toggle('on', state.active);
        el('auActiveLabel').textContent = state.active ? 'Active' : 'Inactive';

        // ----- roles grid -----
        el('auRoles').innerHTML = ROLES.map(function (r) {
            var on = !!state.roles[r.id];
            var meta = metaFor(r.name);
            var cls = 'au-role' + (on ? ' on' : '') + ((t && !rolesOk) ? ' au-bad' : '');
            return '<button type="button" class="' + cls + '" data-role="' + r.id + '" aria-pressed="' + on + '">' +
                '<span class="au-role-icon">' + ICONS[meta.icon] + '</span>' +
                '<span class="au-role-text"><strong>' + r.name + '</strong><span>' + meta.desc + '</span></span>' +
                '<span class="au-role-check">' + (on ? ICONS.check : '') + '</span>' +
                '</button>';
        }).join('');
        el('auRoleCount').textContent = pickedRoleIds.length + ' selected';
        el('auRoleCount').classList.toggle('au-has', pickedRoleIds.length > 0);
        el('auRolesErr').hidden = !(t && !rolesOk);

        // ----- locations -----
        el('auLocs').innerHTML = LOCS.map(function (l) {
            var on = !!state.locs[l.id];
            var cls = 'au-loc' + (on ? ' on' : '') + ((t && !locsOk) ? ' au-bad' : '');
            return '<button type="button" class="' + cls + '" data-loc="' + l.id + '" aria-pressed="' + on + '">' + ICONS.pin + l.name + '</button>';
        }).join('');
        el('auToggleAllLocs').textContent = (pickedLocIds.length === LOCS.length && LOCS.length > 0) ? 'Clear all' : 'Select all';
        el('auLocsErr').hidden = !(t && !locsOk);

        // ----- real locations (hospital sites) -----
        el('auRealLocs').innerHTML = REALLOCS.map(function (l) {
            var on = !!state.realLocs[l.id];
            var cls = 'au-loc' + (on ? ' on' : '') + ((t && !realLocsOk) ? ' au-bad' : '');
            return '<button type="button" class="' + cls + '" data-realloc="' + l.id + '" aria-pressed="' + on + '">' + ICONS.pin + l.name + '</button>';
        }).join('');
        el('auToggleAllRealLocs').textContent = (pickedRealLocIds.length === REALLOCS.length && REALLOCS.length > 0) ? 'Clear all' : 'Select all';
        el('auRealLocsErr').hidden = !(t && !realLocsOk);

        // ----- sidebar summary -----
        var initials = name ? name.split(/\s+/).slice(0, 2).map(function (w) { return w.charAt(0).toUpperCase(); }).join('') : '?';
        el('auInitials').textContent = initials;
        el('auDisplayName').textContent = name || 'New user';
        el('auDisplayLogin').textContent = state.login ? '@@' + state.login : 'No login ID yet';

        var pill = el('auStatusPill');
        pill.textContent = state.active ? 'Active' : 'Inactive';
        pill.className = 'au-pill ' + (state.active ? 'au-pill-active' : 'au-pill-inactive');

        var pickedRoleNames = ROLES.filter(function (r) { return state.roles[r.id]; }).map(function (r) { return r.name; });
        el('auNoRoles').hidden = pickedRoleNames.length > 0;
        el('auPickedRoles').innerHTML = pickedRoleNames.map(function (n) { return '<span class="au-chip-role">' + n + '</span>'; }).join('');

        var pickedLocNames = LOCS.filter(function (l) { return state.locs[l.id]; }).map(function (l) { return l.name; });
        el('auNoLocs').hidden = pickedLocNames.length > 0;
        el('auPickedLocs').innerHTML = pickedLocNames.map(function (n) { return '<span class="au-chip-loc">' + n + '</span>'; }).join('');

        var pickedRealLocNames = REALLOCS.filter(function (l) { return state.realLocs[l.id]; }).map(function (l) { return l.name; });
        el('auNoRealLocs').hidden = pickedRealLocNames.length > 0;
        el('auPickedRealLocs').innerHTML = pickedRealLocNames.map(function (n) { return '<span class="au-chip-loc">' + n + '</span>'; }).join('');

        var checks = [
            { label: 'Full name', done: nameOk },
            { label: 'Login ID', done: loginOk },
            { label: isEdit ? 'Password (optional)' : 'Password (8+ characters)', done: pwOk },
            { label: 'At least one role', done: rolesOk },
            { label: 'At least one MDT type', done: locsOk },
            { label: 'At least one location', done: realLocsOk }
        ];
        var doneCount = checks.filter(function (c) { return c.done; }).length;
        el('auReadyTitle').textContent = (isEdit ? 'Ready to save' : 'Ready to create') + ' \u00B7 ' + doneCount + ' of ' + checks.length;
        el('auChecks').innerHTML = checks.map(function (c) {
            return '<li><span class="au-checkdot' + (c.done ? ' done' : '') + '">' + (c.done ? ICONS.checkSm : '') + '</span>' +
                '<span class="' + (c.done ? 'done' : 'todo') + '">' + c.label + '</span></li>';
        }).join('');

        [el('auSaveBtn1'), el('auSaveBtn2')].forEach(function (b) { b.disabled = state.saving; });

        return { allOk: allOk, pickedRoleIds: pickedRoleIds, pickedLocIds: pickedLocIds, pickedRealLocIds: pickedRealLocIds, name: name };
    }

    function set(patch) {
        Object.assign(state, patch);
        el('auSuccessBanner').hidden = true;
        render();
    }

    // ----- field events -----
    el('auName').addEventListener('input', function (e) { set({ name: e.target.value }); });
    el('auLogin').addEventListener('input', function (e) { set({ login: e.target.value.replace(/\s/g, '') }); });
    el('auPw').addEventListener('input', function (e) { set({ pw: e.target.value }); });

    el('auSuggestLogin').addEventListener('click', function () {
        var parts = state.name.toLowerCase().replace(/[^a-z\s]/g, '').split(/\s+/).filter(Boolean);
        if (!parts.length) return;
        var v = parts.length > 1 ? parts[0].charAt(0) + parts[parts.length - 1] : parts[0];
        el('auLogin').value = v;
        set({ login: v });
    });

    el('auGenPw').addEventListener('click', function () {
        var chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789!@@#$%';
        var out = '';
        for (var i = 0; i < 11; i++) out += chars.charAt(Math.floor(Math.random() * chars.length));
        out += 'A7#';
        el('auPw').value = out;
        el('auPw').type = 'text';
        set({ pw: out, showPw: true });
    });

    el('auTogglePw').addEventListener('click', function () {
        var show = !state.showPw;
        el('auPw').type = show ? 'text' : 'password';
        el('auEyeOpen').hidden = show;
        el('auEyeClosed').hidden = !show;
        el('auTogglePw').setAttribute('aria-label', show ? 'Hide password' : 'Show password');
        state.showPw = show;
    });

    el('auActiveToggle').addEventListener('click', function () { set({ active: !state.active }); });

    el('auRoles').addEventListener('click', function (e) {
        var btn = e.target.closest('[data-role]');
        if (!btn) return;
        var id = btn.getAttribute('data-role');
        var n = Object.assign({}, state.roles);
        n[id] = !n[id];
        set({ roles: n });
    });

    el('auLocs').addEventListener('click', function (e) {
        var btn = e.target.closest('[data-loc]');
        if (!btn) return;
        var id = btn.getAttribute('data-loc');
        var n = Object.assign({}, state.locs);
        n[id] = !n[id];
        set({ locs: n });
    });

    el('auToggleAllLocs').addEventListener('click', function () {
        var pickedCount = Object.keys(state.locs).filter(function (k) { return state.locs[k]; }).length;
        var allOn = pickedCount === LOCS.length && LOCS.length > 0;
        var n = {};
        if (!allOn) LOCS.forEach(function (l) { n[l.id] = true; });
        set({ locs: n });
    });

    el('auRealLocs').addEventListener('click', function (e) {
        var btn = e.target.closest('[data-realloc]');
        if (!btn) return;
        var id = btn.getAttribute('data-realloc');
        var n = Object.assign({}, state.realLocs);
        n[id] = !n[id];
        set({ realLocs: n });
    });

    el('auToggleAllRealLocs').addEventListener('click', function () {
        var pickedCount = Object.keys(state.realLocs).filter(function (k) { return state.realLocs[k]; }).length;
        var allOn = pickedCount === REALLOCS.length && REALLOCS.length > 0;
        var n = {};
        if (!allOn) REALLOCS.forEach(function (l) { n[l.id] = true; });
        set({ realLocs: n });
    });

    el('auClearBtn').addEventListener('click', function () {
        if (isEdit) {
            window.location.href = '@Url.Action("SearchByUserName", "User")';
            return;
        }
        el('auName').value = '';
        el('auLogin').value = '';
        el('auPw').value = '';
        el('auPw').type = 'password';
        el('auEyeOpen').hidden = false;
        el('auEyeClosed').hidden = true;
        state = { name: '', login: '', pw: '', showPw: false, active: true, roles: {}, locs: {}, realLocs: {}, tried: false, saving: false };
        render();
    });

    function doSave() {
        var r = render();
        if (!r.allOk) {
            state.tried = true;
            render();
            el('auErrorBanner').hidden = false;
            el('auErrorBanner').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            return;
        }
        el('auErrorBanner').hidden = true;
        set({ saving: true });

        var payload = {
            user: {
                UserId: userId,
                UserFullName: r.name,
                LoginId: state.login,
                Password: state.pw,
                Active: state.active
            },
            RoleIds: r.pickedRoleIds,
            ClinicIds: r.pickedLocIds,
            LocationIds: r.pickedRealLocIds
        };

        $.ajax({
            url: '@Url.Action("InsertUpdateUser", "User")',
            type: 'post',
            dataType: 'json',
            data: JSON.stringify(payload),
            contentType: 'application/json;',
            success: function (res) {
                set({ saving: false });
                if (res.IsSuccess) {
                    if (isEdit) {
                        ShowAlertMessage(res.Message, res.MessageClass, res.MessageTitle);
                        window.location.href = '@Url.Action("SearchByUserName", "User")';
                    } else {
                        el('auSuccessText').innerHTML = '<strong>' + r.name + '</strong> was created. They can sign in as <span style="font-family:\'IBM Plex Mono\',monospace">' + state.login + '</span>.';
                        el('auSuccessBanner').hidden = false;
                        el('auSuccessBanner').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                        el('auName').value = ''; el('auLogin').value = ''; el('auPw').value = '';
                        state = { name: '', login: '', pw: '', showPw: false, active: true, roles: {}, locs: {}, realLocs: {}, tried: false, saving: false };
                        render();
                    }
                } else {
                    ShowAlertMessage(res.Message, res.MessageClass || 'warning', res.MessageTitle);
                }
            },
            error: function () {
                set({ saving: false });
                ShowAlertMessage('An error occured', 'error', 'Error!');
            }
        });
    }

    el('auSaveBtn1').addEventListener('click', doSave);
    el('auSaveBtn2').addEventListener('click', doSave);
    el('auAddAnotherBtn').addEventListener('click', function () {
        el('auSuccessBanner').hidden = true;
        el('auName').focus();
    });

    render();
})();
</script>
