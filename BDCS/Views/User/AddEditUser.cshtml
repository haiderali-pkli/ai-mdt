@model BDCS.Model.RoleRights.Users
@using System.Web.Helpers
@{
    ViewBag.Title = "AddEditUser";
    if (Request.IsAjaxRequest())
    {
        Layout = null;
    }
    bool IsNewUser = Model.UserId == 0;
    List<BDCS.Model.RoleRights.Role> RoleList = (ViewBag.RoleList as List<BDCS.Model.RoleRights.Role>) ?? new List<BDCS.Model.RoleRights.Role>();
    List<BDCS.Model.RoleRights.Clinic> ClinicList = (ViewBag.ClinicList as List<BDCS.Model.RoleRights.Clinic>) ?? new List<BDCS.Model.RoleRights.Clinic>();
    List<BDCS.Model.RoleRights.Location> LocationList = (ViewBag.LocationList as List<BDCS.Model.RoleRights.Location>) ?? new List<BDCS.Model.RoleRights.Location>();

    Func<string, string> roleIcon = name =>
    {
        switch ((name ?? "").Trim().ToLower())
        {
            case "admin": return "fa-shield";
            case "consultant": return "fa-user-md";
            case "front desk": return "fa-calendar-check-o";
            case "technologist": return "fa-desktop";
            default: return "fa-user-circle-o";
        }
    };
    Func<string, string> roleDesc = name =>
    {
        switch ((name ?? "").Trim().ToLower())
        {
            case "admin": return "Manage users, lookups and settings";
            case "consultant": return "Review cases and sign off MDT decisions";
            case "front desk": return "Register patients and book appointments";
            case "technologist": return "Acquire studies and work the worklist";
            default: return "Role-specific permissions";
        }
    };
}

<div class="admin-module">
    <div class="container-fluid">

        <div class="am-page-head">
            <div>
                <h3><i class="fa fa-user-md"></i> @(IsNewUser ? "Add user" : "Edit user")</h3>
                <span class="am-subtitle">Create an account and choose what this person can do and where.</span>
            </div>
            <div>
                <button type="button" class="btn btn-am-light" onclick="ClearUserForm();">Clear form</button>
                <button type="submit" form="UserForm" class="btn btn-am-primary" id="SubmitUserBtn">
                    <i class="fa fa-check"></i> @(IsNewUser ? "Create user" : "Save changes")
                </button>
            </div>
        </div>

        <form id="UserForm" onsubmit="return SaveUser();">
            @Html.HiddenFor(a => a.UserId)

            <div class="am-form-grid">
                <div class="am-form-main">

                    <div class="am-rolecard">
                        <div class="am-rolecard-body">
                            <div class="am-rolecard-head-row" style="margin-bottom:14px;">
                                <div>
                                    <div class="am-rolecard-title">Account details</div>
                                    <span class="am-subtitle">Used to sign in to the portal.</span>
                                </div>
                                <label class="am-switch">
                                    <input type="checkbox" id="Active" data-original-active="@(Model.Active ? "true" : "false")" @(Model.Active || IsNewUser ? "checked=\"checked\"" : "") onchange="UpdateUserPreview();" />
                                    <span class="am-switch-track"></span>
                                    Active
                                </label>
                            </div>

                            <div class="row">
                                <div class="col-sm-12">
                                    <div class="form-group">
                                        <label>Full name<span class="am-required">*</span></label>
                                        @Html.TextBoxFor(a => a.UserFullName, new { @class = "form-control", placeholder = "e.g. Ayesha Khan", @required = "required", onkeyup = "UpdateUserPreview();", onchange = "UpdateUserPreview();" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        <div style="display:flex; justify-content:space-between; align-items:baseline;">
                                            <label style="margin-bottom:0;">Login ID<span class="am-required">*</span></label>
                                            <span class="am-field-action" onclick="SuggestLoginId();">Suggest from name</span>
                                        </div>
                                        @Html.TextBoxFor(a => a.LoginId, new { @class = "form-control", placeholder = "e.g. akhan", @required = "required", autocomplete = "off", onkeyup = "UpdateUserPreview();", onchange = "UpdateUserPreview();" })
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        <div style="display:flex; justify-content:space-between; align-items:baseline;">
                                            <label style="margin-bottom:0;">
                                                Password @(IsNewUser ? Html.Raw("<span class=\"am-required\">*</span>") : Html.Raw("<span class=\"am-subtitle\" style=\"font-weight:400;\">(leave blank to keep current)</span>"))
                                            </label>
                                            <span class="am-field-action" onclick="GeneratePassword();">Generate</span>
                                        </div>
                                        <div style="position:relative;">
                                            @Html.PasswordFor(a => a.Password, new { @class = "form-control", placeholder = "At least 8 characters", autocomplete = "new-password", style = "padding-right:38px;", onkeyup = "UpdateUserPreview();", onchange = "UpdateUserPreview();" })
                                            <i class="fa fa-eye" id="TogglePasswordIcon" onclick="TogglePassword();" style="position:absolute; right:12px; top:9px; cursor:pointer; color:#9aa6b8;"></i>
                                        </div>
                                        <div class="am-strength-bar" id="PasswordStrengthBar">
                                            <span class="am-strength-seg"></span><span class="am-strength-seg"></span><span class="am-strength-seg"></span><span class="am-strength-seg"></span>
                                        </div>
                                        <span class="am-strength-label" id="PasswordStrengthLabel">Not set</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="am-rolecard">
                        <div class="am-rolecard-body">
                            <div class="am-rolecard-head-row" style="margin-bottom:4px;">
                                <div>
                                    <div class="am-rolecard-title">Roles<span class="am-required">*</span></div>
                                    <span class="am-subtitle">Pick one or more. Roles decide what the user can see and do.</span>
                                </div>
                                <span class="am-badge-count" id="RoleCountBadge">0 selected</span>
                            </div>
                            <div style="height:10px;"></div>
                            @if (RoleList.Any())
                            {
                                <div class="am-role-grid">
                                    @foreach (BDCS.Model.RoleRights.Role role in RoleList)
                                    {
                                        bool isChecked = Model.RoleIds != null && Model.RoleIds.Contains(role.RoleId);
                                        <label class="am-role-option @(isChecked ? "checked" : "")" for="role_@role.RoleId">
                                            <span class="am-role-option-icon"><i class="fa @roleIcon(role.RoleName)"></i></span>
                                            <span>
                                                <span class="am-role-option-title">@role.RoleName</span>
                                                <span class="am-role-option-desc">@roleDesc(role.RoleName)</span>
                                            </span>
                                            <input type="checkbox" name="RoleIds" value="@role.RoleId" id="role_@role.RoleId" class="UserRoleCheck" @(isChecked ? "checked=\"checked\"" : "") onchange="OnRoleOptionChange(this); UpdateUserPreview();" />
                                        </label>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="am-empty"><i class="fa fa-shield"></i> No roles configured yet.</div>
                            }
                            <div class="am-err" id="RoleErr" hidden style="color:var(--am-danger); font-size:12px; margin-top:10px;">
                                <i class="fa fa-exclamation-circle"></i> Select at least one role.
                            </div>
                        </div>
                    </div>

                    <div class="am-rolecard">
                        <div class="am-rolecard-body">
                            <div class="am-rolecard-head-row" style="margin-bottom:14px;">
                                <div>
                                    <div class="am-rolecard-title">MDT Types</div>
                                    <span class="am-subtitle">Optional &mdash; the multi-disciplinary team group(s) this user works with.</span>
                                </div>
                                <button type="button" class="btn btn-am-light" onclick="ToggleSelectAll('.UserClinicCheck', this);">Select all</button>
                            </div>
                            @if (ClinicList.Any())
                            {
                                <div class="am-check-grid">
                                    @foreach (BDCS.Model.RoleRights.Clinic clinic in ClinicList)
                                    {
                                        bool isChecked = Model.ClinicIds != null && Model.ClinicIds.Contains(clinic.ClinicId);
                                        <div class="am-check-pill">
                                            <input type="checkbox" name="ClinicIds" value="@clinic.ClinicId" id="clinic_@clinic.ClinicId" class="UserClinicCheck" @(isChecked ? "checked=\"checked\"" : "") onchange="UpdateUserPreview();" />
                                            <label for="clinic_@clinic.ClinicId"><i class="fa fa-stethoscope"></i> @clinic.ClinicName</label>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="am-empty"><i class="fa fa-stethoscope"></i> No MDT types configured yet.</div>
                            }
                        </div>
                    </div>

                    <div class="am-rolecard">
                        <div class="am-rolecard-body">
                            <div class="am-rolecard-head-row" style="margin-bottom:14px;">
                                <div>
                                    <div class="am-rolecard-title">Locations</div>
                                    <span class="am-subtitle">Optional &mdash; where this user can work and see patients.</span>
                                </div>
                                <button type="button" class="btn btn-am-light" onclick="ToggleSelectAll('.UserLocationCheck', this);">Select all</button>
                            </div>
                            @if (LocationList.Any())
                            {
                                <div class="am-check-grid">
                                    @foreach (BDCS.Model.RoleRights.Location location in LocationList)
                                    {
                                        bool isChecked = Model.LocationIds != null && Model.LocationIds.Contains(location.LocationId);
                                        <div class="am-check-pill">
                                            <input type="checkbox" name="LocationIds" value="@location.LocationId" id="location_@location.LocationId" class="UserLocationCheck" @(isChecked ? "checked=\"checked\"" : "") onchange="UpdateUserPreview();" />
                                            <label for="location_@location.LocationId"><i class="fa fa-map-marker"></i> @location.LocationName</label>
                                        </div>
                                    }
                                </div>
                                <div class="am-subtitle" style="margin-top:12px;">Leave every location unchecked to let this user see patients at every location.</div>
                            }
                            else
                            {
                                <div class="am-empty"><i class="fa fa-map-marker"></i> No locations configured yet.</div>
                            }
                        </div>
                    </div>

                </div>

                <div class="am-form-side">
                    <div class="am-rolecard">
                        <div class="am-rolecard-body">
                            <div style="display:flex; align-items:center; gap:12px;">
                                <span class="am-preview-avatar" id="PreviewAvatar">?</span>
                                <span>
                                    <span class="am-preview-name" id="PreviewName">@(IsNewUser ? "New user" : Model.UserFullName)</span>
                                    <span class="am-preview-sub" id="PreviewLoginId">@(string.IsNullOrEmpty(Model.LoginId) ? "No login ID yet" : "@" + Model.LoginId)</span>
                                </span>
                            </div>

                            <div style="margin-top:14px;">
                                <span class="am-pill am-pill-active" id="PreviewActivePill"><i class="fa fa-circle"></i> Active</span>
                            </div>

                            <div class="am-preview-section-label">Roles</div>
                            <div class="am-preview-value am-preview-empty" id="PreviewRoles">None selected yet</div>

                            <div class="am-preview-section-label">MDT Types</div>
                            <div class="am-preview-value am-preview-empty" id="PreviewClinics">None selected yet</div>

                            <div class="am-preview-section-label">Locations</div>
                            <div class="am-preview-value am-preview-empty" id="PreviewLocations">All locations</div>

                            <div class="am-preview-section-label" id="ReadyLabel">@(IsNewUser ? "READY TO CREATE" : "READY TO SAVE") &middot; 0 OF @(IsNewUser ? 4 : 3)</div>
                            <ul class="am-checklist" id="ReadyChecklist">
                                <li data-check="fullname"><i class="fa fa-circle-o"></i> Full name</li>
                                <li data-check="loginid"><i class="fa fa-circle-o"></i> Login ID</li>
                                <li data-check="password" data-required="@(IsNewUser ? "true" : "false")"><i class="fa fa-circle-o"></i> Password (8+ characters)</li>
                                <li data-check="role"><i class="fa fa-circle-o"></i> At least one role</li>
                            </ul>

                            <button type="submit" form="UserForm" class="btn btn-am-primary" id="SidePreviewSubmit" style="width:100%; margin-top:14px;" disabled="disabled">
                                @(IsNewUser ? "Create user" : "Save changes")
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<script type="text/javascript">

    var ReadyLabelPrefix = "@(IsNewUser ? "READY TO CREATE" : "READY TO SAVE")";

    function TogglePassword() {
        var field = document.getElementById("Password");
        var icon = document.getElementById("TogglePasswordIcon");
        if (field.type === "password") {
            field.type = "text";
            icon.className = "fa fa-eye-slash";
        } else {
            field.type = "password";
            icon.className = "fa fa-eye";
        }
    }

    function OnRoleOptionChange(checkbox) {
        $(checkbox).closest(".am-role-option").toggleClass("checked", checkbox.checked);
    }

    function ToggleSelectAll(selector, btn) {
        var boxes = $(selector);
        var allChecked = boxes.length > 0 && boxes.filter(":not(:checked)").length === 0;
        boxes.prop("checked", !allChecked).trigger("change");
        $(btn).text(allChecked ? "Select all" : "Clear all");
    }

    function SuggestLoginId() {
        var name = $.trim($("#UserFullName").val());
        if (!name) {
            ShowAlertMessage("Enter a full name first", "warning", "Missing data");
            return;
        }
        var parts = name.toLowerCase().replace(/[^a-z\s]/g, "").split(/\s+/).filter(function (p) { return p.length > 0; });
        var suggestion = "";
        if (parts.length === 1) {
            suggestion = parts[0];
        } else if (parts.length > 1) {
            suggestion = parts[0].substring(0, 1) + parts[parts.length - 1];
        }
        $("#LoginId").val(suggestion);
        UpdateUserPreview();
    }

    function GeneratePassword() {
        var chars = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789";
        var special = "!@@#$%";
        var pwd = "";
        for (var i = 0; i < 9; i++) {
            pwd += chars.charAt(Math.floor(Math.random() * chars.length));
        }
        pwd += special.charAt(Math.floor(Math.random() * special.length));

        var field = document.getElementById("Password");
        field.value = pwd;
        field.type = "text";
        document.getElementById("TogglePasswordIcon").className = "fa fa-eye-slash";
        UpdateUserPreview();
    }

    function ScorePassword(pwd) {
        if (!pwd) return 0;
        var score = 0;
        if (pwd.length >= 8) score++;
        if (pwd.length >= 12) score++;
        if (/[0-9]/.test(pwd) && /[a-zA-Z]/.test(pwd)) score++;
        if (/[a-z]/.test(pwd) && /[A-Z]/.test(pwd) && /[^a-zA-Z0-9]/.test(pwd)) score++;
        return Math.min(score, 4);
    }

    function UpdatePasswordStrength() {
        var pwd = $("#Password").val();
        var score = ScorePassword(pwd);
        var bar = $("#PasswordStrengthBar");
        bar.removeClass("s1 s2 s3 s4");
        var label = "Not set";
        if (pwd) {
            if (score <= 1) { bar.addClass("s1"); label = "Weak"; }
            else if (score === 2) { bar.addClass("s2"); label = "Fair"; }
            else if (score === 3) { bar.addClass("s3"); label = "Good"; }
            else { bar.addClass("s4"); label = "Strong"; }
        }
        $("#PasswordStrengthLabel").text(label);
        return pwd.length >= 8;
    }

    function initials(name) {
        if (!name) return "?";
        var parts = $.trim(name).split(/\s+/);
        var result = parts[0].substring(0, 1);
        if (parts.length > 1) result += parts[parts.length - 1].substring(0, 1);
        return result.toUpperCase();
    }

    function SetChecklistItem(selector, met) {
        var li = $(selector);
        li.toggleClass("am-met", met);
        li.find("i").attr("class", met ? "fa fa-check-circle" : "fa fa-circle-o");
        return met;
    }

    function UpdateUserPreview() {
        var fullName = $.trim($("#UserFullName").val());
        var loginId = $.trim($("#LoginId").val());
        var isActive = $("#Active").is(":checked");
        var roleNames = $(".UserRoleCheck:checked").map(function () { return $(this).closest(".am-role-option").find(".am-role-option-title").text(); }).get();
        var clinicNames = $(".UserClinicCheck:checked").map(function () { return $(this).closest(".am-check-pill").find("label").text().trim(); }).get();
        var locationNames = $(".UserLocationCheck:checked").map(function () { return $(this).closest(".am-check-pill").find("label").text().trim(); }).get();

        var avatar = $("#PreviewAvatar");
        avatar.text(initials(fullName));
        avatar.toggleClass("am-has-name", fullName.length > 0);

        $("#PreviewName").text(fullName || "New user");
        $("#PreviewLoginId").text(loginId ? ("@@" + loginId) : "No login ID yet");

        $("#PreviewActivePill").attr("class", isActive ? "am-pill am-pill-active" : "am-pill am-pill-inactive")
            .html('<i class="fa fa-circle"></i> ' + (isActive ? "Active" : "Inactive"));

        var rolesEl = $("#PreviewRoles");
        if (roleNames.length) { rolesEl.text(roleNames.join(", ")).removeClass("am-preview-empty"); }
        else { rolesEl.text("None selected yet").addClass("am-preview-empty"); }

        var clinicsEl = $("#PreviewClinics");
        if (clinicNames.length) { clinicsEl.text(clinicNames.join(", ")).removeClass("am-preview-empty"); }
        else { clinicsEl.text("None selected yet").addClass("am-preview-empty"); }

        var locationsEl = $("#PreviewLocations");
        if (locationNames.length) { locationsEl.text(locationNames.join(", ")).removeClass("am-preview-empty"); }
        else { locationsEl.text("All locations").addClass("am-preview-empty"); }

        $("#RoleCountBadge").text(roleNames.length + " selected").toggleClass("am-badge-count-active", roleNames.length > 0);

        var passwordOk = UpdatePasswordStrength();
        var passwordRequired = $("#ReadyChecklist li[data-check='password']").data("required") === true || $("#ReadyChecklist li[data-check='password']").data("required") === "true";

        var metFullName = SetChecklistItem("#ReadyChecklist li[data-check='fullname']", fullName.length > 0);
        var metLoginId = SetChecklistItem("#ReadyChecklist li[data-check='loginid']", loginId.length > 0);
        var metPassword = SetChecklistItem("#ReadyChecklist li[data-check='password']", !passwordRequired || passwordOk);
        var metRole = SetChecklistItem("#ReadyChecklist li[data-check='role']", roleNames.length > 0);

        var totalChecks = 3 + (passwordRequired ? 1 : 0);
        var metCount = (metFullName ? 1 : 0) + (metLoginId ? 1 : 0) + (passwordRequired ? (metPassword ? 1 : 0) : 0) + (metRole ? 1 : 0);
        var allReady = metFullName && metLoginId && metPassword && metRole;

        $("#ReadyLabel").text(ReadyLabelPrefix + " " + String.fromCharCode(183) + " " + metCount + " OF " + totalChecks);
        $("#SidePreviewSubmit").prop("disabled", !allReady);
    }

    function ClearUserForm() {
        $("#UserFullName").val("");
        $("#LoginId").val("");
        $("#Password").val("");
        $(".UserRoleCheck, .UserClinicCheck, .UserLocationCheck").prop("checked", false).each(function () { OnRoleOptionChange(this); });
        $("#Active").prop("checked", true);
        UpdateUserPreview();
    }

    function SaveUser() {
        var roleCount = $("input[name='RoleIds']:checked").length;
        $("#RoleErr").prop("hidden", roleCount > 0);
        if (roleCount === 0) {
            ShowAlertMessage("Select at least one role", "warning", "Missing data");
            return false;
        }

        var wasActive = $("#Active").data("original-active") === true || $("#Active").data("original-active") === "true";
        var isActiveNow = $("#Active").is(":checked");
        if (wasActive && !isActiveNow) {
            ConfirmAction({
                title: "Deactivate this user?",
                text: "This will deactivate this user and sign them out of future sessions.",
                confirmButtonText: "Yes, deactivate"
            }, function () { SubmitUserSave(isActiveNow); });
        } else {
            SubmitUserSave(isActiveNow);
        }

        return false;
    }

    function SubmitUserSave(isActiveNow) {
        $.ajax({
            url: '@Url.Action("InsertUpdateUser", "User")',
            type: "post",
            data: $("#UserForm").serialize() + "&Active=" + isActiveNow,
            success: function (res) {
                ShowAlertMessage(res.Message, res.MessageClass, res.MessageTitle);
                if (res.IsSuccess) {
                    if (res.DoFullRedirect) {
                        window.location = res.RedirectUrl;
                    } else {
                        loadPage(res.RedirectUrl, "Module");
                    }
                }
            },
            error: function () {
                ShowAlertMessage("An error occured", "error", "Error!");
            }
        });
    }

    $(function () {
        UpdateUserPreview();
    });

</script>
