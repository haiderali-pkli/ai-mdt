@model BDCS.Model.RoleRights.Users
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isEdit = Model.UserId > 0;
    List<BDCS.Model.RoleRights.Role> RoleList = ViewBag.RoleList ?? new List<BDCS.Model.RoleRights.Role>();
    List<BDCS.Model.RoleRights.Clinic> ClinicList = ViewBag.ClinicList ?? new List<BDCS.Model.RoleRights.Clinic>();
    List<BDCS.Model.RoleRights.Location> LocationList = ViewBag.LocationList ?? new List<BDCS.Model.RoleRights.Location>();
    List<int> SelectedRoleIds = Model.RoleIds ?? new List<int>();
    List<int> SelectedClinicIds = Model.ClinicIds ?? new List<int>();
    List<int> SelectedLocationIds = Model.LocationIds ?? new List<int>();
}

<div class="admin-module">
    <div class="container-fluid" id="auPage" data-isedit="@(isEdit ? "1" : "0")" data-userid="@Model.UserId">

        <nav class="am-crumb" aria-label="Breadcrumb">
            <a href="@Url.Action("SearchByUserName", "User")">Users</a> / <span>@(isEdit ? "Edit user" : "Add user")</span>
        </nav>

        <div class="am-page-head">
            <div>
                <h3><i class="fa fa-user"></i> @(isEdit ? "Edit user" : "Add user")</h3>
                <span class="am-subtitle">@(isEdit ? "Update this person's account, roles, MDT types and locations." : "Create an account and choose what this person can do and where.")</span>
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;">
                <button type="button" class="btn btn-am-light" id="auClearBtn">@(isEdit ? "Cancel" : "Clear form")</button>
                <button type="button" class="btn btn-am-primary" id="auSaveBtn1">
                    <i class="fa fa-check"></i> @(isEdit ? "Save changes" : "Create user")
                </button>
            </div>
        </div>

        <div id="auSuccessBanner" class="am-banner am-banner-success" role="status" hidden>
            <i class="fa fa-check-circle"></i>
            <div style="flex:1 1 260px" id="auSuccessText"></div>
            <button type="button" class="btn btn-am-light" id="auAddAnotherBtn">Add another user</button>
            <a href="@Url.Action("SearchByUserName", "User")" class="btn btn-am-light">Back to Users</a>
        </div>

        <div id="auErrorBanner" class="am-banner am-banner-error" role="alert" hidden>
            <i class="fa fa-exclamation-circle"></i>
            <span><strong>Some details are missing.</strong> Complete the highlighted fields to @(isEdit ? "save this user" : "create this user").</span>
        </div>

        <div class="am-grid">
            <div class="am-main">

                <section class="am-card" aria-labelledby="au-sec-account">
                    <div class="am-card-head">
                        <div>
                            <h4 id="au-sec-account">Account details</h4>
                            <p>Used to sign in to the portal.</p>
                        </div>
                        <label class="am-switch" style="cursor:pointer;">
                            <input type="checkbox" id="auActiveToggle" />
                            <span class="am-switch-track"></span>
                            <span id="auActiveLabel" style="font-weight:600;font-size:13px;">Active</span>
                        </label>
                    </div>

                    <div class="am-fields">
                        <div class="form-group am-field-full">
                            <label for="auName">Full name</label>
                            <input id="auName" class="form-control" type="text" autocomplete="off" placeholder="e.g. Ayesha Khan" value="@Model.UserFullName" />
                            <span class="am-err" id="auNameErr" hidden>Enter the person's full name.</span>
                        </div>

                        <div class="form-group">
                            <div class="am-field-row">
                                <label for="auLogin">Login ID</label>
                                <button type="button" class="am-edit-link" id="auSuggestLogin" style="background:none;border:0;padding:0;font-size:12px;cursor:pointer;">Suggest from name</button>
                            </div>
                            <input id="auLogin" class="form-control" type="text" autocomplete="off" placeholder="e.g. akhan" value="@Model.LoginId" />
                            <span class="am-err" id="auLoginErr" hidden>Login ID needs at least 3 characters, no spaces.</span>
                        </div>

                        <div class="form-group">
                            <div class="am-field-row">
                                <label for="auPw">Password</label>
                                <button type="button" class="am-edit-link" id="auGenPw" style="background:none;border:0;padding:0;font-size:12px;cursor:pointer;">Generate</button>
                            </div>
                            <div class="am-pwwrap">
                                <input id="auPw" class="form-control" type="password" autocomplete="new-password" placeholder="@(isEdit ? "Leave blank to keep current" : "At least 8 characters")" />
                                <button type="button" class="am-pweye" id="auTogglePw" aria-label="Show password">
                                    <i class="fa fa-eye" id="auEyeOpen"></i>
                                    <i class="fa fa-eye-slash" id="auEyeClosed" hidden></i>
                                </button>
                            </div>
                            <div class="am-pwmeter">
                                <div class="am-pwbars" id="auPwBars">
                                    <span></span><span></span><span></span><span></span>
                                </div>
                                <span class="am-pwlabel" id="auPwLabel">Not set</span>
                            </div>
                            <span class="am-err" id="auPwErr" hidden>Password must be at least 8 characters.</span>
                        </div>
                    </div>
                </section>

                <section class="am-card" aria-labelledby="au-sec-roles">
                    <div class="am-card-head">
                        <div>
                            <h4 id="au-sec-roles">Roles</h4>
                            <p>Pick one or more. Roles decide what the user can see and do.</p>
                        </div>
                        <span class="am-badge" id="auRoleCount">0 selected</span>
                    </div>
                    <div class="am-rolegrid" id="auRoles"></div>
                    <span class="am-err" id="auRolesErr" style="margin-top:10px;display:block;" hidden>Choose at least one role.</span>
                </section>

                <section class="am-card" aria-labelledby="au-sec-locs">
                    <div class="am-card-head">
                        <div>
                            <h4 id="au-sec-locs">MDT Types</h4>
                            <p>Which MDT types (e.g. MDT, MDT BMT) this user can access.</p>
                        </div>
                        <button type="button" class="btn btn-am-light" id="auToggleAllLocs">Select all</button>
                    </div>
                    <div class="am-check-grid" id="auLocs"></div>
                    <span class="am-err" id="auLocsErr" style="margin-top:10px;display:block;" hidden>Choose at least one MDT type.</span>
                </section>

                <section class="am-card" aria-labelledby="au-sec-reallocs">
                    <div class="am-card-head">
                        <div>
                            <h4 id="au-sec-reallocs">Locations</h4>
                            <p>Which hospital site(s) this user works from.</p>
                        </div>
                        <button type="button" class="btn btn-am-light" id="auToggleAllRealLocs">Select all</button>
                    </div>
                    <div class="am-check-grid" id="auRealLocs"></div>
                    <span class="am-err" id="auRealLocsErr" style="margin-top:10px;display:block;" hidden>Choose at least one location.</span>
                </section>
            </div>

            <aside class="am-card am-aside-panel" aria-label="Access summary">
                <div class="am-aside-block" style="display:flex;align-items:center;gap:14px;">
                    <span class="am-avatar am-avatar-lg" id="auInitials">?</span>
                    <div style="min-width:0;">
                        <div style="font-weight:600;font-size:16px;overflow-wrap:anywhere;" id="auDisplayName">New user</div>
                        <div style="font-size:12px;color:var(--am-muted);overflow-wrap:anywhere;" id="auDisplayLogin">No login ID yet</div>
                        <div style="margin-top:6px;"><span class="am-pill am-pill-active" id="auStatusPill"><i class="fa fa-circle"></i> Active</span></div>
                    </div>
                </div>

                <div class="am-aside-block">
                    <div class="am-section-title" style="margin-bottom:8px;">Roles</div>
                    <p style="color:var(--am-muted);font-size:13px;margin:0;" id="auNoRoles">None selected yet</p>
                    <div class="am-chiprow" id="auPickedRoles"></div>
                </div>

                <div class="am-aside-block">
                    <div class="am-section-title" style="margin-bottom:8px;">MDT Types</div>
                    <p style="color:var(--am-muted);font-size:13px;margin:0;" id="auNoLocs">None selected yet</p>
                    <div class="am-chiprow" id="auPickedLocs"></div>
                </div>

                <div class="am-aside-block">
                    <div class="am-section-title" style="margin-bottom:8px;">Locations</div>
                    <p style="color:var(--am-muted);font-size:13px;margin:0;" id="auNoRealLocs">None selected yet</p>
                    <div class="am-chiprow" id="auPickedRealLocs"></div>
                </div>

                <div class="am-aside-block">
                    <div class="am-section-title" id="auReadyTitle" style="margin-bottom:10px;">Ready to create &middot; 0 of 6</div>
                    <ul class="am-checks" id="auChecks"></ul>
                    <button type="button" class="btn btn-am-primary" id="auSaveBtn2" style="width:100%;margin-top:16px;">
                        <i class="fa fa-check"></i> @(isEdit ? "Save changes" : "Create user")
                    </button>
                </div>
            </aside>
        </div>
    </div>
</div>

<script type="text/javascript">
(function () {
    var ROLES = [
    @foreach (var r in RoleList)
    {
        <text>{ id: @r.RoleId, name: @Html.Raw(Json.Encode(r.RoleName)) },</text>
    }
    ];
    var LOCS = [
    @foreach (var c in ClinicList)
    {
        <text>{ id: @c.ClinicId, name: @Html.Raw(Json.Encode(c.ClinicName)) },</text>
    }
    ];
    var REALLOCS = [
    @foreach (var l in LocationList)
    {
        <text>{ id: @l.LocationId, name: @Html.Raw(Json.Encode(l.LocationName)) },</text>
    }
    ];
    var SELECTED_ROLES = [@string.Join(",", SelectedRoleIds)];
    var SELECTED_LOCS = [@string.Join(",", SelectedClinicIds)];
    var SELECTED_REALLOCS = [@string.Join(",", SelectedLocationIds)];

    var ROLE_META = {
        admin: { desc: 'Manage users, lookups and settings', icon: 'fa-shield' },
        consultant: { desc: 'Review cases and sign off MDT decisions', icon: 'fa-user-md' },
        front: { desc: 'Register patients and book appointments', icon: 'fa-calendar-check-o' },
        tech: { desc: 'Acquire studies and work the worklist', icon: 'fa-desktop' }
    };
    function metaFor(name) {
        var n = (name || '').toLowerCase();
        if (n.indexOf('admin') >= 0) return ROLE_META.admin;
        if (n.indexOf('consult') >= 0) return ROLE_META.consultant;
        if (n.indexOf('front') >= 0) return ROLE_META.front;
        if (n.indexOf('tech') >= 0) return ROLE_META.tech;
        return { desc: 'Role-specific access within the portal', icon: 'fa-user' };
    }

    var isEdit = document.getElementById('auPage').dataset.isedit === '1';
    var userId = parseInt(document.getElementById('auPage').dataset.userid, 10) || 0;

    var state = {
        name: document.getElementById('auName').value || '',
        login: document.getElementById('auLogin').value || '',
        pw: '',
        showPw: false,
        active: true,
        roles: {},
        locs: {},
        realLocs: {},
        tried: false,
        saving: false
    };
    SELECTED_ROLES.forEach(function (id) { state.roles[id] = true; });
    SELECTED_LOCS.forEach(function (id) { state.locs[id] = true; });
    SELECTED_REALLOCS.forEach(function (id) { state.realLocs[id] = true; });

    @if (isEdit)
    {
        <text>state.active = @(Model.Active ? "true" : "false");</text>
    }

    function el(id) { return document.getElementById(id); }

    function pwScore(pw) {
        if (!pw.length) return -1;
        var score = 0;
        if (pw.length >= 8) score++;
        if (pw.length >= 12) score++;
        if (/[A-Z]/.test(pw) && /[a-z]/.test(pw)) score++;
        if (/\d/.test(pw) && /[^A-Za-z0-9]/.test(pw)) score++;
        if (pw.length < 8) score = 0;
        return score;
    }

    function renderPicker(containerId, items, picked, badFlag, dataAttr) {
        el(containerId).innerHTML = items.map(function (it) {
            var on = !!picked[it.id];
            var cls = 'am-check-pill' + (badFlag ? ' am-bad' : '');
            var cbId = containerId + '-' + it.id;
            return '<div class="' + cls + '"><input type="checkbox" id="' + cbId + '" data-' + dataAttr + '="' + it.id + '"' + (on ? ' checked' : '') + '>' +
                '<label for="' + cbId + '"><i class="fa fa-check"></i>' + it.name + '</label></div>';
        }).join('');
    }

    function render() {
        var name = state.name.trim();
        var nameOk = name.length >= 2;
        var loginOk = /^[A-Za-z0-9._-]{3,}$/.test(state.login);
        var pwOk = isEdit ? (state.pw.length === 0 || state.pw.length >= 8) : (state.pw.length >= 8);

        var pickedRoleIds = Object.keys(state.roles).filter(function (k) { return state.roles[k]; }).map(Number);
        var pickedLocIds = Object.keys(state.locs).filter(function (k) { return state.locs[k]; }).map(Number);
        var pickedRealLocIds = Object.keys(state.realLocs).filter(function (k) { return state.realLocs[k]; }).map(Number);
        var rolesOk = pickedRoleIds.length > 0;
        var locsOk = pickedLocIds.length > 0;
        var realLocsOk = pickedRealLocIds.length > 0;
        var allOk = nameOk && loginOk && pwOk && rolesOk && locsOk && realLocsOk;
        var t = state.tried;

        // ----- account fields -----
        el('auName').classList.toggle('am-bad', t && !nameOk);
        el('auNameErr').hidden = !(t && !nameOk);
        el('auLogin').classList.toggle('am-bad', t && !loginOk);
        el('auLoginErr').hidden = !(t && !loginOk);
        el('auPw').classList.toggle('am-bad', t && !pwOk);
        el('auPwErr').hidden = !(t && !pwOk);

        var score = pwScore(state.pw);
        var sCol = ['#b42318', '#b54708', '#b54708', '#2f6fed', '#0f7a51'];
        var sLab = ['Too short', 'Weak', 'Fair', 'Good', 'Strong'];
        var lit = score < 0 ? 0 : Math.max(score, 1);
        var col = score < 0 ? '#e3e8f0' : sCol[score];
        var bars = el('auPwBars').children;
        for (var bi = 0; bi < bars.length; bi++) {
            bars[bi].style.background = bi < lit ? col : '#e3e8f0';
        }
        el('auPwLabel').textContent = score < 0 ? (isEdit ? 'Unchanged' : 'Not set') : sLab[score];
        el('auPwLabel').style.color = score < 0 ? '#475569' : sCol[score];

        // ----- active switch -----
        el('auActiveToggle').checked = state.active;
        el('auActiveLabel').textContent = state.active ? 'Active' : 'Inactive';

        // ----- roles grid -----
        el('auRoles').innerHTML = ROLES.map(function (r) {
            var on = !!state.roles[r.id];
            var meta = metaFor(r.name);
            var cls = 'am-rolecard' + (on ? ' on' : '') + ((t && !rolesOk) ? ' am-bad' : '');
            return '<button type="button" class="' + cls + '" data-role="' + r.id + '" aria-pressed="' + on + '">' +
                '<span class="am-rolecard-icon"><i class="fa ' + meta.icon + '"></i></span>' +
                '<span class="am-rolecard-text"><strong>' + r.name + '</strong><span>' + meta.desc + '</span></span>' +
                '<span class="am-rolecard-check">' + (on ? '<i class="fa fa-check"></i>' : '') + '</span>' +
                '</button>';
        }).join('');
        el('auRoleCount').textContent = pickedRoleIds.length + ' selected';
        el('auRolesErr').hidden = !(t && !rolesOk);

        // ----- MDT types -----
        renderPicker('auLocs', LOCS, state.locs, t && !locsOk, 'loc');
        el('auToggleAllLocs').textContent = (pickedLocIds.length === LOCS.length && LOCS.length > 0) ? 'Clear all' : 'Select all';
        el('auLocsErr').hidden = !(t && !locsOk);

        // ----- locations (hospital sites) -----
        renderPicker('auRealLocs', REALLOCS, state.realLocs, t && !realLocsOk, 'realloc');
        el('auToggleAllRealLocs').textContent = (pickedRealLocIds.length === REALLOCS.length && REALLOCS.length > 0) ? 'Clear all' : 'Select all';
        el('auRealLocsErr').hidden = !(t && !realLocsOk);

        // ----- sidebar summary -----
        var initials = name ? name.split(/\s+/).slice(0, 2).map(function (w) { return w.charAt(0).toUpperCase(); }).join('') : '?';
        el('auInitials').textContent = initials;
        el('auDisplayName').textContent = name || 'New user';
        el('auDisplayLogin').textContent = state.login ? '@@' + state.login : 'No login ID yet';

        var pill = el('auStatusPill');
        pill.innerHTML = '<i class="fa fa-circle"></i> ' + (state.active ? 'Active' : 'Inactive');
        pill.className = 'am-pill ' + (state.active ? 'am-pill-active' : 'am-pill-inactive');

        var pickedRoleNames = ROLES.filter(function (r) { return state.roles[r.id]; }).map(function (r) { return r.name; });
        el('auNoRoles').hidden = pickedRoleNames.length > 0;
        el('auPickedRoles').innerHTML = pickedRoleNames.map(function (n) { return '<span class="am-badge">' + n + '</span>'; }).join('');

        var pickedLocNames = LOCS.filter(function (l) { return state.locs[l.id]; }).map(function (l) { return l.name; });
        el('auNoLocs').hidden = pickedLocNames.length > 0;
        el('auPickedLocs').innerHTML = pickedLocNames.map(function (n) { return '<span class="am-badge">' + n + '</span>'; }).join('');

        var pickedRealLocNames = REALLOCS.filter(function (l) { return state.realLocs[l.id]; }).map(function (l) { return l.name; });
        el('auNoRealLocs').hidden = pickedRealLocNames.length > 0;
        el('auPickedRealLocs').innerHTML = pickedRealLocNames.map(function (n) { return '<span class="am-badge am-badge-location"><i class="fa fa-map-marker"></i> ' + n + '</span>'; }).join('');

        var checks = [
            { label: 'Full name', done: nameOk },
            { label: 'Login ID', done: loginOk },
            { label: isEdit ? 'Password (optional)' : 'Password (8+ characters)', done: pwOk },
            { label: 'At least one role', done: rolesOk },
            { label: 'At least one MDT type', done: locsOk },
            { label: 'At least one location', done: realLocsOk }
        ];
        var doneCount = checks.filter(function (c) { return c.done; }).length;
        var dotChar = String.fromCharCode(183);
        el('auReadyTitle').textContent = (isEdit ? 'Ready to save' : 'Ready to create') + ' ' + dotChar + ' ' + doneCount + ' of ' + checks.length;
        el('auChecks').innerHTML = checks.map(function (c) {
            return '<li><span class="am-checkdot' + (c.done ? ' done' : '') + '">' + (c.done ? '<i class="fa fa-check"></i>' : '') + '</span>' +
                '<span class="' + (c.done ? 'done' : 'todo') + '">' + c.label + '</span></li>';
        }).join('');

        [el('auSaveBtn1'), el('auSaveBtn2')].forEach(function (b) { b.disabled = state.saving; });

        return { allOk: allOk, pickedRoleIds: pickedRoleIds, pickedLocIds: pickedLocIds, pickedRealLocIds: pickedRealLocIds, name: name };
    }

    function set(patch) {
        Object.assign(state, patch);
        el('auSuccessBanner').hidden = true;
        render();
    }

    // ----- field events -----
    el('auName').addEventListener('input', function (e) { set({ name: e.target.value }); });
    el('auLogin').addEventListener('input', function (e) { set({ login: e.target.value.replace(/\s/g, '') }); });
    el('auPw').addEventListener('input', function (e) { set({ pw: e.target.value }); });

    el('auSuggestLogin').addEventListener('click', function () {
        var parts = state.name.toLowerCase().replace(/[^a-z\s]/g, '').split(/\s+/).filter(Boolean);
        if (!parts.length) return;
        var v = parts.length > 1 ? parts[0].charAt(0) + parts[parts.length - 1] : parts[0];
        el('auLogin').value = v;
        set({ login: v });
    });

    el('auGenPw').addEventListener('click', function () {
        var chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789!@@#$%';
        var out = '';
        for (var i = 0; i < 11; i++) out += chars.charAt(Math.floor(Math.random() * chars.length));
        out += 'A7#';
        el('auPw').value = out;
        el('auPw').type = 'text';
        set({ pw: out, showPw: true });
    });

    el('auTogglePw').addEventListener('click', function () {
        var show = !state.showPw;
        el('auPw').type = show ? 'text' : 'password';
        el('auEyeOpen').hidden = show;
        el('auEyeClosed').hidden = !show;
        el('auTogglePw').setAttribute('aria-label', show ? 'Hide password' : 'Show password');
        state.showPw = show;
    });

    el('auActiveToggle').addEventListener('change', function (e) { set({ active: e.target.checked }); });

    el('auRoles').addEventListener('click', function (e) {
        var btn = e.target.closest('[data-role]');
        if (!btn) return;
        var id = btn.getAttribute('data-role');
        var n = Object.assign({}, state.roles);
        n[id] = !n[id];
        set({ roles: n });
    });

    el('auLocs').addEventListener('change', function (e) {
        var cb = e.target.closest('[data-loc]');
        if (!cb) return;
        var id = cb.getAttribute('data-loc');
        var n = Object.assign({}, state.locs);
        n[id] = cb.checked;
        set({ locs: n });
    });

    el('auToggleAllLocs').addEventListener('click', function () {
        var pickedCount = Object.keys(state.locs).filter(function (k) { return state.locs[k]; }).length;
        var allOn = pickedCount === LOCS.length && LOCS.length > 0;
        var n = {};
        if (!allOn) LOCS.forEach(function (l) { n[l.id] = true; });
        set({ locs: n });
    });

    el('auRealLocs').addEventListener('change', function (e) {
        var cb = e.target.closest('[data-realloc]');
        if (!cb) return;
        var id = cb.getAttribute('data-realloc');
        var n = Object.assign({}, state.realLocs);
        n[id] = cb.checked;
        set({ realLocs: n });
    });

    el('auToggleAllRealLocs').addEventListener('click', function () {
        var pickedCount = Object.keys(state.realLocs).filter(function (k) { return state.realLocs[k]; }).length;
        var allOn = pickedCount === REALLOCS.length && REALLOCS.length > 0;
        var n = {};
        if (!allOn) REALLOCS.forEach(function (l) { n[l.id] = true; });
        set({ realLocs: n });
    });

    el('auClearBtn').addEventListener('click', function () {
        if (isEdit) {
            window.location.href = '@Url.Action("SearchByUserName", "User")';
            return;
        }
        el('auName').value = '';
        el('auLogin').value = '';
        el('auPw').value = '';
        el('auPw').type = 'password';
        el('auEyeOpen').hidden = false;
        el('auEyeClosed').hidden = true;
        state = { name: '', login: '', pw: '', showPw: false, active: true, roles: {}, locs: {}, realLocs: {}, tried: false, saving: false };
        render();
    });

    function doSave() {
        var r = render();
        if (!r.allOk) {
            state.tried = true;
            render();
            el('auErrorBanner').hidden = false;
            el('auErrorBanner').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            return;
        }
        el('auErrorBanner').hidden = true;
        set({ saving: true });

        var payload = {
            user: {
                UserId: userId,
                UserFullName: r.name,
                LoginId: state.login,
                Password: state.pw,
                Active: state.active
            },
            RoleIds: r.pickedRoleIds,
            ClinicIds: r.pickedLocIds,
            LocationIds: r.pickedRealLocIds
        };

        $.ajax({
            url: '@Url.Action("InsertUpdateUser", "User")',
            type: 'post',
            dataType: 'json',
            data: JSON.stringify(payload),
            contentType: 'application/json;',
            success: function (res) {
                set({ saving: false });
                if (res.IsSuccess) {
                    if (isEdit) {
                        ShowAlertMessage(res.Message, res.MessageClass, res.MessageTitle);
                        window.location.href = '@Url.Action("SearchByUserName", "User")';
                    } else {
                        el('auSuccessText').innerHTML = '<strong>' + r.name + '</strong> was created. They can sign in as <strong>' + state.login + '</strong>.';
                        el('auSuccessBanner').hidden = false;
                        el('auSuccessBanner').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                        el('auName').value = ''; el('auLogin').value = ''; el('auPw').value = '';
                        state = { name: '', login: '', pw: '', showPw: false, active: true, roles: {}, locs: {}, realLocs: {}, tried: false, saving: false };
                        render();
                    }
                } else {
                    ShowAlertMessage(res.Message, res.MessageClass || 'warning', res.MessageTitle);
                }
            },
            error: function () {
                set({ saving: false });
                ShowAlertMessage('An error occurred', 'error', 'Error!');
            }
        });
    }

    el('auSaveBtn1').addEventListener('click', doSave);
    el('auSaveBtn2').addEventListener('click', doSave);
    el('auAddAnotherBtn').addEventListener('click', function () {
        el('auSuccessBanner').hidden = true;
        el('auName').focus();
    });

    render();
})();
</script>
