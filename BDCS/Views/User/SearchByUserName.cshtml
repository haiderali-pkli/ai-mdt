@using BDCS.Model.RoleRights
@using BDCS.Model.Misc
@{
    if (Request.IsAjaxRequest())
    {
        Layout = null;
    }
    List<Users> UserList = ViewBag.GetUserList ?? new List<Users>();
    Dictionary<int, List<Role>> RolesByUser = ViewBag.RolesByUser ?? new Dictionary<int, List<Role>>();
    Dictionary<int, List<KeyAndValuePair>> ClinicsByUser = ViewBag.ClinicsByUser ?? new Dictionary<int, List<KeyAndValuePair>>();
    Dictionary<int, List<KeyAndValuePair>> LocationsByUser = ViewBag.LocationsByUser ?? new Dictionary<int, List<KeyAndValuePair>>();

    Func<string, string> initials = name =>
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        string[] parts = name.Trim().Split(' ');
        string result = parts[0].Substring(0, 1);
        if (parts.Length > 1) result += parts[parts.Length - 1].Substring(0, 1);
        return result.ToUpper();
    };
}

<div class="admin-module">
    <div class="container-fluid">

        @Html.Partial("_AdminNav")

        <div class="am-page-head">
            <div>
                <h3><i class="fa fa-users"></i> Users</h3>
                <span class="am-subtitle">Staff accounts, roles and the location(s) each one can access</span>
            </div>
            <button type="button" class="btn btn-am-primary" onclick="AddEditUser(0);">
                <i class="fa fa-plus"></i> Add User
            </button>
        </div>

        <div class="am-card">
            <div class="am-toolbar" style="margin-bottom:16px;">
                <div class="am-search">
                    <i class="fa fa-search"></i>
                    <input type="text" id="SearchTextByUserName" class="form-control" placeholder="Search by user name..." value="@ViewBag.SearchTextByUser" onkeyup="if(event.key==='Enter'){SearchByUserName();}" />
                </div>
                <button type="button" class="btn btn-am-light" onclick="SearchByUserName();"><i class="fa fa-search"></i> Search</button>
            </div>

            @if (UserList != null && UserList.Any())
            {
                <div class="table-responsive">
                    <table class="am-table">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Roles</th>
                                <th>MDT Types</th>
                                <th>Locations</th>
                                <th>Status</th>
                                <th style="width:90px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (Users item in UserList)
                            {
                                <tr>
                                    <td>
                                        <div class="am-user-cell">
                                            <span class="am-avatar">@initials(item.UserFullName)</span>
                                            <span>
                                                <span class="am-user-name">@item.UserFullName</span>
                                                <span class="am-user-login">@@@item.LoginId</span>
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (RolesByUser.ContainsKey(item.UserId) && RolesByUser[item.UserId].Any())
                                        {
                                            foreach (Role r in RolesByUser[item.UserId])
                                            {
                                                <span class="am-badge">@r.RoleName</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="am-badge am-badge-muted">No role</span>
                                        }
                                    </td>
                                    <td>
                                        @if (ClinicsByUser.ContainsKey(item.UserId) && ClinicsByUser[item.UserId].Any())
                                        {
                                            foreach (KeyAndValuePair c in ClinicsByUser[item.UserId])
                                            {
                                                <span class="am-badge"><i class="fa fa-stethoscope"></i> @c.Value</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="am-badge am-badge-muted">No MDT type</span>
                                        }
                                    </td>
                                    <td>
                                        @if (LocationsByUser.ContainsKey(item.UserId) && LocationsByUser[item.UserId].Any())
                                        {
                                            foreach (KeyAndValuePair l in LocationsByUser[item.UserId])
                                            {
                                                <span class="am-badge am-badge-location"><i class="fa fa-map-marker"></i> @l.Value</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="am-badge am-badge-muted">No location</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.Active)
                                        {
                                            <span class="am-pill am-pill-active"><i class="fa fa-circle"></i> Active</span>
                                        }
                                        else
                                        {
                                            <span class="am-pill am-pill-inactive"><i class="fa fa-circle"></i> Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="#" title="Edit" onclick="AddEditUser(@item.UserId); return false;">
                                            <i class="fa fa-pencil"></i> Edit
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="am-empty">
                    <i class="fa fa-users"></i>
                    @(ViewBag.SearchTextByUser != null ? "No users match your search." : "Search by name above, or add a new user.")
                </div>
            }
        </div>
    </div>
</div>

<script type="text/javascript">

    function SearchByUserName() {
        var par = {
            searchByUserName: $("#SearchTextByUserName").val(),
        }
        var url = '@Url.Action("SearchByUserName", "User")' + '/?' + $.param(par);
        loadPage(url, "UserSearch");
    }

    function AddEditUser(userId) {
        window.location.href = '@Url.Action("AddEditUser", "User")' + '/?UserId=' + userId;
    }

</script>
