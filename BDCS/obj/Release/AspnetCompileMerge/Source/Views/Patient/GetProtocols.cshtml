@model List<BDCS.Model.VitalHistory.Protocols>
@{
    if (Request.IsAjaxRequest())
    {
        Layout = null;
    }
}
<link href="~/Content/Plugin/jquery-ui-1.12.1/jquery-ui.css" rel="stylesheet" />
<script src="~/Content/Plugin/jquery-ui-1.12.1/jquery-ui.min.js"></script>


@*<link href="~/Content/Plugins/jquery-ui-1.12.1/jquery-ui.min.css" rel="stylesheet" />
<script src="~/Content/Plugins/jquery-ui-1.12.1/jquery-ui.min.js"></script>*@

<div class="row">
    <div class="col-lg-12">
        <div class="form-group">
            <input type="text" id="SearchMedicine" class="form-control" placeholder="Search by Medicine Name or Favorite" style="margin-top:15px" />
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="form-group">
            <input type="text" id="SearchProtocol" class="form-control" placeholder="Search by Protocol Name" style="margin-top:15px" />
        </div>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <table id="tblProtocols" class="table table-bordered table-responsive">
            <thead>
                <tr style="background-color: #57b7fd; color: white;">
                    @*<th>Protocol Id</th>*@
                    <th>Protocol Name</th>
                    <th>Medicine Type</th>
                    <th>Medicine</th>
                    <th>Dose</th>
                    <th>Dose Unit</th>
                 
                    <th>Route</th>
                    <th>Frequency</th>
                    <th>Duration</th>
                    <th>Action</th>
                    
                    <th><span class="glyphicon glyphicon-plus-sign" onclick="addRowProtocol();"></span>
                        <span class="glyphicon" onclick="ClearProtocolTable();">C</span>
                    </th>

                </tr>
            </thead>
            <tbody>
           
                @foreach (BDCS.Model.VitalHistory.Protocols item in Model)
                {
                   
                    <tr class="DataRowProtocol" data-protocoldetailid="@item.ProtocolDetailId">
                        <td class="hidden">@Html.TextBoxFor(a=>item.ProtocolId,new { @class="form-control ProtocolId" })</td>
                        <td>@Html.TextBoxFor(a => item.ProtocoName, new { @class = "form-control ProtocoName", @list = "dlProtocoName" })</td>
                        <td>@Html.TextBoxFor(a => item.MedicineType, new { @class = "form-control MedicineType",@list= "dlMedicineType" })</td>
                        <td>@Html.TextBoxFor(a => item.Medicine, new { @class = "form-control Medicine" })</td>
                        <td>@Html.TextBoxFor(a => item.Dose, new { @class = "form-control Dose" })</td>
                        <td>@Html.TextBoxFor(a => item.DoseUnit, new { @class = "form-control DoseUnit",@list="dlDoseUnit" })</td>
                       
                        <td>@Html.TextBoxFor(a => item.Route, new { @class = "form-control Route", @list = "dlRoute" })</td>
                        <td>@Html.TextBoxFor(a => item.Frequency, new { @class = "form-control Frequency", @list = "dlFrequency" })</td>
                        <td>@Html.TextBoxFor(a => item.Duration, new { @class = "form-control Duration",@list="dlDuration" })</td>
                        <td align="center"><span class="glyphicon glyphicon-remove-circle" onclick="removeRowProtocol(this);"></span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <table style="display:none">
        <tr id="SampleDataRowProtocol"class="DataRowProtocol" data-protocolDetailId="0">
            <td class="hidden">@Html.TextBox("ProtocolId", null,new { @class= "form-control ProtocolId" })</td>
            <td>@Html.TextBox("ProtocoName", null, new { @class = "form-control ProtocoName", @list = "dlProtocoName" })</td>
            <td>@Html.TextBox("MedicineType", null, new { @class = "form-control MedicineType", @list = "dlMedicineType" })</td>
            <td>@Html.TextBox("Medicine", null, new { @class = "form-control Medicine" })</td>
            <td>@Html.TextBox("Dose", null, new { @class = "form-control Dose" })</td>
            <td>@Html.TextBox("DoseUnit", null, new { @class = "form-control DoseUnit", @list = "dlDoseUnit" })</td>
            
            <td>@Html.TextBox("Route", null, new { @class = "form-control Route", @list = "dlRoute" })</td>
            <td>@Html.TextBox("Frequency", null, new { @class = "form-control Frequency", @list = "dlFrequency" })</td>
            <td>@Html.TextBox("Duration", null, new { @class = "form-control Duration", @list = "dlDuration" })</td>
            <td align="center"><span class="glyphicon glyphicon-remove-circle" onclick="removeRowProtocol(this);"></span></td>
            <td title="Add to Favorite"><span class="glyphicon glyphicon-gift spnFavorite" onclick="AddMedicineToFavorite(this);"></span> </td>
        </tr>
    </table>

    <datalist id="dlDoseUnit">
        @foreach (SelectListItem item in ViewBag.DoseUnitVB)
        {
            <option value="@item.Text"></option>
        }
    </datalist>

    <datalist id="dlMedicineType">
        @foreach (SelectListItem item in ViewBag.MedicineTypeVB)
        {
            <option value="@item.Text"></option>
        }
    </datalist>

    <datalist id="dlProtocoName">
        @foreach (SelectListItem item in ViewBag.ProtocolVB)
        {
            <option value="@item.Text"></option>
        }
    </datalist>


    <datalist id="dlRoute">
        @foreach (SelectListItem item in ViewBag.RouteVB)
        {
            <option value="@item.Text"></option>
        }
    </datalist>
    <datalist id="dlFrequency">
        @foreach (SelectListItem item in ViewBag.FrequencyVB)
        {
            <option value="@item.Text"></option>
        }
    </datalist>
    <datalist id="dlDuration">
        @foreach (SelectListItem item in ViewBag.DurationVB)
        {
            <option value="@item.Text"></option>
        }
    </datalist>
</div>

<div class="row">
    <div class="col-lg-12">
        <h3>Previous Medications</h3>
        
        <table id="tblPreviousProtocols" class="table table-bordered table-responsive">
            <thead>
                <tr style="background-color: #57b7fd; color: white;">
                    @*<th>Protocol Id</th>*@
                    <th>Protocol Name</th>
                    <th>Medicine Type</th>
                    <th>Medicine</th>
                    <th>Dose</th>
                    <th>Dose Unit</th>

                    <th>Route</th>
                    <th>Frequency</th>
                    <th>Duration</th>
                    <th>Action</th>

                    <th>
                        
                        
                    </th>

                </tr>
            </thead>
            <tbody>

                @foreach (BDCS.Model.VitalHistory.Protocols item in ViewBag.PreviousProtocols)
                {

                    <tr class="DataRowProtocol" data-protocoldetailid="@item.ProtocolDetailId">
                        <td class="hidden">@Html.TextBoxFor(a => item.ProtocolId, new { @class = "form-control ProtocolId" })</td>
                        <td>@Html.TextBoxFor(a => item.ProtocoName, new { @class = "form-control ProtocoName", @list = "dlProtocoName" })</td>
                        <td>@Html.TextBoxFor(a => item.MedicineType, new { @class = "form-control MedicineType", @list = "dlMedicineType" })</td>
                        <td>@Html.TextBoxFor(a => item.Medicine, new { @class = "form-control Medicine" })</td>
                        <td>@Html.TextBoxFor(a => item.Dose, new { @class = "form-control Dose" })</td>
                        <td>@Html.TextBoxFor(a => item.DoseUnit, new { @class = "form-control DoseUnit", @list = "dlDoseUnit" })</td>

                        <td>@Html.TextBoxFor(a => item.Route, new { @class = "form-control Route", @list = "dlRoute" })</td>
                        <td>@Html.TextBoxFor(a => item.Frequency, new { @class = "form-control Frequency", @list = "dlFrequency" })</td>
                        <td>@Html.TextBoxFor(a => item.Duration, new { @class = "form-control Duration", @list = "dlDuration" })</td>
                        <td align="center">
                        
                            @if (!item.IsDiscontinued)
                            {
                                <span title="Discontinue Medicine" class="glyphicon glyphicon-remove-circle" onclick="DiscontinueMedicine(this);"></span>
                            }
                            else
                            {
                                    <span>Disc.</span>
                            }

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

  
</div>



@*//just to iniliazte the autocomplete text box and implement its event its calls only protocolName*@
<script type="text/javascript">

    $(document).ready(function () {

        $("#SearchProtocol").autocomplete({
            //here it shows the protocol Name in the text box

            source: '@Url.Action("GetProtocol", "Patient")' + '/?name=' + $("#SearchProtocol").val(),
            minLength: 2,
            select: function (event, ui) {

                GetProtocolItems(ui.item.value);
            }
        });

       $("#SearchMedicine").autocomplete({
                //here it shows the protocol Name in the text box
                autoFocus: true,
                source: function (request, response) {
                $.ajax({
                        url: "@Url.Action("GetMedicineAndFavorite", "Patient")",
                        type: 'post',
                        dataType: "json",
                        data: { term: request.term },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return {
                                    label: item.Medicine + " - " + item.Dose + " " + item.DoseUnit + (item.IsFavorite == true ? "    *** " : ""),
                                    value: item.Medicine,
                                    MedicineType: item.MedicineType,
                                    Medicine: item.Medicine,
                                    Dose: item.Dose,
                                    Route: item.Route,
                                    Frequency: item.Frequency,
                                    Duration: item.Duration,
                                    IsFavorite: item.IsFavorite
                                };
                            }));
                        },
                    });
                },
            minLength: 2,
            select: function (event, ui) {


                var row = $("#SampleDataRowProtocol").clone();
                $(row).removeAttr('id');
                $(row).find('.ProtocoName').val(ui.item.IsFavorite == true ? "Favorite" : "Medicine");
                $(row).find('.MedicineType').val(ui.item.MedicineType);
                $(row).find('.Medicine').val(ui.item.Medicine);
                $(row).find('.Dose').val(ui.item.Dose);
                $(row).find('.DoseUnit').val(ui.item.DoseUnit);
                $(row).find('.Route').val(ui.item.Route);
                $(row).find('.Frequency').val(ui.item.Frequency);
                $(row).find('.Duration').val(ui.item.Duration);
                if (ui.item.IsFavorite) {
                    $(row).find(".spnFavorite").removeAttr("onclick");
                    $(row).find(".spnFavorite").toggleClass("glyphicon-gift glyphicon-minus-sign");
                    $(row).find(".spnFavorite").attr("onclick", "DeleteFavoriteMedicine('" + ui.item.Medicine+ "','" + ui.item.MedicineType + "')");

                }
                $("#tblProtocols").append(row);
            return false;
        }
        });
    });


    function GetProtocolItems(name) {
        //here it add the protocol detail against protocol name
        debugger
        //$("#tblProtocols .DataRowProtocol").remove();
        $.ajax({

            url: '@Url.Action("GetProtocolDetail", "Patient")',
            type: 'post',
            dataType: 'json',
            data: { name: name },

            success: function (msg) {
                //alert(msg)
                debugger
                if (msg != null && msg.length > 0) {
                    for (var i = 0; i < msg.length; i++) {
                        var row = $("#SampleDataRowProtocol").clone();
                        $(row).removeAttr('id');
                        //$(row).find('input').val('');
                        $(row).find('.ProtocolDetailId').val(msg[i].ProtocolDetailId);

                        $(row).find('.ProtocolId').val(msg[i].ProtocolId);
                        $(row).find('.ProtocoName').val(msg[i].ProtocolName);
                        $(row).find('.MedicineType').val(msg[i].MedicineType);
                        $(row).find('.Medicine').val(msg[i].Medicine);
                        $(row).find('.Dose').val(msg[i].Dose);
                        $(row).find('.DoseUnit').val(msg[i].DoseUnit);
                        $(row).find('.Route').val(msg[i].Route);
                        $(row).find('.Frequency').val(msg[i].Frequency);
                        $(row).find('.Duration').val(msg[i].Duration);
                        $("#tblProtocols").append(row);
                    }
                }
            },
            error: function () {
                alert("an error occured.. ");
            }
        });

    }
    function ClearProtocolTable() {
        if (confirm("Do you wish to clear the current data")) {

            $("#tblProtocols .DataRowProtocol").each(function(){
                removeRowProtocol(this);
            });
        }
    }

    function addRowProtocol() {
        var row = $("#SampleDataRowProtocol").clone();
        $(row).removeAttr('id');
        $(row).find('input').val('');
        $("#tblProtocols").append(row);
    }

    function removeRowProtocol(tag) {
        debugger;
        var id = $(tag).closest('tr').data("protocoldetailid");

        if (id > 0) {
            $.post("@Url.Action("DeleteProtocolDetail","Patient")", {id: id}, function(){
            //do nothing..
            });
        }

        $(tag).closest('tr').remove();


    }

    function DiscontinueMedicine(tag)
    {
        var id = $(tag).closest('tr').data("protocoldetailid");

        if (id > 0) {
            $.post("@Url.Action("DiscontinueMedicine", "Patient")", { protocolDetailId: id }, function (data) {
                ShowAlertMessage(data.Message, data.MessageClass);
            });
        }
    }

    function AddFavoriteMedicine()
    {
        var option = $('#Favorites option:selected');

        if ($(option).val() != "") {
            var row = $("#SampleDataRowProtocol").clone();
            $(row).removeAttr('id');
            $(row).find('.ProtocolDetailId').val(0);
            $(row).find('.ProtocolId').val(0);
            $(row).find('.ProtocoName').val('Favorite');
            $(row).find('.MedicineType').val($(option).data('medicinetype'));
            $(row).find('.Medicine').val($(option).val());
            $(row).find('.Dose').val($(option).data('dose'));
            $(row).find('.DoseUnit').val($(option).data('doseunit'));
            $(row).find('.Route').val($(option).data('route'));
            $(row).find('.Frequency').val($(option).data('frequency'));
            $(row).find('.Duration').val($(option).data('duration'));
            $("#tblProtocols").append(row);
        }


    }

    function AddMedicineToFavorite(tag) {

        var row = $(tag).closest(".DataRowProtocol");

        var data = {
            MedicineType: $(row).find('.MedicineType').val(),
            Medicine:$(row).find('.Medicine').val(),
            Dose: $(row).find('.Dose').val(),
            DoseUnit:  $(row).find('.DoseUnit').val(),
            Route:  $(row).find('.Route').val(),
            Frequency:  $(row).find('.Frequency').val(),
            Duration: $(row).find('.Duration').val(),
        };

        $.ajax({
            url: '@Url.Action("AddMedicineToFavorite", "Patient")',
            type: 'post',
            dataType: 'json',
            data: JSON.stringify(data),
            contentType: 'application/json',
            success: function(data)
            {
                ShowAlertMessage(data.Message, data.MessageClass);
            },
            error: function()
            {
                ShowAlertMessage("An error occured", "error");
            }
        });

    }

    function DeleteFavoriteMedicine(name, type)
    {
        $.ajax({

            url: '@Url.Action("DeleteFavoriteMedicine", "Patient")',
            type: 'post',
            dataType: 'json',
            data: { medicineName: name, medicineType: type },

            success: function (msg) {
                ShowAlertMessage(msg.Message, msg.MessageClass, msg.MessageTitle);
           
            },
            error: function () {
                alert("an error occured.. ");
            }
        });

    }

    //done sir
    // waah sir you are great let me check

</script>