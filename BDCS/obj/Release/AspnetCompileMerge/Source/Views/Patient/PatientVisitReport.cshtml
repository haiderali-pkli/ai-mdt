<script>
    $(document).ready(function () {

        //setTimeout(function () { window.print(); window.close();},2000);
        $(".PrintCheckbox").each(function () {
            ShowOnPrint(this);
        });

        $(".PrintCheckbox").change(function () {
            ShowOnPrint(this);
        });
    });


    function ShowOnPrint(tag)
    {
        if ($(tag).is(":checked")) {
            $(tag).parent().removeClass("hidden-print");
        }
        else {
            $(tag).parent().addClass("hidden-print");
        }
    }
</script>




