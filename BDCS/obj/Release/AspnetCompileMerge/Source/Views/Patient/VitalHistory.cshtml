                        </div>
                    </div>

                    <div class="col-sm-9 col-xs-12">
                        <div class="form-group">
                            <label class="text-center">NO OF LESION</label>
                     
                            @Html.DropDownListFor(a => a.NumberOfLesion, (List<SelectListItem>)ViewBag.LargestLesionSizeVB, "--Select--", new { @class = "form-control" })
                            
                            @*@Html.TextBoxFor(a => a.NumberOfLesion, new { @class = "form-control" })*@
                        </div>
                    </div>

                </div>
              
                <div class="row">
                    <div class="col-lg-3 col-xs-6">
                        <div class="form-group">
                            <label>PREVIOUS TREAT</label>
                            @Html.CheckBoxFor(a => a.PreviousTreatment, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="col-lg-9 col-xs-6" id="TreatmentTypeDiv">
                        <label>Treatment Type</label>
                        @*@Html.DropDownListFor(a => a.TreatmentType, (List<SelectListItem>)ViewBag.MDTOutComeVB, "--Select--", new { @class = "form-control" })*@
                        @Html.ListBoxFor(a => a.TreatmentType, (List<SelectListItem>)ViewBag.MDTOutComeVB, new { @class = "form-control MuliDropdown" })
                        

                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12 col-xs-6">
                        <label>Response to Treatment</label>
                        

                        @Html.DropDownListFor(a => a.TreatmentResponse, (List<SelectListItem>)ViewBag.TreatmentResponseVB, "--Select--", new { @class = "form-control" })
                    </div>
                </div>
            </div>

      

        </div>
   <div class="col-lg-4">
       <!--Column-3-->
       <div class="row">
