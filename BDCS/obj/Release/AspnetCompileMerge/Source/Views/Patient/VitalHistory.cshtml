@model BDCS.Model.VitalHistory.VitalHistory
@{
    if (Request.IsAjaxRequest())
    {
        Layout = null;
    }

}
@*for next followup column it make each row heigh in column equal where absoulate:Position Bottom makt its posstion to bottom <div class="row" style="position: absolute; bottom:15px;">*@



    <style type="text/css">
        .equal {
            display:flex;
            flex-wrap: wrap;
        }
    </style>
    
    <div class="row equal">

        <!--Column-1-->
        <div class="col-lg-4 col-xs-6">
            @Html.HiddenFor(a => a.PatientDetailId, new { @class = "form-control" })
            <div class="row">
                <div class="col-sm-3">
                    <div class="form-group">
                        <label>Visit ID</label>
                        @Html.TextBox("VisitId", (int)ViewBag.VisitIdVB, null, new { @class = "form-control", @readonly = "readonly" })
                    </div>
                </div>
                <div class="col-sm-5">
                    <div class="form-group">
                        <label>Visit Date</label>
                        @Html.TextBox("VisitDateTime", (string)ViewBag.VisitDateTimeVB, new { @class = "form-control", @readonly = "readonly" })
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label>Visit Type</label>
                        @Html.TextBox("VisitType", (string)ViewBag.VisitTypeVB, null, new { @class = "form-control", @readonly = "readonly" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-12 col-xs-6">
                    <div class="form-group">
                        <label>CHIEF COMPLAINTS</label>
                        @Html.TextAreaFor(a => a.CIC, new { @class = "form-control ", style = "max-width:100%" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-sm-3 col-xs-2">
                    <label>CHILD STATUS</label>
                    @Html.DropDownListFor(a => a.ChildStatus, (List<SelectListItem>)ViewBag.ChildStatusVB, "--Select--", new { @class = "form-control"})
                </div>
                <div class="col-sm-3 col-xs-2">
                    <label>MELD-Na STATUS</label>
                    @Html.DropDownListFor(a => a.MeldStatus, (List<SelectListItem>)ViewBag.MeldStatusVB, "--Select--", new { @class = "form-control" })
                </div>
                <div class="col-sm-3 col-xs-2">
                    <label>BCLC STATUS</label>
                    @Html.DropDownListFor(a => a.BCLC, (List<SelectListItem>)ViewBag.BCLCVB, "--Select--", new { @class = "form-control" })
                </div>
                <div class="col-sm-3 col-xs-2">
                    <label>ECOG STATUS</label>
                    @Html.DropDownListFor(a => a.ECOGStatus, (List<SelectListItem>)ViewBag.ECOGStatusVB, "--Select--", new { @class = "form-control" })
                </div>
            </div>

            @*LabOrders*@
            <div class="row">
                <div class="col-lg-12">
                    <div id="labOrders" class="row">
                        <div class="col-sm-12">

                        </div>
                    </div>
                </div>
            </div>

            @*Hepatitis Status*@
            <div class="row hidden-print">
                <div class="col-sm-4 col-xs-2">
                    <label>HEPATITIS STATUS</label>
                    @Html.DropDownListFor(a => a.HepStatus, (List<SelectListItem>)ViewBag.HepStatusVB, "--Select--", new { @class = "form-control" })
                </div>
                <div class="col-sm-4 col-xs-2">
                    <label>ASCITIES STATUS</label>
                    @Html.DropDownListFor(a => a.AscitiesStatus, (List<SelectListItem>)ViewBag.AscitiesStatusVB, "--Select--", new { @class = "form-control" })
                </div>
                <div class="col-sm-4 col-xs-2">
                    <label>SVR STATUS</label>
                    @Html.DropDownListFor(a => a.SVRStatus, (List<SelectListItem>)ViewBag.SVRStatusVB, "--Select--", new { @class = "form-control" })
                </div>
            </div>
        </div>    
        <!--Column-2-->
        <div class="col-lg-4 col-xs-12"style="padding: 25px;   padding-top: 0px;">
