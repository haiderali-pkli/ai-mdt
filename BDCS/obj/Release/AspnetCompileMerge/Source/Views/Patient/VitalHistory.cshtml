               <div class="form-group">
                   <label>FINAL DIAGNOSIS</label>
                   @Html.DropDownList("DiagnosisName", (IEnumerable<SelectListItem>)ViewBag.DiagnosisVB, "--Select--", new { @class = "form-control", style = "max-width:100%", onchange = "AddDiagnosisRow();" })
               </div>
           </div>
           <div class="col-lg-12 col-xs-6">
