                @Html.TextBoxFor(a => a.ReasonOfRefusal, new { @class = "form-control", placeholder = "Reason for Resfusal", @list = "lstRefusalReason" })
            </div>
        </div>
          
        <div class="row">
            <div class="col-lg-12 col-xs-12">
