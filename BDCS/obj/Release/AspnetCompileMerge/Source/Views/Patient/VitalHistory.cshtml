                    @Html.TextAreaFor(a => a.MDTDiscussion, new { @class = "form-control ", style = "max-width:100%" })
                </div>
            </div>
        </div>
    <div>
</div>
    <div class="row">          
        <div class="col-lg-12 col-xs-6">
