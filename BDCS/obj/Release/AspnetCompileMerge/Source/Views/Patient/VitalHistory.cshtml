       </div>
       <div class="row">
           <div class="col-lg-2 col-xs-6">
               <label>Transplant Discussion</label>
               @Html.CheckBoxFor(a => a.TransplantDiscussion, new { @class = "form-control"})
           </div>
           <div class="col-lg-10 col-xs-6">
               <div class="form-group" id="TransplantDiscussionDiv">
                   <label>Transplant Discussion Detail</label>
                   @Html.TextAreaFor(a => a.TransplantDiscussionDetail, new { @class = "form-control", rows = "2", style = "max-width:100%" })
               </div>
           </div>
       </div>
       <div class="row">

      

       </div>
       <div class="row">
           <div class="col-lg-12 col-xs-6">
               <label>Imaging Date</label>
               @Html.TextBoxFor(a => a.ImagingDate, Model.ImagingDate.HasValue ? Model.ImagingDate.Value.ToString("dd-MMM-yyyy") : "", new { @class = "form-control datepicker" })
               
           </div>

       </div>
 </div>
