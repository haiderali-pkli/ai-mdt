                   <label>DIAGNOSIS DETAIL</label>
                   @Html.TextBoxFor(a => a.DiagnosisDetails, new { @class = "form-control ", style = "max-width:100%" })
               </div>
           </div>
           <div class="col-lg-12">
               <div class="form-group">
                   <table id="tblDiagnosis" class="table table-bordered table-striped table-responsive" >
                       <thead>
                           <tr style="background-color: #57b7fd; color: white;">
                               <th>Diagnosis Name</th>
                               <th>Active</th>
                               <th>

                               </th>
                           </tr>
                       </thead>
                       <tbody>
                           @if (Model != null && Model.PatientDiagnosis.Count > 0)
                           {
                               foreach (BDCS.Model.VitalHistory.PatientDiagnosis item in Model.PatientDiagnosis)
                               {
                                   <tr class="DataRowDagnosis" data-recordidPrv="@item.PatientDiagnosisId">
                                       <td>@Html.TextBoxFor(a => item.Diagnosis, new { @class = "form-control DiagnosisName" })</td>
                                       <td>@(item.IsActive ? "Yes" : "No")</td>
                                       <td>
                                           @if (item.IsActive)
                                           {
                                               <span class="glyphicon glyphicon-comment" title="Mark this diagnosis as Inactive" onclick="MarkDianosisAsInactive(@item.PatientDiagnosisId,this);"></span>
                                           }
                                       </td>
                                   </tr>
                               }
                           }
                       </tbody>
                   </table>
                   <table style="display:none">
                       <tr id="sampleDataRowDiagnosis" class="DataRowDagnosis">
                           <td>@Html.TextBox("DiagnosisName", null, new { @class = "DiagnosisName form-control" })</td>
                           <td><span class="glyphicon glyphicon-remove-circle" onclick="removeRow(this);"></span></td>
                       </tr>
                   </table>
               </div>
           </div>
       </div>
       <div class="row">
           <div class="col-lg-3 col-xs-6">
               <label>Meeting Milan</label>
               @Html.CheckBoxFor(a => a.MeetingMilan, new { @class = "form-control" })
           </div>
           <div class="col-lg-3 col-xs-6">
               <label>UCSF</label>
               @Html.CheckBoxFor(a => a.UCSF, new { @class = "form-control" })
           </div>

           <div class="col-lg-3 col-xs-6">
               <label>ASAN</label>
               @Html.CheckBoxFor(a => a.ASAN, new { @class = "form-control" })
           </div>
          
           <div class="col-lg-3 col-xs-6">
               <label>Other</label>
               @Html.CheckBoxFor(a => a.other, new { @class = "form-control" })
           </div>
       </div>
       <div class="row">
           <div class="col-lg-12">
