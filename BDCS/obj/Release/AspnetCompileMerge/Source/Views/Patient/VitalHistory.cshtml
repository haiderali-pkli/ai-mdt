        function AppendPreviousResultsToCic()
        {

            var Values = new Array();

            var Cic = $("#CIC").val();

            $("#tblPreviousResult .DataRowPreviousResult").each(function () {
                Values.push($(this).find(".TestDate").val() + " " + $(this).find(".TestName").val() + " " + $(this).find(".TestResult").val());
            });

            if (Values.length > 0) {
                $("#CIC").val($("#CIC").val() + "\n" + Values.join(" | "));
            }

        }

        function PrintReport() {
            window.open("@Url.Action("PatientVisitReportRdlc","Patient")/?patId="+$("#patientId").val() + "&visitId="+$("#VisitId").val(),"_blank");
        }

        function AddDiagnosisRow()
        {
            var row = $("#sampleDataRowDiagnosis").clone();
            $(row).removeAttr('id');
            $(row).find(".DiagnosisName").val($("#DiagnosisName").val());

            $("#tblDiagnosis").append(row).trigger('rowAddOrRemove');
        }

        function MarkDianosisAsInactive(id,tag)
        {
            $.ajax({
                url: '@Url.Action("MarkPatientDiagnosisAsInactive", "Patient")',
                type: 'Post',
                dataType: 'Json',
                data: { patientDiagnosisId: id },
                success: function (msg) {

                    ShowAlertMessage(msg.Message, msg.MessageClass);
                    debugger;
                    var PastHxText = $("#PastHxNAT").val();
                    var Diagnosis = $(tag).closest("tr").find(".DiagnosisName").val();

                    PastHxText += "\n" + Diagnosis;
                    $("#PastHxNAT").val(PastHxText);
                },
                error: function () {
                    alert('an error occured');
                }
            });
        }

