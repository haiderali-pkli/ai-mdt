        $(document).ready(function () {
            PostPageLoad();
        });

        function PostPageLoad() {

            setTimeout(LoadPageData, 100);
            //plugin added in top of patientdeail view, on clikc this will call the function body
            $("#SystemicRes").asuggest(SystemicResSuggestions, { 'cycleOnTab': false });
            $("#SystemicCVS").asuggest(SystemicCVSSuggestions, { 'cycleOnTab': false });
            $("#SystemicLiver").asuggest(SystemicLiverSuggestions, { 'cycleOnTab': false });
            $("#SystemicSpleen").asuggest(SpleenSuggestions, { 'cycleOnTab': false });
            $("#PresentHx").asuggest(PresentHistory, { 'cycleOnTab': false });
            $("#FamilyHx").asuggest(FamilyHistory, { 'cycleOnTab': false });
            $("#DrugHx").asuggest(DrugHistory, { 'cycleOnTab': false });
            $("#SecHx").asuggest(SecHistory, { 'cycleOnTab': false });
            $("#Comorbidites").asuggest(ComorbiditiesSuggestion, { 'cycleOnTab': false });
            $("#TransfusionHx").asuggest(TransfusionHxSuggestion, { 'cycleOnTab': false });
            $("#CIC").asuggest(CICSuggestion, { 'cycleOnTab': false });
            $("#PresentHx").asuggest(PresentHistory, { 'cycleOnTab': false });

            $(".MuliDropdown").chosen();
            InitializeDateTimePicker(".datepicker");

            ShowHideGenderSpecificFields();
            ShowHideSiteAngioInvasion();
            ShowHidePtWillingForTransplant();
            ShowHidePtSiteOfHepaticDisease();
            ShowHidPreviousTreatmentResponse();
            ShowHideOtherDetail();
            ShowHideTransplantDiscussionDetail();


            $("#tblDiagnosis").trigger('rowAddOrRemove');

            $('#tblDiagnosis').bind('rowAddOrRemove', function (event) {
                var rows = $("#tblDiagnosis tr.DataRowDagnosis").length;
                
                if (rows > 0) {
                    $('#tblDiagnosis').show();
                }
                else {
                    $('#tblDiagnosis').hide();
                }
            });

            $(document).on("change", ".DataRowLabReports input", function () {
                PopulateLabResultValue($(this).closest(".DataRowLabReports"));
            });

            $(document).on("change", "#Angioinvasion", function () {
                ShowHideSiteAngioInvasion();
            });

            $(document).on("change", "#PtWillingForTransplant", function () {
                ShowHidePtWillingForTransplant();
            });

            $(document).on("change", "#ExtraHepaticDisease", function () {
                ShowHidePtSiteOfHepaticDisease();
            });

            $(document).on("change", "#PreviousTreatment", function () {
                ShowHidPreviousTreatmentResponse();
            });

            if ($("#nextFollowupDate").val() == "01/01/0001 12:00:00 AM") {
                $("#nextFollowupDate").val("");
            }

            $(document).on("change", "#other", function () {
                ShowHideOtherDetail();
            });

            $(document).on("change", "#TransplantDiscussion", function () {
                ShowHideTransplantDiscussionDetail();
            });

        }

        function addRowPreviousResult() {
            var row = $("#sampleDataRowPreviousResult").clone();

            $(row).removeAttr('id');
            $(row).find('input').val('');
            $("#tblPreviousResult").append(row);
            InitializeDateTimePicker(".datepicker");

        }
        function removeRow(tag) {
            $(tag).closest('tr').remove();
        }

        function LoadPageData() {
            var visitId = $("#visitId").val();
            var url = '@Url.Action("GetLabOrders","Patient")'+'/?visitId=' + visitId;
            loadPage(url, "LabOrders", "labOrders");
        }

        function savePatientDetail() {
            debugger;
            var previousResult = new Array();
            var currentReports = new Array();
            var protocolDetail = new Array();
            var patientDiagnosis = new Array();

            var Valid = true;

            $("#tblPreviousResult .DataRowPreviousResult").each(function () {
                debugger;
                var Data = {
                    LabReportId: $(this).data("recordidprv"),
                    VisitId: $("#VisitId").val(),
                    TestName: $(this).find(".TestName").val(),
                    TestDate: $(this).find(".TestDate").val(),
                    TestResult: $(this).find(".TestResult").val(),
                    TestResultLabel: $(this).find(".TestResultLabel").val(),
                };
