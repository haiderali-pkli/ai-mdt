                        </div>
                    </div>

                    <div class="col-sm-5 col-xs-2">
                        <div class="form-group pull-right">
                            <label class="text-center" style="margin-left:25px;">Portal Hypertension</label>
                            @Html.CheckBoxFor(a => a.PortalHypertension, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="col-sm-4 col-xs-2">
                        <div class="form-group pull-right">
                            <label class="text-center" style="margin-left:62px;">Varices</label>
                            @Html.CheckBoxFor(a => a.Varices, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class=" row">
                    <div class="col-lg-3 col-xs-12">
                        <div class="form-group">
                            <label>LARGEST LESION</label>
