                        </div>
                    </div>
                    <div class="col-lg-9 col-xs-6">
                        <div class="form-group" id="ExtraHepaticDiseaseContainer">
                            <label>SITE OF EXTRA HEPATIC DISEASE HISTORY</label>
                            @Html.ListBoxFor(a => a.SiteOfHepaticDisease, (List<SelectListItem>)ViewBag.SitesOfExtraHepaticDiseaseVB, new { @class = "form-control MuliDropdown" })
                            @*@Html.TextBoxFor(a => a.SiteOfHepaticDisease, new { @class = "form-control", @list= "lstOfSitesOfExtraHepaticDisease" })*@
                        </div>
                    </div>



