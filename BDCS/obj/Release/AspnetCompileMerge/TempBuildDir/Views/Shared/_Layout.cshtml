<script type="text/javascript">

    $(document).ready(function () {
        InitializeHeartbeat();
        
    });

    function InitializeHeartbeat()
    {
        HeartbeatTimer = setInterval(Heartbeat, 60000);
    }

    function Heartbeat() {
        $.ajax({
            url: '@Url.Action("Heartbeat", "Home")',
            type: 'post',
            success: function(data)
            {
                // do nothing
            }
        });
    }


</script>

