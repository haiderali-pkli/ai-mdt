
@{
    ViewBag.Title = "PatientVisitAdvanceSearch";
    if (Request.IsAjaxRequest())
    {
        Layout = null;
    }
}


<div class="panel panel-default" style="padding-top: 50px;">
    <div class="panel-heading" style="background-color: #57b7fd; color:white;"><strong style="font-size:25px">Advance Search</strong></div>
    <div class="panel-body" style="border-color:#a0e0ee">

        <div class="row">
            <div class="col-sm-2 col-xs-2">
                <label>CHILD STATUS</label>
                @Html.DropDownList("ChildStatus", (List<SelectListItem>)ViewBag.ChildStatusVB, "--Select--", new { @class = "form-control" })
            </div>
            <div class="col-sm-2 col-xs-2">
                <label>MELD-Na STATUS</label>
                @Html.DropDownList("MeldStatus", (List<SelectListItem>)ViewBag.MeldStatusVB, "--Select--", new { @class = "form-control" })
            </div>
            <div class="col-sm-2 col-xs-2">
                <label>BCLC STATUS</label>
                @Html.DropDownList("BCLC", (List<SelectListItem>)ViewBag.BCLCVB, "--Select--", new { @class = "form-control"})
            </div>
            <div class="col-sm-2 col-xs-2">
                <label>ECOG STATUS</label>
                @Html.DropDownList("ECOGStatus", (List<SelectListItem>)ViewBag.ECOGStatusVB, "--Select--", new { @class = "form-control" })
            </div>


            <div class="col-sm-2">
                <label>Response to Treatment</label>
                @Html.DropDownList("TreatmentResponse", (List<SelectListItem>)ViewBag.TreatmentResponseVB, "--Select--", new { @class = "form-control" })
            </div>
            <div class="col-sm-2">
                <label>MDT OUT COME</label>
                @Html.DropDownList("MDTOutCome", (List<SelectListItem>)ViewBag.MDTOutComeVB, new { @class = "form-control" })
            </div>
         
        </div>

        <div class="row hidden-print">
            <div class="col-sm-2 col-xs-2">
                <label>HEPATITIS STATUS</label>
                @Html.DropDownList("HepStatus", (List<SelectListItem>)ViewBag.HepStatusVB, "--Select--", new { @class = "form-control" })
            </div>
            <div class="col-sm-2 col-xs-2">
                <label>ASCITIES STATUS</label>
                @Html.DropDownList("AscitiesStatus", (List<SelectListItem>)ViewBag.AscitiesStatusVB, "--Select--", new { @class = "form-control" })
            </div>
            <div class="col-sm-2 col-xs-2">
                <label>SVR STATUS</label>
                @Html.DropDownList("SVRStatus", (List<SelectListItem>)ViewBag.SVRStatusVB, "--Select--", new { @class = "form-control" })
            </div>

            <div class="col-sm-2 col-xs-12">
                <div class="form-group">
                    <label>ANY OTHER COMORBIDITIES</label>
                    @Html.DropDownList("OtherComorbities", (List<SelectListItem>)ViewBag.DiagnosisVB, "--Select--", new { @class = "form-control MuliDropdown" })
                </div>
            </div>
        

            <div class="col-sm-2 col-xs-6">
                <div class="form-group" id="SiteOfAngioinvasionContainer">
                    <label>SITE OF ANGIOINVASION</label>
                    @Html.DropDownList("SiteOfAngioinvasionVB", (List<SelectListItem>)ViewBag.SiteOfAngioinvasionDropdown, "--Select--", new { @class = "form-control" })
                </div>
            </div>
            <div class="col-sm-2">
                @*<label>Match:</label>
                <select class="form-control" id="MatchingCriteria" name="MatchingCriteria">
                    <option value="AND">Match All</option>
                    <option value="OR">Match Either</option>
                </select>*@
            </div>
        </div>

        <div class="row">
            <div class="col-sm-2">
                <div class="form-group">
                    <label style="margin-left:86px;">LIVER CIRRHOSIS</label>
                    @Html.CheckBox("LiverCirrhosis", new { @class = "form-control" })
                </div>
            </div>

            <div class="col-sm-2">
                <div class="form-group pull-right">
                    <label class="text-center" style="margin-left:75px;">Portal Hypertension</label>
                    @Html.CheckBox("PortalHypertension", new { @class = "form-control" })
                </div>
            </div>
            <div class="col-sm-2">
                <div class="form-group pull-right">
                    <label class="text-center" style="margin-left:111px;">Varices</label>
                    @Html.CheckBox("Varices", new { @class = "form-control" })
                </div>
            </div>
            <div class="col-sm-2">
                <label style="margin-left:85px;">Meeting Milan</label>
                @Html.CheckBox("MeetingMilan", new { @class = "form-control" })
            </div>
            <div class="col-sm-2">
                <label style="margin-left:115px;">UCSF</label>
                @Html.CheckBox("UCSF", new { @class = "form-control" })
            </div>

            <div class="col-sm-2">
                <label style="margin-left:112px;">ASAN</label>
                @Html.CheckBox("ASAN", new { @class = "form-control" })
            </div>

            <div class="col-sm-2" id="ExtraHepaticDiseaseContainer">
            <label>SITE OF EXTRA HEPATIC DISEASE HISTORY</label>
                @Html.TextBox("SiteOfHepaticDisease", null, new { @class = "form-control", @list = "lstOfSitesOfExtraHepaticDisease" })
            </div>
            <div class="col-sm-2">
                <label>REFUSAL REASON</label>
                @Html.TextBox("ReasonOfRefusal", null,new { @class = "form-control", placeholder = "Reason for Resfusal", @list = "lstRefusalReason" })
            </div>

            <div class="col-sm-1">
                <div class="form-group pull-right">
                    <label></label>
                    <button class="btn btn-warning" onclick="GetAdvanceSearchResults();">Search</button>
                </div>
            </div>

            <div class="col-sm-1">
                <div class="form-group pull-right">
                    <label></label>
                    <button class="btn btn-danger" onclick="loadPage('@Url.Action("GetPatientList","Patient")','Patient');">Close</button>
                </div>
            </div>
        </div>

    </div>
</div>


<div class="container-fluid" id="AdvanceSearchResult">

</div>


<datalist id="lstOfSitesOfExtraHepaticDisease">
    @foreach (SelectListItem item in ViewBag.SitesOfExtraHepaticDiseaseVB)
    {
        <option>@item.Text</option>
    }
</datalist>
<datalist id="lstRefusalReason">
    @foreach (SelectListItem item in ViewBag.RefusalReasonVB)
            {
        <option value="@item.Text"></option>
    }
</datalist>



<script type="text/javascript">

    function GetAdvanceSearchResults() {


        var Params = {
            ChildStatus: $("#ChildStatus").val(),
            MeldStatus: $("#MeldStatus").val(),
            BCLCStatus: $("#BCLC").val(),
            ECOG: $("#ECOGStatus").val(),
            TreatmentResponse: $("#TreatmentResponse").val(),
            MdtOutcome: $("#MDTOutCome").val(),
            HepatitisStatus: $("#HepStatus").val(),
            AscitiesStatus: $("#AscitiesStatus").val(),
            Svr: $("#SVRStatus").val(),
            OtherComorbidities: $("#OtherComorbities").val(),
            AngioInvasion: $("#SiteOfAngioinvasionVB").val(),
            LiverCirrhosis: $("#LiverCirrhosis").is(":checked") ? true : false,
            PortalHypertension: $("#PortalHypertension").is(":checked") ? true : false,
            Varices: $("#Varices").is(":checked") ? true : false,
            MeetingMilan: $("#MeetingMilan").is(":checked") ? true : false,
            UCSF: $("#UCSF").is(":checked") ? true : false,
            ASAN: $("#ASAN").is(":checked") ? true : false,
            AFP:0
        };

        var Url = '@Url.Action("PatientVisitAdvanceSearchResult", "Patient")/?'+ $.param(Params);

        loadPage(Url, 'AdvanceSearchResult', 'AdvanceSearchResult');


    }



</script>