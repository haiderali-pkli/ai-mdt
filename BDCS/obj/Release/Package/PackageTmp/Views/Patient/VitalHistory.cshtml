        </text>
        }

        var FamilyHistory = new Array();
        @foreach (SelectListItem item in ViewBag.FamilyHistoryVB)
        {
            <text>
                FamilyHistory.push('@item.Text')
        </text>
        }


        var DrugHistory = new Array();
        @foreach (SelectListItem item in ViewBag.DrugHistoryVB)
        {
            <text>
            DrugHistory.push('@item.Text')
