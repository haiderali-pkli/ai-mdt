@model BDCS.Model.VitalHistory.VitalHistory
@{
    if (Request.IsAjaxRequest())
    {
        Layout = null;
    }

}
@*for next followup column it make each row heigh in column equal where absoulate:Position Bottom makt its posstion to bottom <div class="row" style="position: absolute; bottom:15px;">*@

    <style type="text/css">
        .equal {
            display:flex;
            flex-wrap: wrap;
        }
    </style>
    
    <div class="row equal">
        <!--VisitDetail-->
        <div class="col-lg-4 col-xs-6">
            @Html.HiddenFor(a => a.PatientDetailId, new { @class = "form-control" })


            <div class="row">
                <div class="col-sm-3">
                    <div class="form-group">
                        <label>Visit ID</label>
                        @Html.TextBox("VisitId", (int)ViewBag.VisitIdVB, null, new { @class = "form-control", @readonly = "readonly" })
                    </div>
                </div>
                <div class="col-sm-5">
                    <div class="form-group">
                        <label>Visit Date</label>
                        @Html.TextBox("VisitDateTime", (string)ViewBag.VisitDateTimeVB, new { @class = "form-control", @readonly = "readonly" })
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label>Visit Type</label>
                        @Html.TextBox("VisitType", (string)ViewBag.VisitTypeVB, null, new { @class = "form-control", @readonly = "readonly" })
                    </div>
                </div>
            </div>
            <!--Vitals-->
            <div class="row">
                <div class="col-sm-3">
                    <div class="form-group">
                        <label>Weight</label>
                        @Html.TextBoxFor(a => a.Weight, new { @class = "form-control", maxlength = "2", type = "number" })
                    </div>
                </div>
                <div class="col-sm-3">
                    <div class="form-group">
                        <label>Weight-U</label>
                        @Html.DropDownListFor(a => a.WeightUnit, (List<SelectListItem>)ViewBag.WeightUnitVB, new { @class = "form-control" })
                    </div>
                </div>
                <div class="col-sm-3">
                    <div class="form-group">
                        <label>Height</label>
                        @Html.TextBoxFor(a => a.Height, new { @class = "form-control", maxlength = 3, type = "number" })
                    </div>
                </div>
                <div class="col-sm-3">
                    <div class="form-group">
                        <label>Height-U</label>
                        @Html.DropDownListFor(a => a.HeightUnit, (List<SelectListItem>)ViewBag.HeightUnitVB, new { @class = "form-control" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-3">
                    <div class="form-group">
                        <label>BP-Sys</label>
                        @Html.TextBoxFor(a => a.BPSystolic, new { @class = "form-control", maxlength = 3, type = "number" })
                    </div>
                </div>
                <div class="col-sm-3">
                    <div class="form-group">
                        <label>BP-Dis</label>
                        @Html.TextBoxFor(a => a.BPDistolic, new { @class = "form-control", maxlength = 3, type = "number" })
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label>Temperature</label>
                        @Html.TextBoxFor(a => a.Temp, new { @class = "form-control" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-3 col-xs-2" style="width:12%">
                    <div class="form-group">
                        <label>GPEJ</label>
                        @Html.CheckBoxFor(a => a.GPEJ, new { @class = "form-control" })
                    </div>
                </div>
                <div class="col-sm-3 col-xs-2" style="width:12%">
                    <div class="form-group">
                        <label>GPEA</label>
                        @Html.CheckBoxFor(a => a.GPEA, new { @class = "form-control"})
                    </div>
                </div>
                <div class="col-sm-3 col-xs-2" style="width:12%">
                    <div class="form-group">
                        <label>GPEL</label>
                        @Html.CheckBoxFor(a => a.GPEL, new { @class = "form-control" })
                    </div>
                </div>
                <div class="col-sm-3 col-xs-2" style="width:12%">
                    <div class="form-group">
                        <label>GPEC</label>
                        @Html.CheckBoxFor(a => a.GPEC, new { @class = "form-control" })
                    </div>
                </div>

                <div class="col-sm-3 col-xs-2" style="width:12%">
                    <div class="form-group">
                        <label>GPEK</label>
                        @Html.CheckBoxFor(a => a.GPEK, new { @class = "form-control" })
                    </div>
                </div>
                <div class="col-sm-3 col-xs-2" style="width:12%">
                    <div class="form-group">
                        <label>GPEE</label>
                        @Html.CheckBoxFor(a => a.GPEE, new { @class = "form-control" })
                    </div>
                </div>
                <div class="col-sm-3 col-xs-2" style="width:12%">
                    <div class="form-group">
                        <label>GPET</label>
                        @Html.CheckBoxFor(a => a.GPET, new { @class = "form-control" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12 col-xs-6">
                    <div class="form-group">
                        <label>Comments</label>
                        @Html.TextAreaFor(a => a.GPEComments, new { @class = "form-control", style = "max-width:100%;", pattern = "[a-zA-Z0-9]+" })
                    </div>
                </div>
            @*</div>
            <div class="row">*@
                <div class="col-sm-12 col-xs-6">
                    <div class="form-group">
                        <label>Cardiovascular System</label>
                        @Html.TextAreaFor(a => a.SystemicCVS, new { @class = "form-control", style = "max-width:100%;" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12 col-xs-6">
                    <div class="form-group">
                        <label>Respiratory System</label>
                        @Html.TextAreaFor(a => a.SystemicRes, new { @class = "form-control", style = "max-width:100%", @list = "dlsresp" })
                    </div>
                </div>
            @*</div>
            <div class="row">*@
                <div class="col-sm-12 col-xs-6">
                    <div class="form-group">
                        <label>Liver(cm)</label>
                        @Html.TextAreaFor(a => a.SystemicLiver, new { @class = "form-control", style = "max-width:100%;", @list = "dlsliver" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12 col-xs-6">
                    <div class="form-group">
                        <label>Spleen(cm)</label>
                        @Html.TextAreaFor(a => a.SystemicSpleen, new { @class = "form-control", style = "max-width:100%;", @list = "dlsspleen" })
                    </div>
                </div>
            </div>
        </div>
  
        <!--CIC and Previous Result-->
        <div class="col-lg-4 col-xs-6">
            <div class="row hidden-print">
                <div class="col-lg-12 col-xs-6">
                    <div class="form-group">
                        <label>Cheif Complaints</label>
                        @Html.TextAreaFor(a => a.CIC, new { @class = "form-control ", style = "max-width:100%" })
                    </div>
                </div>

                <div class="col-lg-12 col-xs-6">
                    <div class="form-group">
                        <label>Diagnosis</label>
                        @Html.DropDownList("DiagnosisName", (IEnumerable<SelectListItem>)ViewBag.DiagnosisVB,"--Select--" ,new { @class = "form-control", style = "max-width:100%", onchange="AddDiagnosisRow();" })
                    </div>
                </div>

                <div class="col-lg-12 col-xs-6">
                    <div class="form-group">
                        <label>Diagnosis Details</label>
                        @Html.TextBoxFor(a => a.DiagnosisDetails, new { @class = "form-control ", style = "max-width:100%" })
                    </div>
                </div>
            </div>

            <!-- Diagnosis table-->

            <div class="row">
                <div class="col-lg-12">
                    <div class="form-group">
                        <table id="tblDiagnosis" class="table table-bordered table-striped">
                            <thead>
                                <tr style="background-color: #57b7fd; color: white;">
                                    <th>Diagnosis Name</th>
                                    <th>Active</th>
                                    <th>
                                        
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.PatientDiagnosis.Count > 0)
                                {
                                    foreach (BDCS.Model.VitalHistory.PatientDiagnosis item in Model.PatientDiagnosis)
                                    {
                                        <tr class="DataRowDagnosis" data-recordidPrv="@item.PatientDiagnosisId">
                                            <td>@Html.TextBoxFor(a => item.Diagnosis, new { @class = "form-control DiagnosisName"})</td>
                                            <td>@(item.IsActive ? "Yes" : "No")</td> 
                                            <td>
                                                @if (item.IsActive)
	                                            {
		                                             <span class="glyphicon glyphicon-comment" title="Mark this diagnosis as Inactive" onclick="MarkDianosisAsInactive(@item.PatientDiagnosisId,this);"></span>
	                                            }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                        <table style="display:none">
                            <tr id="sampleDataRowDiagnosis" class="DataRowDagnosis">
                                <td>@Html.TextBox("DiagnosisName", null, new { @class = "DiagnosisName form-control" })</td>
                                <td><span class="glyphicon glyphicon-remove-circle" onclick="removeRow(this);"></span></td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
            <!--Previous Result Table-->
            <div class="row">
                <div class="col-lg-12">
                    <div class="form-group">
                        <table id="tblPreviousResult" class="table table-bordered table-striped">
                            <thead>
                                <tr style="background-color: #57b7fd; color: white;">
                                    <th>Test Name</th>
                                    <th>Test Date</th>
                                    <th>Result</th>
                                    <th>Result Label</th>
                                    <th>
                                        <span class="glyphicon glyphicon-plus-sign" onclick="addRowPreviousResult();"></span>
                                        <span class="glyphicon" onclick="OpenModalPopup();">G</span>
                                        <span class="glyphicon glyphicon-book" onclick="AppendPreviousResultsToCic();"></span>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.PreviousLab.Count > 0)
                                {
                                    foreach (BDCS.Model.VitalHistory.LabReports item in Model.PreviousLab)
                                    {
                                        <tr id="sampleDataRowPreviousResult" class="DataRowPreviousResult" data-recordidPrv="@item.PreviousReportId">
                                            @*<tr id="sampleDataRowPreviousResult" class="DataRowPreviousResult" data-recordidPrv="@item.PreviousReportId">*@
                                            <td>@Html.TextBoxFor(a => item.TestName, new { @class = "form-control TestName", @list= "dlLabTestList", tabindex = "-1" })</td>
                                            <td>@Html.TextBoxFor(a => item.TestDate, item.TestDate.HasValue ? item.TestDate.Value.ToString("dd-MMM-yyyy") : "", new { @class = "form-control TestDate datepicker", tabindex = "-1" })</td>
                                            <td>@Html.TextBoxFor(a => item.TestResult, new { @class = "form-control TestResult" })</td>
                                            <td>@Html.TextBoxFor(a => item.TestResultLabel, new { @class = "form-control TestResultLabel",@list= "dlResultLabel", tabindex = "-1" })</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                        <table style="display:none">
                            <tr id="sampleDataRowPreviousResult" class="DataRowPreviousResult">
                                <td>@Html.TextBox("TestName", null, new { @class = "TestName form-control", @list = "dlLabTestList", tabindex = "-1" })</td>
                                <td>@Html.TextBox("TestDate", null, new { @class = "TestDate form-control datepicker", tabindex = "-1" })</td>
                                <td>@Html.TextBox("TestResult", null, new { @class = "TestResult form-control" })</td>
                                <td>@Html.TextBox("TestResultLabel", null, new { @class = "TestResultLabel form-control", @list = "dlResultLabel", tabindex = "-1" })</td>
                                <td><span class="glyphicon glyphicon-remove-circle" onclick="removeRow(this);"></span></td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!--Present History Div-->
        <div class="col-lg-4 col-xs-12">
            <div class="row">
                @*<div class="col-lg-12">*@
                <div class="form-group">
                    <label>Present History</label>
                    @Html.TextAreaFor(a => a.PresentHx, new { @class = "form-control" })
                </div>
                @*</div>*@
                <div class="row">
                    <div class="col-lg-12 col-xs-12">
                        <div class="form-group">
                            <label>Past History</label>
                            
                            @Html.DropDownListFor(a => a.PastHx, (List<SelectListItem>)ViewBag.PastHxVB, "--Select--", new { @class="form-control" })
                          
                        </div>
                    </div>
                    <div class="col-lg-12 col-xs-12">
                        <div class="form-group">
                           @Html.TextAreaFor(a => a.PastHxNAT, new { @class = "form-control" })
                        </div>
                    </div>

                    <div class="col-lg-12 col-xs-6">
                        <div class="form-group">
                            <label>Family History</label>
                            @Html.TextAreaFor(a => a.FamilyHx, new { @class = "form-control" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-12 col-xs-6">
                        <div class="form-group">
                            <label>Drug History</label>
                            @Html.TextAreaFor(a => a.DrugHx, new { @class = "form-control" })
                        </div>
                    </div>
                    @*</div>
                <div class="row">*@
                    <div class="col-lg-12 col-xs-6">
                        <div class="form-group">
                            <label>Socio-ecnomic History</label>
                            @Html.TextAreaFor(a => a.SecHx, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12 col-xs-6">
                        <div class="form-group">
                            <label>Comorbidites</label>
                            @Html.TextAreaFor(a => a.Comorbidites, new { @class = "form-control" })
                        </div>
                    </div>
                    @*</div>
                <div class="row">*@
                    <div class="col-lg-12 col-xs-6">
                        <div class="form-group">
                            <label>Transfusion History</label>
                            @Html.TextAreaFor(a => a.TransfusionHx, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12 col-xs-6 FemaleOnly">
                        <div class="form-group FemaleOnly">
                            <label>Gynae/OBS History</label>
                            @Html.TextBoxFor(a => a.GynaeObsHx, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-lg-12 col-xs-6">
                        <label>Next Followup</label>
                        @Html.TextBoxFor(a => a.NextFollowup, new { @class = "form-control" })
                    </div>

                </div>
                <div class="row">
                    <div class="col-lg-12 col-xs-6">
                   
                            <label>Next Followup Date</label>
                            @Html.TextBoxFor(a => a.NextFollowupDate, Model.NextFollowupDate.HasValue && Model.NextFollowupDate.Value.Date != DateTime.MinValue.Date ? Model.NextFollowupDate.Value.ToString("dd-MMM-yyyy") : "", new { @class = "form-control datepicker", id = "nextFollowupDate" })

                       
                    </div>
                    </div>
                </div>

            @*<div class="row" style="position: absolute; bottom:15px;">
                <div class="col-sm-12">
                    <label>Next Followup</label>
                    @Html.TextBoxFor(a => a.NextFollowup, new { @class = "form-control" })
                </div>

            </div>*@
        </div>

        <!--datalists-->
        <datalist id="dlLabTestList">
            @foreach (SelectListItem li in ViewBag.LabTestListVB)
            {
                <option value="@li.Text"></option>
